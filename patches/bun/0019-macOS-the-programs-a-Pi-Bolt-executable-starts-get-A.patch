From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 19:02:26 +0530
Subject: [PATCH] macOS: the programs a Pi-Bolt executable starts get ASLR,
 through pi-spawn and the launcher's helper

---
 src/jsc/bindings/c-bindings.cpp   |  32 ++++++
 src/runtime/api/bun/subprocess.rs |   2 +-
 src/spawn/process.rs              |  23 +++-
 src/spawn_sys/posix_spawn.rs      | 173 +++++++++++++++++++++++++++++-
 src/spawn_sys/spawn_process.rs    |  14 ++-
 5 files changed, 235 insertions(+), 9 deletions(-)

diff --git a/src/jsc/bindings/c-bindings.cpp b/src/jsc/bindings/c-bindings.cpp
index e573821c..bcabdc0d 100644
--- a/src/jsc/bindings/c-bindings.cpp
+++ b/src/jsc/bindings/c-bindings.cpp
@@ -1227,13 +1227,45 @@ static bool hasStaticHeap()
     return flags & hasStaticHeapFlag;
 }
 
+// macOS passes ASLR being off on to every process this one starts. Pi-Bolt's launcher (scripts/lib/darwin-launcher.c) forks a
+// helper with ASLR before it starts this executable without it, and says so in BUN_INTERNAL_SPAWN_HELPER: <pid>:<socket>:<path
+// of pi-spawn>. posix_spawn.rs then starts pi-spawn in the place of a program, which has the helper start it.
+static constexpr const char* spawnHelperVariable = "BUN_INTERNAL_SPAWN_HELPER";
+extern "C" int Bun__spawnHelperFd = -1;
+extern "C" const char* Bun__spawnProxyPath = nullptr;
+
+static void takeSpawnHelper()
+{
+    const char* value = getenv(spawnHelperVariable);
+    if (!value)
+        return;
+    char* end;
+    long pid = strtol(value, &end, 10);
+    long fd = *end == ':' ? strtol(end + 1, &end, 10) : -1;
+    struct stat info;
+    // Only for this process: a program started from here, given the same environment, is not.
+    if (*end == ':' && end[1] == '/' && pid == getpid() && fd >= 0 && !fstat(static_cast<int>(fd), &info) && S_ISSOCK(info.st_mode)) {
+        Bun__spawnProxyPath = strdup(end + 1);
+        if (Bun__spawnProxyPath) {
+            Bun__spawnHelperFd = static_cast<int>(fd);
+            fcntl(Bun__spawnHelperFd, F_SETFD, FD_CLOEXEC);
+        }
+    }
+    unsetenv(spawnHelperVariable);
+}
+
 __attribute__((constructor(101))) static void Bun__reexecWithoutASLRForStaticHeap(int, char** argv, char**)
 {
     if (getenv(reexecutedWithoutASLR)) {
         // Whether or not it worked: once. (Bun__StaticHeap__map() checks where the executable is.)
         unsetenv(reexecutedWithoutASLR);
+        takeSpawnHelper();
         return;
     }
+    // Started again just below, this process's next executable takes it.
+    struct TakeSpawnHelper {
+        ~TakeSpawnHelper() { takeSpawnHelper(); }
+    } takeSpawnHelperUnlessStartedAgain;
     if (!_dyld_get_image_vmaddr_slide(0))
         return;
     const char* aot = getenv("BUN_AOT");
