diff --git a/src/spawn_sys/posix_spawn.rs b/src/spawn_sys/posix_spawn.rs
index 6555894c..41e25d24 100644
--- a/src/spawn_sys/posix_spawn.rs
+++ b/src/spawn_sys/posix_spawn.rs
@@ -610,6 +610,167 @@ pub mod posix_spawn {
         Ok((posix_actions, posix_attr))
     }
 
+    /// pi-bin, Pi-Bolt's executable on macOS, runs without ASLR, and macOS passes that on to every process it starts. When
+    /// Pi-Bolt's launcher has made a helper with ASLR (see `Bun__spawnHelperFd` in c-bindings.cpp), the program is started by
+    /// it: this starts pi-spawn (Pi-Bolt's scripts/lib/darwin-spawn-proxy.c) in the program's place, with everything the
+    /// program would get, and two more files: the helper's socket, and a pipe on which pi-spawn says how it went. pi-spawn
+    /// then waits for the program and exits as it did, so its pid is the one to wait for; the program's pid is the one to
+    /// signal. `None`: start the program directly.
+    #[cfg(target_os = "macos")]
+    fn spawn_through_proxy(
+        path: &CStr,
+        actions: Option<&Actions>,
+        attr: Option<&Attr>,
+        argv: *const *const c_char,
+        envp: *const *const c_char,
+    ) -> Option<sys::Result<(pid_t, pid_t)>> {
+        unsafe extern "C" {
+            static Bun__spawnHelperFd: c_int;
+            static Bun__spawnProxyPath: *const c_char;
+        }
+        // SAFETY: written once, by a constructor that runs before main.
+        let (helper, proxy) = unsafe { (Bun__spawnHelperFd, Bun__spawnProxyPath) };
+        if helper < 0 || proxy.is_null() {
+            return None;
+        }
+        // `bun run`'s exec (POSIX_SPAWN_SETEXEC) replaces this process: nothing to stand in for.
+        if attr.is_some_and(|a| a.flags & 0x0040 != 0) {
+            return None;
+        }
+        // The descriptors the program gets must not be where pi-spawn's two are.
+        let highest = actions.map_or(2, |a| {
+            a.actions
+                .iter()
+                .map(|action| match action.kind {
+                    bun_spawn::FileActionType::Dup2 => action.fds[1],
+                    bun_spawn::FileActionType::Open => action.fds[0],
+                    _ => 2,
+                })
+                .max()
+                .unwrap_or(2)
+        });
+        if highest >= helper {
+            return None;
+        }
+        let mut pipe: [c_int; 2] = [-1; 2];
+        // SAFETY: valid out-array of two ints.
+        if unsafe { system::pipe(pipe.as_mut_ptr()) } != 0 {
+            return None;
+        }
+        let (status_read, status_write) = (pipe[0], pipe[1]);
+        // SAFETY: plain fcntl/close on descriptors this function owns.
+        let status_write = unsafe {
+            system::fcntl(status_read, system::F_SETFD, system::FD_CLOEXEC);
+            let moved = system::fcntl(status_write, system::F_DUPFD_CLOEXEC, highest.max(63) + 1);
+            system::close(status_write);
+            moved
+        };
+        let close_status = |also_write: bool| {
+            // SAFETY: descriptors owned by this function.
+            unsafe {
+                system::close(status_read);
+                if also_write {
+                    system::close(status_write);
+                }
+            }
+        };
+        if status_write < 0 {
+            close_status(false);
+            return None;
+        }
+        let Ok((mut posix_actions, posix_attr)) = convert_spawn_objects(actions, attr) else {
+            close_status(true);
+            return None;
+        };
+        if posix_actions.inherit(Fd::from_native(helper)).is_err()
+            || posix_actions.inherit(Fd::from_native(status_write)).is_err()
+        {
+            close_status(true);
+            return None;
+        }
+
+        let helper_arg = CString::new(helper.to_string()).expect("no NUL");
+        let status_arg = CString::new(status_write.to_string()).expect("no NUL");
+        let mut proxy_argv: Vec<*const c_char> =
+            vec![proxy, helper_arg.as_ptr(), status_arg.as_ptr(), path.as_ptr()];
+        let mut at = argv;
+        // SAFETY: argv is a NULL-terminated array of C strings (caller contract).
+        unsafe {
+            while !(*at).is_null() {
+                proxy_argv.push(*at);
+                at = at.add(1);
+            }
+        }
+        proxy_argv.push(ptr::null());
+
+        let mut pid: pid_t = 0;
+        // SAFETY: all pointers valid; argv/envp NULL-terminated (see spawn_z).
+        let rc = unsafe {
+            system::posix_spawn(
+                &raw mut pid,
+                proxy,
+                &raw const posix_actions.actions,
+                &raw const posix_attr.attr,
+                proxy_argv.as_ptr().cast::<*mut c_char>(),
+                envp.cast::<*mut c_char>(),
+            )
+        };
+        // SAFETY: owned descriptor; pi-spawn has its own copy.
+        unsafe { system::close(status_write) };
+        if rc != 0 {
+            close_status(false);
+            return None;
+        }
+
+        // What pi-spawn says: the program's pid, or why posix_spawn failed; nothing when it started the program in its own
+        // place (the helper could not).
+        let mut message = [0u8; 8];
+        let mut got = 0usize;
+        while got < message.len() {
+            // SAFETY: reading into the rest of a local buffer.
+            let n = unsafe {
+                system::read(
+                    status_read,
+                    message[got..].as_mut_ptr().cast(),
+                    message.len() - got,
+                )
+            };
+            if n < 0 && errno(-1) == Errno::INTR {
+                continue;
+            }
+            if n <= 0 {
+                break;
+            }
+            got += n as usize;
+        }
+        close_status(false);
+        if got != message.len() {
+            return Some(sys::Result::Ok((pid, pid)));
+        }
+        let kind = i32::from_ne_bytes(message[0..4].try_into().unwrap());
+        let value = i32::from_ne_bytes(message[4..8].try_into().unwrap());
+        const STARTED: i32 = 1;
+        const FAILED: i32 = 2;
+        match kind {
+            STARTED if value > 0 => Some(sys::Result::Ok((pid, value))),
+            FAILED => {
+                // pi-spawn exits at once; nothing else waits for it.
+                let mut status: c_int = 0;
+                // SAFETY: valid out-pointer.
+                while unsafe { system::waitpid(pid, &raw mut status, 0) } < 0
+                    && errno(-1) == Errno::INTR
+                {}
+                Some(sys::Result::Err(sys::Error {
+                    errno: value as sys::ErrorInt,
+                    syscall: SYSCALL_POSIX_SPAWN,
+                    path: path.to_bytes().into(),
+                    ..Default::default()
+                }))
+            }
+            _ => Some(sys::Result::Ok((pid, pid))),
+        }
+    }
+
     #[cfg(unix)]
     pub(crate) fn spawn_z(
         path: &CStr,
@@ -617,7 +778,7 @@ pub mod posix_spawn {
         attr: Option<&Attr>,
         argv: *const *const c_char,
         envp: *const *const c_char,
-    ) -> sys::Result<pid_t> {
+    ) -> sys::Result<(pid_t, pid_t)> {
         let pty_slave_fd = attr.map_or(-1, |a| a.pty_slave_fd);
         let detached = attr.is_some_and(|a| a.detached);
         let uid = attr.and_then(|a| a.uid);
@@ -665,12 +826,16 @@ pub mod posix_spawn {
                 },
                 argv,
                 envp,
-            );
+            )
+            .map(|pid| (pid, pid));
         }
 
         // macOS without PTY: use system posix_spawn
         #[cfg(target_os = "macos")]
         {
+            if let Some(proxied) = spawn_through_proxy(path, actions, attr, argv, envp) {
+                return proxied;
+            }
             let (posix_actions, posix_attr) = match convert_spawn_objects(actions, attr) {
                 Ok(converted) => converted,
                 Err(e) => return sys::Result::Err(e.with_path(path.to_bytes())),
@@ -702,7 +867,7 @@ pub mod posix_spawn {
             }
 
             if rc == 0 {
-                return sys::Result::Ok(pid);
+                return sys::Result::Ok((pid, pid));
             }
 
             return sys::Result::Err(sys::Error {
@@ -750,7 +915,7 @@ pub mod posix_spawn {
             // Unlike most syscalls, posix_spawn returns 0 on success and an errno on failure.
             // That is why bun.sys.getErrno() is not used here, since that checks for -1.
             if rc == 0 {
-                return sys::Result::Ok(pid);
+                return sys::Result::Ok((pid, pid));
             }
 
             sys::Result::Err(sys::Error {
