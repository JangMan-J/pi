+            /// The pre-resolved module graph and its slot table, and the graph module of each successful `add_*` call
+            /// (`u32::MAX` for none); the internal modules, added last, are of none.
+            pub(crate) fn set_prelinked_module_graph(&mut self, blob: &[u8], slots: &[u32], graph_modules_of_chunks: &[u32]) {
