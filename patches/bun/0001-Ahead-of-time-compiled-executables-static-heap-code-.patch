     }
 }
 
+/// `JSC::BytecodeLinkEncoder::setPrelinkedModuleGraph`: what AOT compilation links the modules by (the encoder copies it).
+#[unsafe(no_mangle)]
+pub(crate) fn __bun_jsc_bytecode_link_encoder_set_prelinked_module_graph(
+    encoder: NonNull<BytecodeLinkEncoder>,
+    blob: &[u8],
+    slots: &[u32],
+    graph_module_of_each_add: &[u32],
+) {
+    // SAFETY: the slices are valid for the call; C++ copies them.
+    unsafe {
+        Bun__BytecodeLinkEncoder__setPrelinkedModuleGraph(
+            encoder.as_ptr(),
+            blob.as_ptr(),
+            blob.len(),
+            slots.as_ptr(),
+            slots.len(),
+            graph_module_of_each_add.as_ptr(),
+            graph_module_of_each_add.len(),
+        )
+    }
+}
