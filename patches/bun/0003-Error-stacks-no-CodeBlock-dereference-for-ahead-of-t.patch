From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <323596076+opensec-intelligence@users.noreply.github.com>
Date: Sat, 3 Oct 2026 03:07:50 +0000
Subject: [PATCH] Error stacks: no CodeBlock dereference for ahead-of-time
 frames at the end of a collection

A frame of ahead-of-time compiled code has no CodeBlock until one is made, and
StackFrame::makeCodeBlock() returns null while the heap is not running the
mutator. JSC formats an Error's stack at the end of a collection
(ErrorInstance::reconcileWeakReferencesAtGCEnd -> VM::onComputeErrorInfo), where
Zig::functionName(vm, StackFrame) dereferenced that null: segfault at 0x38.

functionName(), the JSCStackFrame constructor and sourceURL(vm, StackFrame) now
ask the frame (isConstructor, codeType, isBuiltinFunction, ownerExecutable,
codeBlockIfExists) instead. Reproduced with BUN_JSC_collectContinuously=1: 5 of
15 runs crashed before, none after.
---
 src/jsc/bindings/ErrorStackTrace.cpp | 28 ++++++++++++++++++++--------
 1 file changed, 20 insertions(+), 8 deletions(-)

diff --git a/src/jsc/bindings/ErrorStackTrace.cpp b/src/jsc/bindings/ErrorStackTrace.cpp
index 0b0e9e59..bab61b51 100644
--- a/src/jsc/bindings/ErrorStackTrace.cpp
+++ b/src/jsc/bindings/ErrorStackTrace.cpp
@@ -228,7 +228,8 @@ JSCStackFrame::JSCStackFrame(JSC::VM& vm, const JSC::StackFrame& frame)
         auto lineColumn = frame.computeLineAndColumn();
         m_sourcePositions = { OrdinalNumber::fromOneBasedInt(lineColumn.line), OrdinalNumber::fromOneBasedInt(lineColumn.column) };
         m_sourcePositionsState = SourcePositionsState::Calculated;
-        auto codeType = frame.codeBlock()->codeType();
+        // frame.codeBlock() can be null here (ahead-of-time compiled code, at the end of a collection): ask the frame.
+        auto codeType = frame.codeType();
         if (codeType == JSC::FunctionCode || codeType == JSC::EvalCode) {
             m_isFunctionOrEval = true;
         }
@@ -411,7 +412,14 @@ String sourceURL(JSC::VM& vm, const JSC::StackFrame& frame)
         return "[native code]"_s;
     }
 
-    return sourceURL(frame.codeBlock());
+    // Read the source from the executable rather than frame.codeBlock(): code compiled ahead of time has no CodeBlock until
+    // one is made, and none can be made at the end of a collection, where stacks are also formatted. A CodeBlock's source
+    // is its owner executable's, so this reads the same either way.
+    if (auto* codeBlock = frame.codeBlockIfExists())
+        return sourceURL(codeBlock);
+    if (auto* executable = frame.ownerExecutable())
+        return sourceURL(executable->source());
+    return String();
 }
 
 String sourceURL(JSC::StackVisitor& visitor)
@@ -513,12 +521,14 @@ String functionName(JSC::VM& vm, const JSC::StackFrame& frame, unsigned int* fla
     JSC::JSObject* callee = frame.callee() ? frame.callee()->getObject() : nullptr;
 
     if (frame.hasLineAndColumnInfo()) {
-        auto* codeblock = frame.codeBlock();
-        if (codeblock->isConstructor()) {
+        // Ask the frame, not frame.codeBlock(): a frame of code compiled ahead of time has no CodeBlock until one is made, and
+        // StackFrame::makeCodeBlock() returns null at the end of a collection, where this also runs
+        // (ErrorInstance::reconcileWeakReferencesAtGCEnd -> VM::onComputeErrorInfo). Dereferencing that null crashed.
+        if (frame.isConstructor()) {
             isConstructor = true;
         }
 
-        auto codeType = codeblock->codeType();
+        auto codeType = frame.codeType();
         switch (codeType) {
         case JSC::CodeType::FunctionCode:
         case JSC::CodeType::EvalCode: {
@@ -532,7 +542,7 @@ String functionName(JSC::VM& vm, const JSC::StackFrame& frame, unsigned int* fla
             if (callee) {
                 functionName = Zig::functionName(vm, callee);
 
-                if (flags && codeblock->unlinkedCodeBlock()->isBuiltinFunction()) {
+                if (flags && frame.isBuiltinFunction()) {
                     *flags |= static_cast<unsigned int>(FunctionNameFlags::Builtin);
                 }
             }
@@ -543,8 +553,10 @@ String functionName(JSC::VM& vm, const JSC::StackFrame& frame, unsigned int* fla
         }
         }
 
-        if (functionName.isEmpty()) {
-            functionName = Zig::functionName(vm, codeblock);
+        if (functionName.isEmpty() && codeType == JSC::FunctionCode) {
+            // What Zig::functionName(vm, CodeBlock*) returns, from the executable the frame already has.
+            if (auto* executable = dynamicDowncast<JSC::FunctionExecutable>(frame.ownerExecutable()))
+                functionName = executable->ecmaNameWithoutGC();
         }
     } else if (callee) {
         functionName = Zig::functionName(vm, callee);
-- 
