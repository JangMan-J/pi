From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 10:21:46 +0530
Subject: [PATCH] Static strings: no reference counting from Rust either, as in
 WTF (it made pages of the static heap the process's)

---
 src/bun_alloc/lib.rs | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/src/bun_alloc/lib.rs b/src/bun_alloc/lib.rs
index 7888ef35..3d4f4e61 100644
--- a/src/bun_alloc/lib.rs
+++ b/src/bun_alloc/lib.rs
@@ -759,6 +759,11 @@ impl WTFStringImplStruct {
     /// `m_refCount.fetch_add(s_refCountIncrement, std::memory_order_relaxed)`.
     #[inline]
     pub fn r#ref(&self) {
+        // As WTF's (patched): counting the references to what is never destroyed would only make a page that is a file's
+        // the process's (a static heap's strings are static).
+        if self.ref_count_atomic().load(Ordering::Relaxed) & Self::S_REF_COUNT_FLAG_IS_STATIC_STRING != 0 {
+            return;
+        }
         let old = self
             .ref_count_atomic()
             .fetch_add(Self::S_REF_COUNT_INCREMENT, Ordering::Relaxed);
@@ -774,12 +779,13 @@ impl WTFStringImplStruct {
     ///
     /// Hot path is a single `lock xadd`; only the last-ref branch crosses FFI
     /// to `StringImpl::destroy`. `Relaxed` matches WebKit's
-    /// `m_refCount.fetch_sub(s_refCountIncrement, std::memory_order_relaxed)`;
-    /// WTF relies on the static-string flag bit (0x1) to keep static strings'
-    /// counters from ever equalling `s_refCountIncrement`, so no separate
-    /// `isStatic()` check is needed.
+    /// `m_refCount.fetch_sub(s_refCountIncrement, std::memory_order_relaxed)`.
+    /// A static string's count is not written at all, as in WTF's (patched).
     #[inline]
     pub fn deref(&self) {
+        if self.ref_count_atomic().load(Ordering::Relaxed) & Self::S_REF_COUNT_FLAG_IS_STATIC_STRING != 0 {
+            return;
+        }
         let old = self
             .ref_count_atomic()
             .fetch_sub(Self::S_REF_COUNT_INCREMENT, Ordering::Relaxed);
