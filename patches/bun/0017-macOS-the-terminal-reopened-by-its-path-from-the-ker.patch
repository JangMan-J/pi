From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 15:36:01 +0530
Subject: [PATCH] macOS: the terminal reopened by its path from the kernel, and
 the static heap found without counting its pages

---
 src/jsc/bindings/c-bindings.cpp               | 12 ++++++++++++
 src/standalone_graph/StandaloneModuleGraph.rs |  5 +++--
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/jsc/bindings/c-bindings.cpp b/src/jsc/bindings/c-bindings.cpp
index ca238272..e573821c 100644
--- a/src/jsc/bindings/c-bindings.cpp
+++ b/src/jsc/bindings/c-bindings.cpp
@@ -857,9 +857,21 @@ extern "C" int32_t open_as_nonblocking_tty(int32_t fd, int32_t mode)
     }
 
     char pathbuf[PATH_MAX + 1];
+#if OS(DARWIN)
+    // The path of the terminal, from the kernel: ttyname_r() lists /dev and stats each entry until it finds it (some 370 of
+    // them, most of a millisecond at every start that reads its terminal). Only of a terminal, as ttyname_r() answers
+    // (/dev/null, say, has a path in /dev too).
+    if (!isatty(fd))
+        return -1;
+    if (fcntl(fd, F_GETPATH, pathbuf) != 0 || strncmp(pathbuf, "/dev/", 5) != 0) {
+        if (ttyname_r(fd, pathbuf, sizeof(pathbuf)) != 0)
+            return -1;
+    }
+#else
     if (ttyname_r(fd, pathbuf, sizeof(pathbuf)) != 0) {
         return -1;
     }
+#endif
 
     return open(pathbuf, mode | O_NONBLOCK | O_NOCTTY | O_CLOEXEC);
 }
diff --git a/src/standalone_graph/StandaloneModuleGraph.rs b/src/standalone_graph/StandaloneModuleGraph.rs
index b46ea037..8fcf89ac 100644
--- a/src/standalone_graph/StandaloneModuleGraph.rs
+++ b/src/standalone_graph/StandaloneModuleGraph.rs
@@ -568,7 +568,8 @@ mod macho {
         prp_vip: libc::vnode_info_path,
     }
     const _: () = assert!(size_of::<proc_regionwithpathinfo>() == 1272);
-    const PROC_PIDREGIONPATHINFO: core::ffi::c_int = 8;
+    // (Not PROC_PIDREGIONPATHINFO, 8, which counts the resident pages of the region: all 130 MB of `__BUN`, at every start.)
+    const PROC_PIDREGIONPATHINFO2: core::ffi::c_int = 22;
 
     /// The file the byte at `address` (in the main program's mapped image) comes from, opened, and where in it that byte
     /// is: what the kernel says is mapped there, so that a file that has since been replaced at the executable's path is
@@ -578,7 +579,7 @@ mod macho {
         let mut info: proc_regionwithpathinfo = unsafe { core::mem::zeroed() };
         let size = size_of::<proc_regionwithpathinfo>() as core::ffi::c_int;
         // SAFETY: `info` is `size` writable bytes.
-        let got = unsafe { libc::proc_pidinfo(libc::getpid(), PROC_PIDREGIONPATHINFO, address as u64, (&raw mut info).cast(), size) };
+        let got = unsafe { libc::proc_pidinfo(libc::getpid(), PROC_PIDREGIONPATHINFO2, address as u64, (&raw mut info).cast(), size) };
         let region = &info.prp_prinfo;
         // (The region found is the one at or after `address`.)
         if got != size || (address as u64) < region.pri_address || (address as u64) >= region.pri_address + region.pri_size {
-- 
