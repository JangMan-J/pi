From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 01:19:28 +0530
Subject: [PATCH] macOS: a static heap is built and used with the executable
 where it was linked to be

A static heap holds pointers into the executable: native functions, what describes the engine's classes, the text of static
strings. On Linux the executable is not position independent, so they hold in every process. macOS loads an ARM64 executable
somewhere else each time (it must be position independent), and a compiled program crashed or failed to resolve names as soon as
it loaded a builtin module (node:fs).

An executable with a static heap, and a build with BUN_STATIC_HEAP=1, now start again at once, from a constructor that runs
before anything else, with ASLR turned off for the main executable (posix_spawn with POSIX_SPAWN_SETEXEC: the same process).
The system's libraries still move. If the executable is not where it was linked to be after all, the heap is not used (one
notice, then bytecode), and a build makes none. The build warns of a pointer to the start of a symbol of the system's
libraries, which move at every boot, and with BUN_STATIC_HEAP_VERBOSE says how many words point into the executable.
---
 src/jsc/bindings/ZigSourceProvider.cpp | 70 ++++++++++++++++++++++++++
 src/jsc/bindings/c-bindings.cpp        | 58 +++++++++++++++++++++
 2 files changed, 128 insertions(+)

diff --git a/src/jsc/bindings/ZigSourceProvider.cpp b/src/jsc/bindings/ZigSourceProvider.cpp
index 467ae597..ee134562 100644
--- a/src/jsc/bindings/ZigSourceProvider.cpp
+++ b/src/jsc/bindings/ZigSourceProvider.cpp
@@ -4,6 +4,11 @@
 
 #if !OS(WINDOWS)
 #include <sys/mman.h>
+#if OS(DARWIN)
+#include <dlfcn.h>
+#include <mach-o/dyld.h>
+#include <mach-o/loader.h>
+#endif
 #endif
 #include "ZigSourceProvider.h"
 #include "MimallocWTFMalloc.h"
@@ -428,10 +433,68 @@ extern "C" void Bun__setOptionsForAheadOfTimeCode()
     JSC::Options::useMiniVMModeWithoutJIT() = false;
 }
 
+#if OS(DARWIN)
+// What of the heap points into this executable (moved, unless at the address it was linked for: c-bindings.cpp), and whether
+// anything points at a function or object of the system's libraries, which move at every boot: a heap must not. (A word in
+// their range that is not at the start of a symbol is taken for a number: the range is gigabytes wide.)
+static void checkPointersOutOfStaticHeap(std::span<const uint8_t> heap)
+{
+    const auto* header = reinterpret_cast<const mach_header_64*>(_dyld_get_image_header(0));
+    uintptr_t slide = _dyld_get_image_vmaddr_slide(0);
+    uintptr_t executableStart = 0, executableEnd = 0;
+    const auto* command = reinterpret_cast<const load_command*>(header + 1);
+    for (uint32_t i = 0; i < header->ncmds; ++i) {
+        if (command->cmd == LC_SEGMENT_64) {
+            const auto* segment = reinterpret_cast<const segment_command_64*>(command);
+            if (strcmp(segment->segname, "__PAGEZERO") && strcmp(segment->segname, "__LINKEDIT")) {
+                uintptr_t start = segment->vmaddr + slide;
+                if (!executableStart || start < executableStart)
+                    executableStart = start;
+                executableEnd = std::max<uintptr_t>(executableEnd, start + segment->vmsize);
+            }
+        }
+        command = reinterpret_cast<const load_command*>(reinterpret_cast<const uint8_t*>(command) + command->cmdsize);
+    }
+    size_t sharedCacheSize = 0;
+    uintptr_t sharedCache = 0;
+    // (Not in the SDK's headers.)
+    if (auto* range = reinterpret_cast<const void* (*)(size_t*)>(dlsym(RTLD_DEFAULT, "_dyld_get_shared_cache_range")))
+        sharedCache = reinterpret_cast<uintptr_t>(range(&sharedCacheSize));
+    size_t intoExecutable = 0, intoSystem = 0;
+    for (size_t at = 0; at + sizeof(uint64_t) <= heap.size(); at += sizeof(uint64_t)) {
+        uint64_t word;
+        memcpy(&word, heap.data() + at, sizeof(word));
+        if (word >= executableStart && word < executableEnd) {
+            ++intoExecutable;
+            continue;
+        }
+        if (word < sharedCache || word >= sharedCache + sharedCacheSize || word % 4)
+            continue;
+        Dl_info info;
+        if (!dladdr(reinterpret_cast<const void*>(word), &info) || reinterpret_cast<uintptr_t>(info.dli_saddr) != word)
+            continue;
+        if (intoSystem++ < 20)
+            fprintf(stderr, "warning: the static heap points at %s in %s (at %zu); it moves at every boot\n", info.dli_sname ? info.dli_sname : "?", info.dli_fname ? info.dli_fname : "?", at);
+    }
+    if (getenv("BUN_STATIC_HEAP_VERBOSE") || intoSystem)
+        fprintf(stderr, "[static heap] %zu words point into the executable, %zu at the system's libraries\n", intoExecutable, intoSystem);
+}
+#endif
+
 extern "C" bool Bun__StaticHeap__takeBuilt(uint8_t** data, size_t* size)
 {
     if (s_builtStaticHeap.isEmpty())
         return false;
+#if OS(DARWIN)
+    if (_dyld_get_image_vmaddr_slide(0)) {
+        // (c-bindings.cpp starts a build with BUN_STATIC_HEAP=1 again without ASLR; that did not work.)
+        fprintf(stderr, "error: the static heap can only be built with the executable at the address it was linked for (ASLR off); building without it\n");
+        s_builtStaticHeap = { };
+        s_builtAOTImage = { };
+        return false;
+    }
+    checkPointersOutOfStaticHeap(s_builtStaticHeap.span());
+#endif
     size_t offsetOfImage = WTF::roundUpToMultipleOf<pageSizeOfStaticHeap>(s_builtStaticHeap.size());
     *size = s_builtAOTImage.isEmpty() ? s_builtStaticHeap.size() : offsetOfImage + s_builtAOTImage.size() + sizeof(AOTImageTrailer);
     *data = static_cast<uint8_t*>(mi_zalloc(*size));
@@ -578,6 +641,13 @@ extern "C" bool Bun__StaticHeap__map(const uint8_t* image, size_t size, int fd,
 {
     Bun__setBytecodeCacheVersion();
     bool asked = !(getenv("BUN_AOT") && getenv("BUN_AOT")[0] == '0');
+#if OS(DARWIN)
+    // The heap points into this executable where it was linked to be (c-bindings.cpp starts it again there).
+    if (asked && _dyld_get_image_vmaddr_slide(0)) {
+        noteNotUsed("the executable could not be loaded where its prebuilt heap expects it");
+        return false;
+    }
+#endif
     if (asked && (bmalloc::StaticRegion::bssMapped() < bmalloc::StaticRegion::arenaReservation || (hasAOTImageTrailer(image, size) && !structureHeapCanBeWhereTheCodeExpects()))) {
         noteNotUsed("the address space for it is not available");
         return false;
diff --git a/src/jsc/bindings/c-bindings.cpp b/src/jsc/bindings/c-bindings.cpp
index a3fd0268..ca238272 100644
--- a/src/jsc/bindings/c-bindings.cpp
+++ b/src/jsc/bindings/c-bindings.cpp
@@ -1182,6 +1182,10 @@ struct BlobHeader {
 
 #if OS(DARWIN)
 
+#include <limits.h>
+#include <mach-o/dyld.h>
+#include <spawn.h>
+
 extern "C" BlobHeader __attribute__((section("__BUN,__bun"))) BUN_COMPILED = { 0, 0 };
 
 extern "C" uint64_t* Bun__getStandaloneModuleGraphMachoLength()
@@ -1189,6 +1193,60 @@ extern "C" uint64_t* Bun__getStandaloneModuleGraphMachoLength()
     return &BUN_COMPILED.size;
 }
 
+// A static heap (StandaloneModuleGraph's Flags::HAS_STATIC_HEAP) holds pointers into this executable: to native functions, to
+// what describes the engine's classes, to the text of static strings. On Linux the executable is not position independent, so
+// they are good in every process; macOS loads it somewhere else each time (ASLR, and an ARM64 executable must be position
+// independent). So an executable with a static heap, and the build that makes one (BUN_STATIC_HEAP=1), run with the main
+// executable where it was linked to be: they start again at once, before anything else, with ASLR turned off for it. The
+// system's libraries move as before; the static heap must not point into them (JSC::StaticHeap checks while building). With
+// BUN_AOT=0 the static heap is not used, and the executable runs as it was started.
+static constexpr const char* reexecutedWithoutASLR = "BUN_INTERNAL_STATIC_HEAP_NO_ASLR";
+
+static bool hasStaticHeap()
+{
+    constexpr size_t sizeOfOffsets = 32; // StandaloneModuleGraph's Offsets, then a trailer of 16 bytes.
+    constexpr size_t sizeOfTrailer = 16;
+    constexpr uint32_t hasStaticHeapFlag = 1u << 14;
+    uint64_t size = BUN_COMPILED.size;
+    if (size < sizeOfOffsets + sizeOfTrailer || memcmp(BUN_COMPILED.data + size - sizeOfTrailer, "\n---- Bun! ----\n", sizeOfTrailer))
+        return false;
+    uint32_t flags;
+    memcpy(&flags, BUN_COMPILED.data + size - sizeOfTrailer - sizeOfOffsets + 28, sizeof(flags));
+    return flags & hasStaticHeapFlag;
+}
+
+__attribute__((constructor(101))) static void Bun__reexecWithoutASLRForStaticHeap(int, char** argv, char**)
+{
+    if (getenv(reexecutedWithoutASLR)) {
+        // Whether or not it worked: once. (Bun__StaticHeap__map() checks where the executable is.)
+        unsetenv(reexecutedWithoutASLR);
+        return;
+    }
+    if (!_dyld_get_image_vmaddr_slide(0))
+        return;
+    const char* aot = getenv("BUN_AOT");
+    if (aot && aot[0] == '0')
+        return;
+    const char* building = getenv("BUN_STATIC_HEAP");
+    if (!(building && building[0] == '1') && !hasStaticHeap())
+        return;
+    char path[PATH_MAX];
+    uint32_t length = sizeof(path);
+    if (_NSGetExecutablePath(path, &length))
+        return;
+    posix_spawnattr_t attributes;
+    if (posix_spawnattr_init(&attributes))
+        return;
+    constexpr short disableASLR = 0x100; // _POSIX_SPAWN_DISABLE_ASLR
+    posix_spawnattr_setflags(&attributes, disableASLR | POSIX_SPAWN_SETEXEC);
+    setenv(reexecutedWithoutASLR, "1", 1);
+    extern char** environ;
+    posix_spawn(nullptr, path, nullptr, &attributes, argv, environ);
+    // Not started again: go on as it is (the static heap is then not used).
+    unsetenv(reexecutedWithoutASLR);
+    posix_spawnattr_destroy(&attributes);
+}
+
 #else // __linux__ / __FreeBSD__ — both ELF, same .bun section approach
 
 extern "C" BlobHeader __attribute__((section(".bun"), aligned(BLOB_HEADER_ALIGNMENT), used)) BUN_COMPILED = { 0 };
-- 
