From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Mon, 5 Oct 2026 12:33:08 +0530
Subject: [PATCH] macOS: a terminal opened as /dev/tty is reopened by its own
 device, which kqueue can watch

---
 src/jsc/bindings/c-bindings.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/jsc/bindings/c-bindings.cpp b/src/jsc/bindings/c-bindings.cpp
index bcabdc0d..27a3940a 100644
--- a/src/jsc/bindings/c-bindings.cpp
+++ b/src/jsc/bindings/c-bindings.cpp
@@ -21,6 +21,7 @@
 #include <sys/socket.h>
 #if OS(DARWIN)
 #include <mach-o/loader.h>
+#include <libproc.h>
 #endif
 #else
 #include <uv.h>
@@ -867,6 +868,16 @@ extern "C" int32_t open_as_nonblocking_tty(int32_t fd, int32_t mode)
         if (ttyname_r(fd, pathbuf, sizeof(pathbuf)) != 0)
             return -1;
     }
+    // A terminal opened as /dev/tty (`pi-bolt </dev/tty`, as a script piped to sh starts a program) has that path, and
+    // ttyname_r() says the same; kqueue cannot watch a file opened from it (EINVAL). The device behind it is the
+    // controlling terminal's.
+    if (!strcmp(pathbuf, "/dev/tty")) {
+        struct proc_bsdinfo info;
+        if (proc_pidinfo(getpid(), PROC_PIDTBSDINFO, 0, &info, sizeof(info)) == static_cast<int>(sizeof(info)) && info.e_tdev != NODEV) {
+            if (const char* name = devname(info.e_tdev, S_IFCHR))
+                snprintf(pathbuf, sizeof(pathbuf), "/dev/%s", name);
+        }
+    }
 #else
     if (ttyname_r(fd, pathbuf, sizeof(pathbuf)) != 0) {
         return -1;
