From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 00:49:21 +0530
Subject: [PATCH] Ahead-of-time executables on macOS: the static heap and code
 image mapped from the __BUN section

map_static_heap() only knew Linux (dl_iterate_phdr and /proc/self/exe), so on macOS a compiled executable ran from
bytecode. It now asks the kernel what file and offset back the static heap's bytes (proc_pidinfo
PROC_PIDREGIONPATHINFO), opens that file and checks it is the one mapped (device and inode), as /proc/self/exe
would. The section's pages are covered by the executable's code signature, so the code is mapped executable from
the file as on Linux: no writable code, no MAP_JIT.

The image's CPU features (AOTImageTrailer::cpuFeatures) now cover ARM64 too: LSE, JSCVT, FP16, FRINTTS, SHA3 and
DotProd, which the ARM64 macro assembler picks instructions by. A CPU without one of them runs from bytecode.
---
 src/jsc/bindings/ZigSourceProvider.cpp        | 13 +++-
 src/standalone_graph/StandaloneModuleGraph.rs | 78 +++++++++++++++++++
 2 files changed, 89 insertions(+), 2 deletions(-)

diff --git a/src/jsc/bindings/ZigSourceProvider.cpp b/src/jsc/bindings/ZigSourceProvider.cpp
index ad81e6b1..467ae597 100644
--- a/src/jsc/bindings/ZigSourceProvider.cpp
+++ b/src/jsc/bindings/ZigSourceProvider.cpp
@@ -360,8 +360,8 @@ struct AOTImageTrailer {
 };
 static uint64_t s_optionsOfMappedCode;
 
-// The instruction set extensions that the compiler picks instructions by (MacroAssemblerX86_64::supports*()), as of now: when the
-// image is compiled, what it was compiled for; when the program runs, what this CPU has.
+// The instruction set extensions that the compiler picks instructions by (MacroAssemblerX86_64::supports*(), and
+// MacroAssemblerARM64's), as of now: when the image is compiled, what it was compiled for; when the program runs, what this CPU has.
 static uint64_t cpuFeaturesOfCode()
 {
     uint64_t features = 0;
@@ -377,6 +377,15 @@ static uint64_t cpuFeaturesOfCode()
             features |= 1ull << bit;
         ++bit;
     }
+#elif CPU(ARM64)
+    // (supports*(), as these states are private; each is true without asking where the runtime is built to need it anyway.)
+    using M = JSC::MacroAssemblerARM64;
+    unsigned bit = 0;
+    for (bool has : { M::supportsLSE(), M::supportsDoubleToInt32ConversionUsingJavaScriptSemantics(), M::supportsFloat16(), M::supportsRoundFloatToIntegerFloat(), M::supportsSHA3(), M::supportsDotProd() }) {
+        if (has)
+            features |= 1ull << bit;
+        ++bit;
+    }
 #endif
     return features;
 }
diff --git a/src/standalone_graph/StandaloneModuleGraph.rs b/src/standalone_graph/StandaloneModuleGraph.rs
index 3dcdff9d..c6513e13 100644
--- a/src/standalone_graph/StandaloneModuleGraph.rs
+++ b/src/standalone_graph/StandaloneModuleGraph.rs
@@ -537,6 +537,71 @@ mod macho {
         fn _dyld_get_image_name(image_index: u32) -> *const core::ffi::c_char;
     }
 
+    /// `<sys/proc_info.h>` `struct proc_regioninfo` (libc has `vnode_info_path`, not this).
+    #[repr(C)]
+    struct proc_regioninfo {
+        pri_protection: u32,
+        pri_max_protection: u32,
+        pri_inheritance: u32,
+        pri_flags: u32,
+        pri_offset: u64,
+        pri_behavior: u32,
+        pri_user_wired_count: u32,
+        pri_user_tag: u32,
+        pri_pages_resident: u32,
+        pri_pages_shared_now_private: u32,
+        pri_pages_swapped_out: u32,
+        pri_pages_dirtied: u32,
+        pri_ref_count: u32,
+        pri_shadow_depth: u32,
+        pri_share_mode: u32,
+        pri_private_pages_resident: u32,
+        pri_shared_pages_resident: u32,
+        pri_obj_id: u32,
+        pri_depth: u32,
+        pri_address: u64,
+        pri_size: u64,
+    }
+    #[repr(C)]
+    struct proc_regionwithpathinfo {
+        prp_prinfo: proc_regioninfo,
+        prp_vip: libc::vnode_info_path,
+    }
+    const _: () = assert!(size_of::<proc_regionwithpathinfo>() == 1272);
+    const PROC_PIDREGIONPATHINFO: core::ffi::c_int = 8;
+
+    /// The file the byte at `address` (in the main program's mapped image) comes from, opened, and where in it that byte
+    /// is: what the kernel says is mapped there, so that a file that has since been replaced at the executable's path is
+    /// not taken for it (the equivalent of `/proc/self/exe`).
+    pub(super) fn open_file_of(address: usize) -> Option<(bun_sys::File, u64)> {
+        // SAFETY: plain old data; zero is a valid value for every field.
+        let mut info: proc_regionwithpathinfo = unsafe { core::mem::zeroed() };
+        let size = size_of::<proc_regionwithpathinfo>() as core::ffi::c_int;
+        // SAFETY: `info` is `size` writable bytes.
+        let got = unsafe { libc::proc_pidinfo(libc::getpid(), PROC_PIDREGIONPATHINFO, address as u64, (&raw mut info).cast(), size) };
+        let region = &info.prp_prinfo;
+        // (The region found is the one at or after `address`.)
+        if got != size || (address as u64) < region.pri_address || (address as u64) >= region.pri_address + region.pri_size {
+            return None;
+        }
+        let offset = region.pri_offset + (address as u64 - region.pri_address);
+        info.prp_vip.vip_path[31][31] = 0;
+        // SAFETY: NUL-terminated (above) path the kernel wrote.
+        let path = unsafe { bun_core::ZStr::from_c_ptr(info.prp_vip.vip_path.as_ptr().cast()) };
+        let file = bun_sys::File::open(path, bun_sys::O::RDONLY | bun_sys::O::CLOEXEC, 0).ok()?;
+        // SAFETY: plain old data, written by fstat.
+        let mut stat: libc::stat = unsafe { core::mem::zeroed() };
+        // SAFETY: valid fd and out-pointer.
+        if unsafe { libc::fstat(file.fd().native(), &raw mut stat) } != 0 {
+            return None;
+        }
+        let mapped = &info.prp_vip.vip_vi.vi_stat;
+        if stat.st_ino != mapped.vst_ino || stat.st_dev as u32 != mapped.vst_dev {
+            return None;
+        }
+        Some((file, offset))
+    }
+
     /// `F_RDADVISE` on the executable for the file bytes backing `[lo, hi)`: an
     /// asynchronous read into the page cache that returns at once.
     /// (`MADV_WILLNEED` blocks on Darwin until the pages are in, so it is no use
@@ -1011,6 +1076,19 @@ impl StandaloneModuleGraph {
             // SAFETY: the image is mapped for the life of the process; JSC maps the file again itself, so `file` may close after.
             return unsafe { Bun__StaticHeap__map(self.static_heap.as_ptr(), self.static_heap.len(), file.fd().native(), offset) };
         }
+        #[cfg(target_os = "macos")]
+        {
+            unsafe extern "C" {
+                fn Bun__StaticHeap__map(image: *const u8, size: usize, fd: i32, offset_in_file: u64) -> bool;
+            }
+            // (The `__BUN` section's pages are covered by the executable's code signature, so its code may be mapped
+            // executable from the file, as on Linux: no writable code, no MAP_JIT.)
+            let Some((file, offset)) = macho::open_file_of(self.static_heap.as_ptr() as usize) else {
+                return false;
+            };
+            // SAFETY: as above.
+            return unsafe { Bun__StaticHeap__map(self.static_heap.as_ptr(), self.static_heap.len(), file.fd().native(), offset) };
+        }
         #[allow(unreachable_code)]
         false
     }
-- 
