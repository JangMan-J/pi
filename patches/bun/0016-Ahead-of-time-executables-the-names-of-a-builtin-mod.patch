From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 13:15:10 +0530
Subject: [PATCH] Ahead-of-time executables: the names of a builtin module
 required in a wrapper are read once, ahead of the wrapper's dependencies;
 Node's modules only

---
 src/ast/import_record.rs                      |  4 ++
 src/bundler/LinkerContext.rs                  | 49 ++++++++-----
 .../linker_context/convertStmtsForChunk.rs    | 69 ++++++++++++++++---
 .../linker_context/scanImportsAndExports.rs   | 25 +++++--
 4 files changed, 113 insertions(+), 34 deletions(-)

diff --git a/src/ast/import_record.rs b/src/ast/import_record.rs
index 6e582f84..c41f7e5a 100644
--- a/src/ast/import_record.rs
+++ b/src/ast/import_record.rs
@@ -113,6 +113,10 @@ bitflags::bitflags! {
         /// `IS_UNUSED` for its own reasons (an unused TypeScript import, a macro
         /// import), and those records must never be resolved.
         const IS_BARREL_DEFERRED = 1 << 19;
+        /// An `import` statement of a builtin module in a module that is evaluated later (wrapped as ESM), in an
+        /// executable compiled ahead of time: the linker requires the module where the importer is evaluated instead of
+        /// importing it before the program starts (`LinkerContext::requires_builtin_in_wrapper`).
+        const REQUIRED_IN_WRAPPER = 1 << 20;
     }
 }
 
diff --git a/src/bundler/LinkerContext.rs b/src/bundler/LinkerContext.rs
index 5936c810..96f5b56a 100644
--- a/src/bundler/LinkerContext.rs
+++ b/src/bundler/LinkerContext.rs
@@ -1450,7 +1450,7 @@ pub struct LinkerOptions {
     pub(crate) source_maps: SourceMapOption,
     pub(crate) target: Target,
     pub(crate) compile_mode: CompileMode,
-    /// See `LinkerContext::defers_import_into_wrapper`.
+    /// See `LinkerContext::requires_builtin_in_wrapper`.
     pub(crate) defer_builtin_imports: bool,
     pub(crate) metafile: bool,
     /// Path to write JSON metafile (for Bun.build API)
@@ -3972,11 +3972,6 @@ impl<'a> LinkerContext<'a> {
                 | ImportTrackerStatus::External => {
                     if status == ImportTrackerStatus::External
                         && self.options.output_format.keep_es6_import_export_syntax()
-                        && !self.graph.ast.items_named_imports()[prev_source_index as usize]
-                            .get(&tracker.import_ref)
-                            .is_some_and(|named_import| {
-                                self.defers_import_record(prev_source_index, named_import.import_record_index)
-                            })
                     {
                         // Imports from external modules should not be converted to CommonJS
                         // if the output format preserves the original ES6 import statements
@@ -4302,23 +4297,27 @@ impl<'a> LinkerContext<'a> {
     /// import that resolved here is that module's namespace)?
     /// The record of a named import in `source_index` is an `import()` or a
     /// `require()`, so the name is read off the call's result.
-    /// An executable compiled ahead of time (`--compile` with `BUN_STATIC_HEAP=1 BUN_AOT=1`): a builtin module that a module
-    /// evaluated lazily (wrapped as ESM, `init_*()`) imports is required where that module is evaluated, as in a CommonJS
-    /// output file, rather than imported by the program before it starts. A program that loads a part of itself later
-    /// (`await import()`) no longer pays at its start for what only that part uses (`node:http` and what it needs, ...).
-    pub(crate) fn defers_import_into_wrapper(&self, record: &ImportRecord, importer: crate::IndexInt) -> bool {
+    /// An executable compiled ahead of time (`--compile` with `BUN_STATIC_HEAP=1 BUN_AOT=1`): a Node builtin module that a
+    /// module evaluated lazily (wrapped as ESM, `init_*()`) imports with an `import` statement is required where that
+    /// module is evaluated, rather than imported by the program before it starts. A program that loads a part of
+    /// itself later (`await import()`) no longer pays at its start for what only that part uses (`node:http` and what
+    /// it needs, ...). `convert_stmts_for_chunk` writes the statement as `var ns = require(..), a = ns.a, ...` ahead of
+    /// everything else in the wrapper: the names are what they were when the module was first evaluated, as an import's
+    /// are, and are there for whatever the wrapper goes on to evaluate (a module that imports this one back).
+    /// Not `process` (its namespace has what it inherits) nor Bun's own modules (`bun` is no module to load, and the
+    /// default of some is not their `module.exports`): those stay imports.
+    pub(crate) fn requires_builtin_in_wrapper(&self, record: &ImportRecord, importer: crate::IndexInt) -> bool {
         self.options.defer_builtin_imports
             && record.kind == ImportKind::Stmt
             && !record.source_index.is_valid()
+            && record.tag == bun_ast::ImportRecordTag::Builtin
+            && !record.flags.intersects(
+                bun_ast::ImportRecordFlags::IS_UNUSED.union(bun_ast::ImportRecordFlags::PHASE_DEFER),
+            )
             && self.graph.meta.items_flags()[importer as usize].wrap == WrapKind::Esm
-            && bun_resolve_builtins::HardcodedModule::Alias::has(record.path.text, Target::Bun, Default::default())
-    }
-
-    fn defers_import_record(&self, source_index: crate::IndexInt, record_index: u32) -> bool {
-        self.graph.ast.items_import_records()[source_index as usize]
-            .as_slice()
-            .get(record_index as usize)
-            .is_some_and(|record| self.defers_import_into_wrapper(record, source_index))
+            && record.path.text != b"process"
+            && bun_resolve_builtins::HardcodedModule::Alias::get(record.path.text, Target::Bun, Default::default())
+                .is_some_and(|module| module.node_builtin)
     }
 
     fn is_call_record(&self, source_index: crate::IndexInt, record_index: u32) -> bool {
@@ -5198,6 +5197,8 @@ pub struct StmtList {
 
 pub struct InsideWrapperPrefix {
     pub(crate) stmts: Vec<Stmt>,
+    // The builtin modules required in the wrapper (`append_builtin_require`) are the first statements.
+    pub(crate) builtin_requires_end: usize,
     pub(crate) sync_dependencies_end: usize,
     // if true it will exist at `sync_dependencies_end`
     pub(crate) has_async_dependency: bool,
@@ -5207,6 +5208,7 @@ impl InsideWrapperPrefix {
     fn init() -> Self {
         Self {
             stmts: Vec::new(),
+            builtin_requires_end: 0,
             sync_dependencies_end: 0,
             has_async_dependency: false,
         }
@@ -5216,12 +5218,21 @@ impl InsideWrapperPrefix {
 
     pub(crate) fn reset(&mut self) {
         self.stmts.clear();
+        self.builtin_requires_end = 0;
         self.sync_dependencies_end = 0;
         self.has_async_dependency = false;
     }
 }
 
 impl InsideWrapperPrefix {
+    /// Ahead of the dependencies: a builtin module is a leaf, and what the dependencies evaluate may use its names.
+    pub(crate) fn append_builtin_require(&mut self, stmt: Stmt) -> Result<(), AllocError> {
+        self.stmts.insert(self.builtin_requires_end, stmt);
+        self.builtin_requires_end += 1;
+        self.sync_dependencies_end += 1;
+        Ok(())
+    }
+
     pub(crate) fn append_non_dependency(&mut self, stmt: Stmt) -> Result<(), AllocError> {
         self.stmts.push(stmt);
         Ok(())
diff --git a/src/bundler/linker_context/convertStmtsForChunk.rs b/src/bundler/linker_context/convertStmtsForChunk.rs
index 47ac439f..be4fcff3 100644
--- a/src/bundler/linker_context/convertStmtsForChunk.rs
+++ b/src/bundler/linker_context/convertStmtsForChunk.rs
@@ -97,19 +97,68 @@ pub(crate) fn convert_stmts_for_chunk(
                 bun_ast::StmtData::SImport(s) => {
                     // "import * as ns from 'path'"
                     // "import {foo} from 'path'"
-                    if c.defers_import_into_wrapper(&ast.import_records[s.import_record_index as usize], source_index) {
-                        stmts.inside_wrapper_prefix.append_non_dependency(Stmt::alloc(
-                            S::Local {
-                                decls: G::DeclList::from_slice(&[G::Decl {
-                                    binding: Binding::alloc(bump, bun_ast::b::Identifier { r#ref: s.namespace_ref }, stmt.loc),
-                                    value: Some(Expr::init(
-                                        E::RequireString {
-                                            import_record_index: s.import_record_index,
+                    if ast.import_records[s.import_record_index as usize]
+                        .flags
+                        .contains(ImportRecordFlags::REQUIRED_IN_WRAPPER)
+                    {
+                        // var ns = require("path"), a = ns.a, b = ns.default;
+                        let namespace = |loc: Loc| {
+                            Expr::allocate(
+                                bump,
+                                E::Identifier {
+                                    ref_: s.namespace_ref,
+                                    ..Default::default()
+                                },
+                                loc,
+                            )
+                        };
+                        let mut decls: Vec<G::Decl> = Vec::with_capacity(2 + s.items.slice().len());
+                        decls.push(G::Decl {
+                            binding: Binding::alloc(bump, B::Identifier { r#ref: s.namespace_ref }, stmt.loc),
+                            value: Some(Expr::init(
+                                E::RequireString {
+                                    import_record_index: s.import_record_index,
+                                    ..Default::default()
+                                },
+                                stmt.loc,
+                            )),
+                        });
+                        if let Some(default_name) = &s.default_name {
+                            if let Some(ref_) = default_name.ref_.to_nullable() {
+                                decls.push(G::Decl {
+                                    binding: Binding::alloc(bump, B::Identifier { r#ref: ref_ }, default_name.loc),
+                                    value: Some(Expr::allocate(
+                                        bump,
+                                        E::Dot {
+                                            target: namespace(default_name.loc),
+                                            name: b"default".as_slice().into(),
+                                            name_loc: default_name.loc,
                                             ..Default::default()
                                         },
-                                        stmt.loc,
+                                        default_name.loc,
                                     )),
-                                }]),
+                                });
+                            }
+                        }
+                        for item in s.items.slice() {
+                            let Some(ref_) = item.name.ref_.to_nullable() else { continue };
+                            decls.push(G::Decl {
+                                binding: Binding::alloc(bump, B::Identifier { r#ref: ref_ }, item.name.loc),
+                                value: Some(Expr::allocate(
+                                    bump,
+                                    E::Dot {
+                                        target: namespace(item.alias_loc),
+                                        name: item.alias,
+                                        name_loc: item.alias_loc,
+                                        ..Default::default()
+                                    },
+                                    item.name.loc,
+                                )),
+                            });
+                        }
+                        stmts.inside_wrapper_prefix.append_builtin_require(Stmt::alloc(
+                            S::Local {
+                                decls: G::DeclList::from_slice(&decls),
                                 ..Default::default()
                             },
                             stmt.loc,
diff --git a/src/bundler/linker_context/scanImportsAndExports.rs b/src/bundler/linker_context/scanImportsAndExports.rs
index b77f007e..101b1afe 100644
--- a/src/bundler/linker_context/scanImportsAndExports.rs
+++ b/src/bundler/linker_context/scanImportsAndExports.rs
@@ -1090,6 +1090,25 @@ pub(crate) fn scan_imports_and_exports(
             );
 
             let parts_len = col_ref!(parts_list)[id].len() as usize;
+            // The `import` statements of builtin modules that become a `require()` in this file's wrapper
+            // (`requires_builtin_in_wrapper`): said on the record, for what follows and for `convert_stmts_for_chunk`.
+            if this.options.defer_builtin_imports && col_ref!(flags)[id].wrap == WrapKind::Esm {
+                for part_index in 0..parts_len {
+                    for stmt in col_ref!(parts_list)[id].as_slice()[part_index].stmts.slice() {
+                        let bun_ast::StmtData::SImport(import) = stmt.data else { continue };
+                        let record_index = import.import_record_index as usize;
+                        let required = this.requires_builtin_in_wrapper(
+                            &col_ref!(import_records_list)[id].as_slice()[record_index],
+                            id as crate::IndexInt,
+                        );
+                        if required {
+                            col!(import_records_list)[id].as_mut_slice()[record_index]
+                                .flags
+                                .insert(ImportRecordFlags::REQUIRED_IN_WRAPPER);
+                        }
+                    }
+                }
+            }
             for part_index in 0..parts_len {
                 let mut to_esm_uses: u32 = 0;
                 let mut to_common_js_uses: u32 = 0;
@@ -1130,11 +1149,7 @@ pub(crate) fn scan_imports_and_exports(
                         }
 
                         // This is an external import. Check if it will be a "require()" call.
-                        let deferred = !rec_source_index.is_valid() && {
-                            let record = &col_ref!(import_records_list)[id].as_slice()
-                                [import_record_index as usize];
-                            this.defers_import_into_wrapper(record, id as crate::IndexInt)
-                        };
+                        let deferred = rec_flags.contains(ImportRecordFlags::REQUIRED_IN_WRAPPER);
                         if kind == ImportKind::Require
                             || !output_format.keep_es6_import_export_syntax()
                             || kind == ImportKind::Dynamic
