From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sat, 3 Oct 2026 16:35:10 +0000
Subject: [PATCH] Ahead-of-time executables: two garbage collection markers,
 and the idle sweep of the allocator every 250 ms

An interactive program collects often and little. Waking seven marker threads for each collection cost three
fifths of a Pi session's futex calls and a tenth of its CPU while a reply streams; the allocator's sweep on
every park of the thread, at most every 100 ms, another tenth. BUN_JSC_numberOfGCMarkers and
MIMALLOC_PURGE_HOLES_MIN_INTERVAL override both.
---
 src/jsc/bindings/ZigGlobalObject.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/jsc/bindings/ZigGlobalObject.cpp b/src/jsc/bindings/ZigGlobalObject.cpp
index 500b8789..f8b692c4 100644
--- a/src/jsc/bindings/ZigGlobalObject.cpp
+++ b/src/jsc/bindings/ZigGlobalObject.cpp
@@ -1,4 +1,5 @@
 #include "root.h"
+#include <mimalloc.h>
 
 #include "ZigGlobalObject.h"
 #include "BunModuleRegistry.h"
@@ -384,6 +385,13 @@ extern "C" void JSCInitialize(const char* envp[], size_t envc, void (*onCrash)(c
             if (Bun__AOTImage__isMapped())
                 JSC::Options::useAOT() = true;
 
+            // A program compiled ahead of time is an interactive one: its collections are small and many, and waking seven
+            // marker threads for each costs more in wake-ups than the threads save in marking (measured on Pi: three fifths
+            // of a session's futex calls, a tenth of its CPU while a reply streams). The collector and one helper mark.
+            // BUN_JSC_numberOfGCMarkers, below, overrides.
+            if (Bun__AOTImage__isMapped() && JSC::Options::numberOfGCMarkers() > 2)
+                JSC::Options::numberOfGCMarkers() = 2;
+
             if (envc > 0) [[likely]] {
                 auto envc_copy = envc;
                 while (envc_copy--) {
@@ -405,6 +413,12 @@ extern "C" void JSCInitialize(const char* envp[], size_t envc, void (*onCrash)(c
             JSC::Options::assertOptionsAreCoherent();
         }); // end JSC::initialize lambda
         Bun__AOTImage__register();
+        // The same program parks its thread many times a second (every wait for the model or the terminal), and each park
+        // may sweep the heap for free blocks to give back. Every quarter of a second gives back as much within moments, for
+        // less work than every tenth (measured on Pi: a tenth less CPU while a reply streams, the same memory once idle).
+        // MIMALLOC_PURGE_HOLES_MIN_INTERVAL overrides.
+        if (Bun__AOTImage__isMapped() && !getenv("MIMALLOC_PURGE_HOLES_MIN_INTERVAL"))
+            mi_option_set(mi_option_purge_holes_min_interval, 250);
 
 #if OS(WINDOWS) && (CPU(X86_64) || CPU(ARM64))
         // JSC::initialize() registered unwind info + a language-specific SEH
