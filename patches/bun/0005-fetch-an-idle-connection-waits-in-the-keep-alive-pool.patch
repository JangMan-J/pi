+    /// The keep-alive pool options to park this request's socket with: the session's, with how long the
+    /// socket may wait there for the next request settled. A session's own `idle_timeout_seconds` stands.
+    /// Otherwise it is what the server said it keeps an idle connection for (`Keep-Alive: timeout=N`), less
+    /// the time a request takes to get there, and 4 seconds if it said nothing: as undici does
+    /// (`keepAliveTimeout`, `keepAliveTimeoutThreshold`, `keepAliveMaxTimeout`). A connection that has sat
+    /// longer may be gone without a FIN or RST having come back (a NAT that forgot it, a load balancer that
+    /// dropped it, a laptop that slept), and a request written to it waits for an answer until it times out.
+    pub(crate) fn pool_for_release(&self) -> PoolOptions {
+        let mut pool = self.pool;
+        if pool.idle_timeout_seconds == 0 {
+            pool.idle_timeout_seconds = match self.state.keep_alive_timeout {
+                0 => keep_alive_pool_timeout_seconds(),
+                hint => hint.saturating_sub(2).clamp(1, 600),
+            };
+        }
+        pool
+    }
