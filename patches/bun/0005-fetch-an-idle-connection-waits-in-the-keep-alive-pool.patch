@@ -915,6 +933,17 @@ impl<const SSL: bool> HTTPContext<SSL> {
                     continue;
                 }
 
+                // Parked for longer than it may be: the idle timer has not got to it yet (its ticks are
+                // seconds apart, and none while the machine sleeps). What is at the other end by now is
