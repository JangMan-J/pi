+/// The `timeout` parameter of a `Keep-Alive` response header, in seconds: how long the server keeps an idle
+/// connection (`Keep-Alive: timeout=5, max=100`). `None` if there is none or it is not a number.
+pub fn keep_alive_header_timeout(value: &[u8]) -> Option<u32> {
+    for token in HeaderValueIterator::init(value) {
+        let Some(eq) = token.iter().position(|&c| c == b'=') else {
+            continue;
+        };
+        let name = strings::trim(&token[..eq], b" \t");
+        if !strings::eql_case_insensitive_ascii_check_length(name, b"timeout") {
+            continue;
+        }
+        let digits = strings::trim(&token[eq + 1..], b" \t");
+        if digits.is_empty() || digits.len() > 9 || !digits.iter().all(u8::is_ascii_digit) {
+            return None;
+        }
+        return Some(digits.iter().fold(0u32, |n, &d| n * 10 + u32::from(d - b'0')));
+    }
+    None
+}
+
