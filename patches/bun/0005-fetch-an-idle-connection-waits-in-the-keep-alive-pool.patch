 src/http/HeaderValueIterator.rs | 20 +++++++++++++++++
 src/http/InternalState.rs       |  4 ++++
 src/http/lib.rs                 | 39 ++++++++++++++++++++++++++++++---
 6 files changed, 106 insertions(+), 8 deletions(-)

