+
+/// Milliseconds on a clock that keeps going while the machine is suspended: the wall clock. (It can be set
+/// back, which only makes a parked socket look younger until the idle timer gets to it, or forward, which
+/// costs a new connection.)
+pub(crate) fn parked_clock_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis() as u64)
 }
 
