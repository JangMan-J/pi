+    slowCases.append(jit.branchIfNotFunction(argument1));
+    jit.loadPtr(Address(argument1, JSFunction::offsetOfExecutableOrRareData()), structure);
+    slowCases.append(jit.branchTestPtr(CCallHelpers::Zero, structure, TrustedImm32(JSFunction::rareDataTag)));
+    jit.loadPtr(Address(structure, FunctionRareData::offsetOfObjectAllocationProfile() + ObjectAllocationProfileWithPrototype::offsetOfAllocator() - JSFunction::rareDataTag), allocator);
+    jit.loadPtr(Address(structure, FunctionRareData::offsetOfObjectAllocationProfile() + ObjectAllocationProfileWithPrototype::offsetOfStructure() - JSFunction::rareDataTag), structure);
