     AllowMacroScratchRegisterUsage allowScratch(jit);
-    jit.emitRestore(code.calleeSaveRegisterAtOffsetList());
+    restoreCalleeSaves(jit, code);
     jit.emitFunctionEpilogue();
 }
 
