diff --git a/Source/JavaScriptCore/aot/AOTConvention.h b/Source/JavaScriptCore/aot/AOTConvention.h
index 2e95072fc9..2442b0290a 100644
--- a/Source/JavaScriptCore/aot/AOTConvention.h
