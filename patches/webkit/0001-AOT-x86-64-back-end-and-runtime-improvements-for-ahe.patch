 // The object that is called. Likewise left out by who knows better.
 static constexpr GPRReg calleeGPR = ARM64Registers::x10;
 #elif CPU(X86_64)
+// x86-64 has nine registers that a C function may clobber, against eighteen on ARM64, and r11 is the macro assembler's. So that
+// the stubs have room, a call to one also clobbers rbx and r12 (stubClobberedRegisters()), and the stubs' temporaries live there.
+// Except the hot ones (stubPreservesCalleeSaves()): those keep to the nine, so that compiled code can keep something in rbx and
+// r12 across the call (stubClobberedRegistersLight()).
 static constexpr GPRReg thisGPR = X86Registers::eax;
 static constexpr GPRReg countGPR = X86Registers::r10;
-static constexpr GPRReg calleeGPR = X86Registers::r11;
+static constexpr GPRReg calleeGPR = X86Registers::r12;
 #else
 static constexpr GPRReg thisGPR = InvalidGPRReg;
 static constexpr GPRReg countGPR = InvalidGPRReg;
 static constexpr GPRReg calleeGPR = InvalidGPRReg;
 #endif
 
+// The stubs' temporaries that compiled code also knows about: T9 says which operation (or how many arguments), T10 and T11 are
+// written by some stubs that otherwise preserve everything (StubClobbers::Temporaries, cold calls) on ARM64; on x86-64 those
+// stubs make do with T9 and the assembler's scratch register (stubTemporaryRegisters()), T10 and T11 being callee-saved there.
+// The rest of the stubs' temporaries are their own business.
+#if CPU(ARM64)
+static constexpr GPRReg stubT9GPR = ARM64Registers::x9;
+static constexpr GPRReg stubT10GPR = ARM64Registers::x10;
+static constexpr GPRReg stubT11GPR = ARM64Registers::x11;
+#elif CPU(X86_64)
+static constexpr GPRReg stubT9GPR = X86Registers::r10;
+static constexpr GPRReg stubT10GPR = X86Registers::r12;
+static constexpr GPRReg stubT11GPR = X86Registers::ebx;
+#else
+static constexpr GPRReg stubT9GPR = InvalidGPRReg;
+static constexpr GPRReg stubT10GPR = InvalidGPRReg;
+static constexpr GPRReg stubT11GPR = InvalidGPRReg;
+#endif
+static_assert(countGPR == stubT9GPR && calleeGPR == stubT10GPR);
+
+// Arguments of an operation (Stub::Operation*, Stub::PlainOperation*) beyond the argument registers: on x86-64 the seventh is passed
+// in stubT10GPR and the eighth in stubT11GPR, and the stub puts them where the C convention wants them, on the stack.
+#if CPU(X86_64)
+constexpr unsigned numberOfStackArgumentsOfOperationStubs = 2;
+#else
+constexpr unsigned numberOfStackArgumentsOfOperationStubs = 0;
+#endif
+
+// Where a stub hands back its result: the first argument register. On ARM64 that is also where C returns one (x0); on x86-64 C
+// returns in rax, and the stubs move it.
+static constexpr GPRReg stubResultGPR = GPRInfo::argumentGPR0;
+
+// A patchpoint that calls says so by clobbering this late; hasNoFrame() and the leaf analysis look for it. On ARM64 it is the link
+// register, which a call does overwrite. x86-64 has none, so it is an FPR that every call clobbers anyway.
+#if CPU(ARM64)
+static constexpr Reg callMarkerRegister = Reg(ARM64Registers::lr);
+#elif CPU(X86_64)
+static constexpr Reg callMarkerRegister = Reg(X86Registers::xmm15);
+#endif
+
+inline RegisterSet callMarkerRegisters()
+{
+    RegisterSet result;
+    result.add(callMarkerRegister, IgnoreVectors);
+    return result;
+}
+
+// What a call to a stub that may clobber what a C function may clobber clobbers (StubClobbers::CallerSavedRegisters).
+inline RegisterSet stubClobberedRegisters()
+{
+    RegisterSet result = RegisterSet::registersToSaveForCCall(RegisterSet::allScalarRegisters());
+#if CPU(X86_64)
+    result.add(X86Registers::ebx, IgnoreVectors);
+    result.add(X86Registers::r12, IgnoreVectors);
+#endif
+    return result;
+}
+
+// The same for a stub that keeps to what a C function may clobber (stubPreservesCalleeSaves()): on x86-64 that leaves rbx and r12
+// to compiled code, which may keep something in them across the call. On ARM64 the two sets are one.
+inline RegisterSet stubClobberedRegistersLight()
+{
+    return RegisterSet::registersToSaveForCCall(RegisterSet::allScalarRegisters());
+}
+
+// What a stub of StubClobbers::Temporaries writes, besides the assembler's scratch registers.
+inline RegisterSet stubTemporaryRegisters()
+{
+    RegisterSet result;
+    result.add(stubT9GPR, IgnoreVectors);
+#if CPU(ARM64)
+    result.add(stubT10GPR, IgnoreVectors);
+    result.add(stubT11GPR, IgnoreVectors);
+#endif
+    return result;
+}
+
+// Whether a call to the stub clobbers only stubClobberedRegistersLight(). The stub's fast paths then use no callee-saved register,
+// and its slow paths save them around whatever may overwrite them (a call into JavaScript). AOTLowerCore.cpp has the list.
+enum class Stub : uint8_t;
+bool stubPreservesCalleeSaves(Stub);
+
 enum class Signature : uint8_t {
     // Each parameter in its register. Whoever calls fills in undefined for what it has not got, and keeps what is left over to itself.
     Registers,
