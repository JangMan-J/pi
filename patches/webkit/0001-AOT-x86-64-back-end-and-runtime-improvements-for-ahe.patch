+// See Options::aotRecordRegExpsPath(). Each pattern is written once per process.
+static void recordRegExpForImage(const String& pattern, OptionSet<Yarr::Flags> flags)
+{
+    static Lock lock;
+    static NeverDestroyed<UncheckedKeyHashSet<String>> recorded;
+    StringBuilder line;
+    line.append(String::fromLatin1(Yarr::flagsString(flags).data()), '/');
+    for (char16_t c : StringView(pattern).codeUnits()) {
+        if (c == '\\')
+            line.append("\\\\"_s);
