--- /dev/null
+++ b/Source/JavaScriptCore/aot/AOTStubsX86_64.cpp
@@ -0,0 +1,3453 @@
+/*
+ * Copyright (C) 2026 Oven, Inc. All rights reserved.
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+// The stubs (AOTStubs.h) for x86-64. Included by AOTStubs.cpp, which generates them in stubBlob(). The ARM64 versions are
+// the reference: each stub here does what its namesake there does, with the differences that follow from the CPU.
+//
+// Registers. A stub may clobber what a C function may clobber and, on x86-64 only, rbx and r12 (stubClobberedRegisters()),
+// because there would not be enough without them. The hot stubs do without (stubPreservesCalleeSaves(), the "light" stubs): their
+// fast paths use neither T10 nor T11, so that compiled code can keep something in rbx and r12 across the call, their slow paths
+// call C, which preserves them, and the one place where a light stub calls JavaScript (callGetter()) saves them around the call,
+// since compiled code clobbers them and the callee has to go in calleeGPR, which is r12. C code that is called from a stub and comes
+// back into compiled code (a getter the operation calls, say) goes through an adapter (adapt()), which saves and restores them: so
+// the C call preserves them whatever it does. A stub of StubClobbers::Temporaries makes do with T9 and the scratch register
+// (stubTemporaryRegisters()). Names, as the ARM64 stubs use them:
+//   A0-A5    rdi rsi rdx rcx r8 r9   (the C argument registers; results are returned in A0, see stubResultGPR)
+//   thisGPR  rax
+//   T9       r10   (countGPR; the operation's offset in the runtime table)
+//   T10      r12   (calleeGPR)
+//   T11      rbx
+//   T12, T13 r14, r15 — the tag registers. A stub that uses them puts the tags back (restoreTagRegisters()) before it
+//            returns to, jumps to or calls compiled code, and checks types with DoNotHaveTagRegisters until then.
+//   scratch  r11, the macro assembler's: never live across a macro instruction that may use it.
+// The return address is at [rsp] on entry, where ARM64 has the link register; after emitFunctionPrologue() it is at
+// [rbp + 8]. A stub is entered with rsp = 8 mod 16, so one that calls C without pushing a frame first aligns the stack.
+
+#if CPU(X86_64)
+
+static CCallHelpers::Label s_labels[numberOfStubs];
+static Vector<std::pair<CCallHelpers::Call, Stub>>* s_callsBetweenStubs;
+static Vector<CCallHelpers::Label>* s_returnsIntoAdapters;
+
+static void callStubFromStub(CCallHelpers& jit, Stub stub)
+{
+    s_callsBetweenStubs->append({ jit.nearCall(), stub });
+}
+
+// Places where the address of a location in the stubs is materialized, position-independently. x86-64 has lea reg, [rip + disp32],
+// which the macro assembler does not emit: lea reg, [rbp + disp32] is, with the same length, and stubBlob() rewrites its ModRM byte
+// and displacement once the stubs are linked (ARM64 patches an adr likewise).
+struct RIPRelativeLea {
+    CCallHelpers::Label end;
+    CCallHelpers::Label target;
+};
+static Vector<RIPRelativeLea>* s_ripRelativeLeas;
+
+static void loadAddressOfLabel(CCallHelpers& jit, CCallHelpers::Label target, GPRReg dest)
+{
+    jit.m_assembler.leaq_mr(0x10000, X86Registers::ebp, dest); // A displacement too large for disp8.
+    s_ripRelativeLeas->append({ jit.label(), target });
+}
+
+void linkRIPRelativeLeas(LinkBuffer& linkBuffer)
+{
+    for (auto& lea : *s_ripRelativeLeas) {
+        auto* end = static_cast<uint8_t*>(linkBuffer.locationOf<JITThunkPtrTag>(lea.end).untaggedPtr());
+        auto* target = static_cast<uint8_t*>(linkBuffer.locationOf<JITThunkPtrTag>(lea.target).untaggedPtr());
+        uint8_t modRM = end[-5];
+        RELEASE_ASSERT((modRM & 0xc7) == 0x85); // mod 10 (disp32), r/m 101 (rbp)
+        modRM &= 0x3f; // mod 00, r/m 101: rip + disp32
+        int32_t displacement = static_cast<int32_t>(target - end);
+        performJITMemcpy<jitMemcpyRepatch>(end - 5, &modRM, sizeof(modRM));
+        performJITMemcpy<jitMemcpyRepatch>(end - 4, &displacement, sizeof(displacement));
+    }
+}
+
+constexpr GPRReg A0 = GPRInfo::argumentGPR0;
+constexpr GPRReg A1 = GPRInfo::argumentGPR1;
+constexpr GPRReg A2 = GPRInfo::argumentGPR2;
+constexpr GPRReg A3 = GPRInfo::argumentGPR3;
+constexpr GPRReg A4 = GPRInfo::argumentGPR4;
+constexpr GPRReg A5 = GPRInfo::argumentGPR5;
+constexpr GPRReg T9 = stubT9GPR;
+constexpr GPRReg T10 = stubT10GPR;
+constexpr GPRReg T11 = stubT11GPR;
+constexpr GPRReg T12 = GPRInfo::numberTagRegister;
+constexpr GPRReg T13 = GPRInfo::notCellMaskRegister;
+constexpr GPRReg scratchGPR = MacroAssembler::s_scratchRegister;
+static_assert(noOverlap(A0, A1, A2, A3, A4, A5, thisGPR, T9, T10, T11, T12, T13, scratchGPR, instanceGPR));
+static_assert(countGPR == T9 && calleeGPR == T10);
+
+static void restoreTagRegisters(CCallHelpers& jit)
+{
+    jit.emitMaterializeTagCheckRegisters();
+}
+
+static void loadInstance(CCallHelpers& jit, GPRReg result)
+{
+    jit.move(instanceGPR, result);
+}
+
+static void jumpToEntry(CCallHelpers& jit, GPRReg data, Entry entry)
+{
+    jit.loadPtr(Address(data, Instance::offsetOfRuntimeTable()), data);
+    jit.loadPtr(Address(data, static_cast<unsigned>(entry) * sizeof(void*)), data);
+    jit.farJump(data, JITThunkPtrTag);
+}
+
+// A slot of the frame that the caller has made for the code being entered, which has pushed nothing yet: the return address is
+// already on the stack (ARM64's is in the link register, so it has one formula for this and for the next).
+static Address slotOfFrameBeingEntered(CallFrameSlot slot, ptrdiff_t offset = 0)
+{
+    return Address(CCallHelpers::stackPointerRegister, (static_cast<int>(slot) - CallerFrameAndPC::sizeInRegisters) * static_cast<int>(sizeof(Register)) + static_cast<int>(prologueStackPointerDelta()) + offset);
+}
+
+// A slot of the frame that the next call will complete.
+static Address slotOfFrameOfNextCall(CallFrameSlot slot, ptrdiff_t offset = 0)
+{
+    return Address(CCallHelpers::stackPointerRegister, (static_cast<int>(slot) - CallerFrameAndPC::sizeInRegisters) * static_cast<int>(sizeof(Register)) + offset);
+}
+
+// ---- Frames
+
+// Called after the frame pointer is set up, T9 = frame size. Checks for stack overflow and sets the stack pointer. Clobbers T9 and
+// the scratch register only: ARM64 uses T11 and T12, but here T11 (rbx) is callee-saved in compiled code, which has not saved it
+// yet, and T12 is a tag register.
+static void generatePrologue(CCallHelpers& jit)
+{
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfVM()), scratchGPR);
+    jit.loadPtr(Address(scratchGPR, VM::offsetOfSoftStackLimit()), scratchGPR);
+    jit.neg64(T9);
+    jit.add64(GPRInfo::callFrameRegister, T9);
+    Jump overflow = jit.branchPtr(CCallHelpers::Above, scratchGPR, T9);
+    // The frame is so large that the subtraction wrapped around.
+    Jump wrapped = jit.branchPtr(CCallHelpers::Above, T9, GPRInfo::callFrameRegister);
+    // (pop, move, push, ret rather than a jump: a `ret` for every `call` keeps the return stack buffer right.)
+    jit.pop(scratchGPR);
+    jit.move(T9, CCallHelpers::stackPointerRegister);
+    jit.push(scratchGPR);
+    jit.ret();
+
+    overflow.link(&jit);
+    wrapped.link(&jit);
+    jit.move(instanceGPR, scratchGPR);
+    jumpToEntry(jit, scratchGPR, Entry::ThrowStackOverflowAtPrologue);
+}
+
+// ---- Exceptions
+
+static void unwind(CCallHelpers& jit, GPRReg vm, GPRReg lookUp)
+{
+    constexpr GPRReg keptVM = GPRInfo::regCS0;
+    RELEASE_ASSERT(noOverlap(vm, lookUp, A0, GPRInfo::regT1));
+    jit.emitFunctionPrologue();
+    jit.move(vm, GPRInfo::regT1);
+    jit.copyCalleeSavesToVMEntryFrameCalleeSavesBuffer(GPRInfo::regT1);
+    // This frees them for use here: the handler restores them from there.
+    jit.move(vm, keptVM);
+    jit.move(vm, A0);
+    jit.call(lookUp, OperationPtrTag);
+    // As on ARM64: the frame is made to look like a WebAssembly frame, whose CodeBlock slot holds an instance that has the VM.
+    constexpr ptrdiff_t offsetOfInstance = 4 * sizeof(Register);
+    static_assert(static_cast<int>(CallFrameSlot::callee) < 4);
+    jit.subPtr(TrustedImm32(WTF::roundUpToMultipleOf<stackAlignmentBytes()>(offsetOfInstance + Instance::offsetOfVM() + sizeof(void*))), CCallHelpers::stackPointerRegister);
+    jit.move(CCallHelpers::stackPointerRegister, GPRInfo::callFrameRegister);
+    jit.addPtr(TrustedImm32(offsetOfInstance), GPRInfo::callFrameRegister, GPRInfo::regT1);
+    jit.storePtr(GPRInfo::regT1, CCallHelpers::addressFor(CallFrameSlot::codeBlock));
+    jit.storePtr(keptVM, Address(GPRInfo::regT1, Instance::offsetOfVM()));
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NativeCalleeTag), GPRInfo::regT1);
+    jit.store64(GPRInfo::regT1, CCallHelpers::addressFor(CallFrameSlot::callee));
+    jit.loadPtr(Address(keptVM, OBJECT_OFFSETOF(VM, targetMachinePCForThrow)), GPRInfo::regT1);
+    jit.farJump(GPRInfo::regT1, ExceptionHandlerPtrTag);
+}
+
+// Jumped to with the return address into the compiled function that noticed the exception on top of the stack.
+// Only caller-saved registers: unwind() copies the callee-saved ones for the handler before anything else.
+static void generateHandleException(CCallHelpers& jit)
+{
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfVM()), X86Registers::ecx);
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfRuntimeTable()), X86Registers::eax);
+    jit.loadPtr(Address(X86Registers::eax, static_cast<unsigned>(Entry::LookupExceptionHandler) * sizeof(void*)), X86Registers::eax);
+    unwind(jit, X86Registers::ecx, X86Registers::eax);
+}
+
+static void throwStackOverflow(CCallHelpers& jit)
+{
+    jit.emitFunctionPrologue();
+    jit.move(instanceGPR, A0);
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfRuntimeTable()), T9);
+    jit.loadPtr(Address(T9, static_cast<unsigned>(Entry::ThrowStackOverflowError) * sizeof(void*)), T9);
+    jit.call(T9, OperationPtrTag);
+    jit.emitFunctionEpilogue();
+    generateHandleException(jit);
+}
+
+static void generateThrowStackOverflowAtPrologue(CCallHelpers& jit)
+{
+    // The function has not saved any registers yet and its frame is not valid. The error is attributed to the caller.
+    jit.emitFunctionEpilogue();
+    throwStackOverflow(jit);
+}
+
+static void generateCatch(CCallHelpers& jit)
+{
+    constexpr GPRReg vm = GPRInfo::regT3;
+    jit.load64(CCallHelpers::addressFor(CallFrameSlot::callee), vm);
+#if ENABLE(WEBASSEMBLY)
+    jit.and64(CCallHelpers::TrustedImm64(JSValue::NativeCalleeMask), vm, GPRInfo::regT0);
+    Jump isJSCallee = jit.branch64(CCallHelpers::NotEqual, GPRInfo::regT0, CCallHelpers::TrustedImm64(JSValue::NativeCalleeTag));
+    jit.loadPtr(CCallHelpers::addressFor(CallFrameSlot::codeBlock), vm);
+    jit.loadPtr(Address(vm, JSWebAssemblyInstance::offsetOfVM()), vm);
+    Jump haveVM = jit.jump();
+    isJSCallee.link(&jit);
+#endif
+    Jump isPreciseAllocation = jit.branchTestPtr(CCallHelpers::NonZero, vm, TrustedImm32(PreciseAllocation::halfAlignment));
+    jit.andPtr(CCallHelpers::TrustedImmPtr(MarkedBlock::blockMask), vm);
+    jit.loadPtr(Address(vm, MarkedBlock::offsetOfHeader + MarkedBlock::Header::offsetOfVM()), vm);
+    Jump haveVMToo = jit.jump();
+    isPreciseAllocation.link(&jit);
+    jit.loadPtr(Address(vm, PreciseAllocation::offsetOfWeakSet() + WeakSet::offsetOfVM() - PreciseAllocation::headerSize()), vm);
+    haveVMToo.link(&jit);
+#if ENABLE(WEBASSEMBLY)
+    haveVM.link(&jit);
+#endif
+    jit.restoreCalleeSavesFromVMEntryFrameCalleeSavesBuffer(vm, GPRInfo::regT0);
+    jit.loadPtr(Address(vm, VM::callFrameForCatchOffset()), GPRInfo::callFrameRegister);
+    jit.storePtr(CCallHelpers::TrustedImmPtr(nullptr), Address(vm, VM::callFrameForCatchOffset()));
+    jit.loadPtr(Address(vm, OBJECT_OFFSETOF(VM, targetMachinePCAfterCatch)), GPRInfo::regT1);
+    jit.farJump(GPRInfo::regT1, ExceptionHandlerPtrTag);
+}
+
+// ---- Calls to C++
+
+enum class Returns : uint8_t { Value, Void, Double };
+
+// As on ARM64, but the C++ result comes back in rax, and a stub hands its result back in A0 (stubResultGPR).
+// passesStackArguments: the seventh and eighth arguments, in T10 and T11, go on the stack (numberOfStackArgumentsOfOperationStubs).
+static void callAndCheckException(CCallHelpers& jit, GPRReg function, Returns returns, GPRReg result = stubResultGPR, bool passesStackArguments = false)
+{
+    jit.emitFunctionPrologue();
+    if (passesStackArguments) {
+        static_assert(numberOfStackArgumentsOfOperationStubs == 2);
+        jit.subPtr(TrustedImm32(2 * sizeof(void*)), CCallHelpers::stackPointerRegister);
+        jit.store64(T10, Address(CCallHelpers::stackPointerRegister));
+        jit.store64(T11, Address(CCallHelpers::stackPointerRegister, sizeof(void*)));
+    }
+    jit.call(function, OperationPtrTag);
+    jit.emitFunctionEpilogue();
+    Jump exception;
+    switch (returns) {
+    case Returns::Value:
+        exception = jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR2);
+        break;
+    case Returns::Void:
+        exception = jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR);
+        break;
+    case Returns::Double:
+        loadInstance(jit, T9);
+        jit.loadPtr(Address(T9, Instance::offsetOfVM()), T9);
+        exception = jit.branchTestPtr(CCallHelpers::NonZero, Address(T9, VM::exceptionOffset()));
+        break;
+    }
+    jit.move(GPRInfo::returnValueGPR, result);
+    jit.ret();
+    exception.link(&jit);
+    loadInstance(jit, T9);
+    jumpToEntry(jit, T9, Entry::HandleException);
+}
+
+// (The function is got at through the scratch register: T10 and T11 may hold the seventh and eighth arguments.)
+static void generateOperation(CCallHelpers& jit, Returns returns, bool withGlobalObject, GPRReg result = stubResultGPR)
+{
+    loadInstance(jit, scratchGPR);
+    if (withGlobalObject)
+        jit.loadPtr(Address(scratchGPR, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(scratchGPR, Instance::offsetOfRuntimeTable()), scratchGPR);
+    jit.loadPtr(CCallHelpers::BaseIndex(scratchGPR, T9, CCallHelpers::TimesOne), scratchGPR);
+    callAndCheckException(jit, scratchGPR, returns, result, true);
+}
+
+static void generateOperationValue(CCallHelpers& jit) { generateOperation(jit, Returns::Value, false); }
+static void generateOperationVoid(CCallHelpers& jit) { generateOperation(jit, Returns::Void, false); }
+static void generateOperationDouble(CCallHelpers& jit) { generateOperation(jit, Returns::Double, false); }
+static void generateOperationValueWithGlobalObject(CCallHelpers& jit) { generateOperation(jit, Returns::Value, true); }
+static void generateOperationVoidWithGlobalObject(CCallHelpers& jit) { generateOperation(jit, Returns::Void, true); }
+static void generateOperationDoubleWithGlobalObject(CCallHelpers& jit) { generateOperation(jit, Returns::Double, true); }
+
+// Operations that neither throw nor walk the stack. ARM64 jumps to them and they return straight to the caller with the result
+// in x0, which is A0. Here the result is in rax, so the stub calls them, in a frame of its own, which also aligns the stack.
+static void generatePlain(CCallHelpers& jit, std::optional<ptrdiff_t> firstArgument)
+{
+    loadInstance(jit, scratchGPR);
+    if (firstArgument)
+        jit.loadPtr(Address(scratchGPR, *firstArgument), A0);
+    jit.loadPtr(Address(scratchGPR, Instance::offsetOfRuntimeTable()), scratchGPR);
+    jit.loadPtr(CCallHelpers::BaseIndex(scratchGPR, T9, CCallHelpers::TimesOne), scratchGPR);
+    jit.emitFunctionPrologue();
+    // The seventh and eighth arguments, if any (numberOfStackArgumentsOfOperationStubs).
+    jit.subPtr(TrustedImm32(2 * sizeof(void*)), CCallHelpers::stackPointerRegister);
+    jit.store64(T10, Address(CCallHelpers::stackPointerRegister));
+    jit.store64(T11, Address(CCallHelpers::stackPointerRegister, sizeof(void*)));
+    jit.call(scratchGPR, OperationPtrTag);
+    jit.emitFunctionEpilogue();
+    jit.move(GPRInfo::returnValueGPR, stubResultGPR);
+    jit.ret();
+}
+
+static void generatePlainOperation(CCallHelpers& jit) { generatePlain(jit, std::nullopt); }
+static void generatePlainOperationWithGlobalObject(CCallHelpers& jit) { generatePlain(jit, Instance::offsetOfGlobalObject()); }
+static void generatePlainOperationWithVM(CCallHelpers& jit) { generatePlain(jit, Instance::offsetOfVM()); }
+
+// For rarely executed calls: (global object, then A1 and A2). Preserves every register but T9, the scratch register and, for the
+// Value variants, rax, where the result is (emitColdCall() asks for it there). Not T10, as on ARM64: it is callee-saved here, and
+// the leaf's return address, which ARM64 passes in it, is on the stack. OfLeaf: the caller has no frame; its return address is
+// above the stub's on the stack, and the stub makes the frame that its prologue would have made.
+static void generateColdOperation(CCallHelpers& jit, bool ofLeaf, bool returnsValue = false)
+{
+    constexpr GPRReg fp = GPRInfo::callFrameRegister;
+    constexpr GPRReg sp = CCallHelpers::stackPointerRegister;
+    if (ofLeaf) {
+        jit.pop(scratchGPR); // The stub's return address.
+        jit.push(fp);
+        jit.move(sp, fp);
+        jit.push(scratchGPR);
+    }
+    jit.emitFunctionPrologue();
+    static constexpr GPRReg saved[] = { X86Registers::eax, X86Registers::ecx, X86Registers::edx, X86Registers::esi, X86Registers::edi, X86Registers::r8, X86Registers::r9 };
+    static constexpr unsigned numberOfGPRs = std::size(saved) + 1; // And a word of padding.
+    static constexpr unsigned numberOfFPRs = 16;
+    static_assert(!((numberOfGPRs + numberOfFPRs) * 8 % stackAlignmentBytes()));
+    jit.subPtr(TrustedImm32((numberOfGPRs + numberOfFPRs) * 8), sp);
+    for (unsigned i = 0; i < std::size(saved); ++i)
+        jit.storePtr(saved[i], Address(sp, i * 8));
+    for (unsigned i = 0; i < numberOfFPRs; ++i)
+        jit.storeDouble(static_cast<FPRReg>(X86Registers::xmm0 + i), Address(sp, (numberOfGPRs + i) * 8));
+    loadInstance(jit, scratchGPR);
+    jit.loadPtr(Address(scratchGPR, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(scratchGPR, Instance::offsetOfRuntimeTable()), scratchGPR);
+    jit.loadPtr(CCallHelpers::BaseIndex(scratchGPR, T9, CCallHelpers::TimesOne), T9);
+    jit.call(T9, OperationPtrTag);
+    jit.move(returnsValue ? GPRInfo::returnValueGPR2 : GPRInfo::returnValueGPR, scratchGPR);
+    for (unsigned i = 0; i < std::size(saved); ++i) {
+        if (!(returnsValue && saved[i] == GPRInfo::returnValueGPR))
+            jit.loadPtr(Address(sp, i * 8), saved[i]);
+    }
+    for (unsigned i = 0; i < numberOfFPRs; ++i)
+        jit.loadDouble(Address(sp, (numberOfGPRs + i) * 8), static_cast<FPRReg>(X86Registers::xmm0 + i));
+    jit.emitFunctionEpilogue();
+    Jump exception = jit.branchTestPtr(CCallHelpers::NonZero, scratchGPR);
+    if (ofLeaf) {
+        jit.pop(scratchGPR);
+        jit.pop(fp);
+        jit.farJump(scratchGPR, NoPtrTag);
+    } else
+        jit.ret();
+    exception.link(&jit);
+    loadInstance(jit, T9);
+    jumpToEntry(jit, T9, Entry::HandleException);
+}
+static void generateColdOperationVoid(CCallHelpers& jit) { generateColdOperation(jit, false); }
+static void generateColdOperationVoidOfLeaf(CCallHelpers& jit) { generateColdOperation(jit, true); }
+static void generateColdOperationValue(CCallHelpers& jit) { generateColdOperation(jit, false, true); }
+static void generateColdOperationValueOfLeaf(CCallHelpers& jit) { generateColdOperation(jit, true, true); }
+
+// Calls an operation that neither throws nor walks the stack and returns from the stub with every register preserved (except
+// A0, if the result is used, which is where it is handed back). setUp places the arguments; it receives the Data in T10 and must
+// preserve it, and is told where the return address is, relative to the stack pointer. On x86-64 "every register" includes rbx
+// and r12, which a C function preserves but which the stub uses.
+template<typename SetUp>
+static void callPreservingRegistersAndReturn(CCallHelpers& jit, Entry operation, bool hasResult, const SetUp& setUp)
+{
+    RegisterSet toSave = stubClobberedRegisters();
+    Vector<Reg, 48> registers;
+    toSave.forEach([&](Reg reg) {
+        if (!hasResult || reg != Reg(stubResultGPR))
+            registers.append(reg);
+    });
+    // Entered with rsp = 8 mod 16: this leaves it aligned.
+    unsigned bytes = WTF::roundUpToMultipleOf<stackAlignmentBytes()>(registers.size() * sizeof(CPURegister)) + sizeof(CPURegister);
+    jit.subPtr(TrustedImm32(bytes), CCallHelpers::stackPointerRegister);
+    for (unsigned i = 0; i < registers.size(); ++i) {
+        Address address(CCallHelpers::stackPointerRegister, i * sizeof(CPURegister));
+        if (registers[i].isGPR())
+            jit.storePtr(registers[i].gpr(), address);
+        else
+            jit.storeDouble(registers[i].fpr(), address);
+    }
+    loadInstance(jit, T10);
+    setUp(static_cast<int32_t>(bytes));
+    jit.loadPtr(Address(T10, Instance::offsetOfRuntimeTable()), T10);
+    jit.loadPtr(Address(T10, static_cast<unsigned>(operation) * sizeof(void*)), T10);
+    jit.call(T10, OperationPtrTag);
+    if (hasResult)
+        jit.move(GPRInfo::returnValueGPR, stubResultGPR);
+    for (unsigned i = 0; i < registers.size(); ++i) {
+        Address address(CCallHelpers::stackPointerRegister, i * sizeof(CPURegister));
+        if (registers[i].isGPR())
+            jit.loadPtr(address, registers[i].gpr());
+        else
+            jit.loadDouble(address, registers[i].fpr());
+    }
+    jit.addPtr(TrustedImm32(bytes), CCallHelpers::stackPointerRegister);
+    jit.ret();
+}
+
+static CCallHelpers::Label s_longWayOfWriteBarrier;
+static CCallHelpers::Label s_longWayOfToBoolean;
+
+// A0 = the cell that was stored to. Clobbers only T9 and the scratch register (stubTemporaryRegisters(); ARM64: T9-T11). The
+// threshold is held in the scratch register across loads and a compare of registers only, which do not use it.
+static void generateWriteBarrier(CCallHelpers& jit)
+{
+    jit.load8(Address(A0, JSCell::cellStateOffset()), T9);
+    loadInstance(jit, scratchGPR);
+    jit.loadPtr(Address(scratchGPR, Instance::offsetOfVM()), scratchGPR);
+    jit.load32(Address(scratchGPR, VM::offsetOfHeapBarrierThreshold()), scratchGPR);
+    Jump slow = jit.branch32(CCallHelpers::BelowOrEqual, T9, scratchGPR);
+    jit.ret();
+
+    slow.link(&jit);
+    jit.move(A0, T9);
+    s_longWayOfWriteBarrier = jit.label();
+    callPreservingRegistersAndReturn(jit, Entry::operationAOTWriteBarrier, false, [&](int32_t) {
+        jit.move(T9, A1);
+        jit.loadPtr(Address(T10, Instance::offsetOfVM()), A0);
+    });
+}
+
+// A0 = a value. Returns its truthiness (0 or 1) in A0. Clobbers only A0, T9 and the scratch register (ARM64: A0 and T9-T11). The
+// tags are valid: compiled code's are, and Stub::IteratorNext, which also calls this, leaves them alone; so the number tag is read
+// from its register rather than materialized in T10.
+static void generateToBoolean(CCallHelpers& jit)
+{
+    constexpr GPRReg asked = A0;
+    constexpr GPRReg numberTag = GPRInfo::numberTagRegister;
+    auto answer = [&](bool value) {
+        jit.move(TrustedImm32(value), A0);
+        jit.ret();
+    };
+
+    jit.xor64(TrustedImm32(JSValue::ValueFalse), asked, T9);
+    Jump notBoolean = jit.branchTest64(CCallHelpers::NonZero, T9, TrustedImm32(~1));
+    jit.move(T9, A0);
+    jit.ret();
+
+    notBoolean.link(&jit);
+    Jump notInt32 = jit.branch64(CCallHelpers::Below, asked, numberTag);
+    jit.test32(CCallHelpers::NonZero, asked, asked, A0);
+    jit.ret();
+
+    notInt32.link(&jit);
+    Jump notNumber = jit.branchTest64(CCallHelpers::Zero, asked, numberTag);
+    jit.add64(numberTag, asked, T9);
+    jit.lshift64(TrustedImm32(1), T9);
+    Jump isZero = jit.branchTest64(CCallHelpers::Zero, T9);
+    jit.move(CCallHelpers::TrustedImm64(static_cast<int64_t>(0xffe0000000000000ULL)), scratchGPR);
+    Jump isNaN = jit.branch64(CCallHelpers::Above, T9, scratchGPR);
+    answer(true);
+    isZero.link(&jit);
+    isNaN.link(&jit);
+    answer(false);
+
+    notNumber.link(&jit);
+    Jump isCell = jit.branchIfCell(asked);
+    answer(false); // undefined, null.
+
+    isCell.link(&jit);
+    CCallHelpers::JumpList slow;
+    jit.load8(Address(asked, JSCell::typeInfoTypeOffset()), T9);
+    Jump notObject = jit.branch32(CCallHelpers::Below, T9, TrustedImm32(ObjectType));
+    slow.append(jit.branchTest8(CCallHelpers::NonZero, Address(asked, JSCell::typeInfoFlagsOffset()), TrustedImm32(MasqueradesAsUndefined)));
+    answer(true);
+
+    notObject.link(&jit);
+    slow.append(jit.branch32(CCallHelpers::NotEqual, T9, TrustedImm32(StringType)));
+    jit.loadPtr(Address(asked, JSString::offsetOfValue()), T9);
+    slow.append(jit.branchIfRopeStringImpl(T9));
+    jit.load32(Address(T9, StringImpl::lengthMemoryOffset()), T9);
+    jit.test32(CCallHelpers::NonZero, T9, T9, A0);
+    jit.ret();
+
+    slow.link(&jit);
+    jit.move(asked, T9);
+    s_longWayOfToBoolean = jit.label();
+    callPreservingRegistersAndReturn(jit, Entry::operationAOTToBoolean, true, [&](int32_t) {
+        jit.move(T9, A1);
+        jit.loadPtr(Address(T10, Instance::offsetOfGlobalObject()), A0);
+    });
+}
+
+// ---- Entry from the standard calling convention
+
+// The entry point for callers that use the engine's standard calling convention: the interpreter, C++, or a stub making a generic
+// call. A standard frame is being made and nothing but the return address has been pushed. It becomes the adapter's frame, and
+// the adapter bridges the two conventions for as long as the function runs. word: the function's EntryWord; instance: its
+// Instance. The standard convention's callee preserves rbx and r12, which compiled code and the stubs do not, so the adapter
+// saves them with the pinned registers, and word and instance come in registers that the caller does not expect preserved.
+static void adapt(CCallHelpers& jit, GPRReg word, GPRReg instance)
+{
+    constexpr GPRReg fp = GPRInfo::callFrameRegister;
+    constexpr GPRReg wordWhileCalling = X86Registers::ebx;
+    ASSERT(noOverlap(word, instance, X86Registers::ebx, X86Registers::r12, instanceGPR, T12, T13, scratchGPR));
+    jit.emitFunctionPrologue();
+    static_assert(!(adapterSaveAreaSize % stackAlignmentBytes()));
+    jit.subPtr(TrustedImm32(adapterSaveAreaSize), CCallHelpers::stackPointerRegister);
+    jit.storePtr(instanceGPR, Address(fp, offsetOfInstanceRegisterInAdapter));
+    jit.storePtr(GPRInfo::numberTagRegister, Address(fp, offsetOfNumberTagRegisterInAdapter));
+    jit.storePtr(GPRInfo::notCellMaskRegister, Address(fp, offsetOfNotCellMaskRegisterInAdapter));
+    jit.storePtr(X86Registers::ebx, Address(fp, offsetOfRBXInAdapter));
+    jit.storePtr(X86Registers::r12, Address(fp, offsetOfR12InAdapter));
+    jit.storePtr(instance, Address(fp, offsetOfInstanceInAdapter));
+    jit.move(instance, instanceGPR);
+    jit.move(word, wordWhileCalling);
+    restoreTagRegisters(jit);
+    // Make sure that nothing mistakes it for an interpreter frame.
+    jit.storePtr(CCallHelpers::TrustedImmPtr(nullptr), CCallHelpers::addressFor(CallFrameSlot::codeBlock));
+
+    jit.load64(CCallHelpers::addressFor(CallFrameSlot::callee), calleeGPR);
+    jit.load64(CCallHelpers::addressFor(CallFrameSlot::thisArgument), thisGPR);
+    jit.load32(CCallHelpers::lowWordFor(CallFrameSlot::argumentCountIncludingThis), countGPR);
+    jit.sub32(TrustedImm32(1), countGPR);
+    Jump takesList = jit.branchTest64(CCallHelpers::NonZero, wordWhileCalling, CCallHelpers::TrustedImm64(1LL << EntryWord::bitOfIsList));
+    // The word above the last argument belongs to another frame but is mapped, so it may be loaded as long as it is not used.
+    jit.move(CCallHelpers::TrustedImm64(JSValue::ValueUndefined), scratchGPR);
+    for (unsigned i = 0; i < numberOfArgumentGPRs; ++i) {
+        jit.load64(CCallHelpers::addressFor(virtualRegisterForArgumentIncludingThis(i + 1)), argumentGPR(i));
+        jit.moveConditionally32(CCallHelpers::Above, countGPR, TrustedImm32(i), argumentGPR(i), scratchGPR, argumentGPR(i));
+    }
+    Jump ready = jit.jump();
+    takesList.link(&jit);
+    jit.move(countGPR, argumentGPR(0));
+    jit.addPtr(TrustedImm32(virtualRegisterForArgumentIncludingThis(1).offset() * static_cast<int>(sizeof(Register))), fp, argumentGPR(1));
+    ready.link(&jit);
+    jit.and64(CCallHelpers::TrustedImm64(static_cast<int64_t>(EntryWord::addressMask)), wordWhileCalling);
+    jit.call(wordWhileCalling, JSEntryPtrTag);
+    s_returnsIntoAdapters->append(jit.label());
+
+    jit.loadPtr(Address(fp, offsetOfInstanceRegisterInAdapter), instanceGPR);
+    jit.loadPtr(Address(fp, offsetOfNumberTagRegisterInAdapter), GPRInfo::numberTagRegister);
+    jit.loadPtr(Address(fp, offsetOfNotCellMaskRegisterInAdapter), GPRInfo::notCellMaskRegister);
+    jit.loadPtr(Address(fp, offsetOfRBXInAdapter), X86Registers::ebx);
+    jit.loadPtr(Address(fp, offsetOfR12InAdapter), X86Registers::r12);
+    jit.emitFunctionEpilogue();
+    jit.ret();
+}
+
+// Program or module code, which is entered with a CodeBlock in the frame, like an interpreter frame.
+static void generateEnter(CCallHelpers& jit)
+{
+    jit.loadPtr(slotOfFrameBeingEntered(CallFrameSlot::codeBlock), A0);
+    jit.loadPtr(Address(A0, CodeBlock::offsetOfGlobalObject()), A1);
+    jit.loadPtr(Address(A0, CodeBlock::jitCodeOffset()), A0);
+    jit.loadPtr(Address(A1, JSGlobalObject::offsetOfAOTInstance()), A1);
+    jit.loadPtr(Address(A0, JITCode::offsetOfEntry()), A0);
+    adapt(jit, A0, A1);
+}
+
+// A function, which has no CodeBlock. Its callers leave the frame's CodeBlock slot empty.
+static void generateEnterFunction(CCallHelpers& jit, CodeSpecializationKind kind)
+{
+    jit.loadPtr(slotOfFrameBeingEntered(CallFrameSlot::callee), A0);
+    jit.loadPtr(Address(A0, JSFunction::offsetOfExecutableOrRareData()), A0);
+    Jump hasExecutable = jit.branchTestPtr(CCallHelpers::Zero, A0, TrustedImm32(JSFunction::rareDataTag));
+    jit.loadPtr(Address(A0, FunctionRareData::offsetOfExecutable() - JSFunction::rareDataTag), A0);
+    hasExecutable.link(&jit);
+    jit.loadPtr(Address(A0, ExecutableBase::offsetOfJITCodeFor(kind)), A0);
+    jit.loadPtr(Address(A0, JITCode::offsetOfInstance()), A1);
+    jit.loadPtr(Address(A0, JITCode::offsetOfEntry()), A0);
+    adapt(jit, A0, A1);
+}
+static void generateEnterFunctionForCall(CCallHelpers& jit) { generateEnterFunction(jit, CodeSpecializationKind::CodeForCall); }
+static void generateEnterFunctionForConstruct(CCallHelpers& jit) { generateEnterFunction(jit, CodeSpecializationKind::CodeForConstruct); }
+
+// ---- Calls
+
+static void findTargetAndCall(CCallHelpers&);
+
+// Like the JIT's virtual call thunks. Entered (called, or jumped to for a tail call) with the frame set up except for its CodeBlock;
+// the return address is on the stack. Baseline's callee register = callee, its CallLinkInfo register = that of a VirtualCallInfo,
+// used only on the slow path. Uses only caller-saved registers: it is entered from the standard calling convention.
+template<typename LoadCallLinkInfo>
+static void dispatchCall(CCallHelpers& jit, CodeSpecializationKind kind, const LoadCallLinkInfo& loadCallLinkInfo)
+{
+    constexpr GPRReg callee = BaselineJITRegisters::Call::calleeGPR;
+    constexpr GPRReg executable = X86Registers::ecx;
+    constexpr GPRReg target = X86Registers::edi;
+    static_assert(noOverlap(callee, BaselineJITRegisters::Call::callLinkInfoGPR, executable, target));
+
+    CCallHelpers::JumpList slow;
+    slow.append(jit.branchIfNotCell(callee, DoNotHaveTagRegisters));
+    slow.append(jit.branchIfNotFunction(callee));
+    jit.loadPtr(Address(callee, JSFunction::offsetOfExecutableOrRareData()), executable);
+    Jump hasExecutable = jit.branchTestPtr(CCallHelpers::Zero, executable, TrustedImm32(JSFunction::rareDataTag));
+    jit.loadPtr(Address(executable, FunctionRareData::offsetOfExecutable() - JSFunction::rareDataTag), executable);
+    hasExecutable.link(&jit);
+    // A short-form executable does not store this. See ExecutableBase::wayIntoShortForm().
+    Jump saysHowToGetIn = jit.branchIfNotType(executable, ShortFunctionExecutableType);
+    jit.loadPtr(Address(executable, FunctionExecutable::offsetOfAOTEntryFor(kind)), target);
+    slow.append(jit.branchTestPtr(CCallHelpers::Zero, target));
+    if (kind == CodeSpecializationKind::CodeForConstruct) {
+        jit.load32(Address(executable, FunctionExecutable::offsetOfAOTIndexFor(kind)), executable);
+        Jump doesNotConstructByCalling = jit.branch32(CCallHelpers::NotEqual, executable, TrustedImm32(static_cast<int32_t>(FunctionExecutable::aotIndexOfWhatConstructsByCalling)));
+        jit.farJump(target, JSEntryPtrTag);
+        doesNotConstructByCalling.link(&jit);
+    }
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfRuntimeTable()), target);
+    jit.loadPtr(Address(target, static_cast<unsigned>(isCall(kind) ? Entry::EnterStaticFunctionForCall : Entry::EnterStaticFunctionForConstruct) * sizeof(void*)), target);
+    jit.farJump(target, JSEntryPtrTag);
+    saysHowToGetIn.link(&jit);
+    jit.loadPtr(Address(executable, ExecutableBase::offsetOfJITCodeWithArityCheckFor(kind)), target);
+    slow.append(jit.branchTestPtr(CCallHelpers::Zero, target));
+    Jump isNative = jit.branchIfNotType(executable, FunctionExecutableType);
+    jit.loadPtr(Address(executable, FunctionExecutable::offsetOfCodeBlockFor(kind)), executable);
+    jit.storePtr(executable, slotOfFrameBeingEntered(CallFrameSlot::codeBlock));
+    isNative.link(&jit);
+    jit.farJump(target, JSEntryPtrTag);
+
+    // Everything else is resolved by llint_virtual_call(), in the callee's frame.
+    slow.link(&jit);
+    loadCallLinkInfo();
+    findTargetAndCall(jit);
+}
+
+// In the frame being entered, with the return address on the stack. Callee-saved registers are left alone: if the operation
+// throws, unwind() copies them where the handler finds them.
+static void findTargetAndCall(CCallHelpers& jit)
+{
+    constexpr GPRReg info = BaselineJITRegisters::Call::callLinkInfoGPR;
+    constexpr GPRReg kept = X86Registers::r10;
+    jit.emitFunctionPrologue();
+    // As in emitCallSlowPath(): the operation's frame reuses the space of the previous callee at this depth.
+    for (size_t offset = sizeof(Register); offset <= stackBytesClearedForCallSlowPath; offset += sizeof(Register))
+        jit.storePtr(CCallHelpers::TrustedImmPtr(nullptr), Address(CCallHelpers::stackPointerRegister, -static_cast<int>(offset)));
+    jit.subPtr(TrustedImm32(16), CCallHelpers::stackPointerRegister);
+    jit.storePtr(info, Address(CCallHelpers::stackPointerRegister));
+    jit.move(GPRInfo::callFrameRegister, A0);
+    jit.move(info, A1);
+    jit.loadPtr(Address(info, VirtualCallInfo::offsetOfFindTarget()), kept);
+    jit.call(kept, OperationPtrTag);
+    jit.loadPtr(Address(CCallHelpers::stackPointerRegister), kept);
+    jit.addPtr(TrustedImm32(16), CCallHelpers::stackPointerRegister);
+    jit.emitFunctionEpilogue();
+    // Returns the call target. A null target, returned together with the VM, means an exception was thrown.
+    Jump threw = jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR2);
+    jit.farJump(GPRInfo::returnValueGPR, JSEntryPtrTag);
+
+    threw.link(&jit);
+    jit.move(GPRInfo::returnValueGPR2, X86Registers::ecx);
+    jit.loadPtr(Address(kept, VirtualCallInfo::offsetOfLookupExceptionHandler()), kept);
+    unwind(jit, X86Registers::ecx, kept);
+}
+
+// The frame being entered: its callee, and that callee's VM.
+static void loadCalleeOfFrameBeingEnteredAndItsVM(CCallHelpers& jit, GPRReg callee, GPRReg vm)
+{
+    jit.loadPtr(slotOfFrameBeingEntered(CallFrameSlot::callee), callee);
+    jit.move(callee, vm);
+    Jump isPreciseAllocation = jit.branchTestPtr(CCallHelpers::NonZero, vm, TrustedImm32(PreciseAllocation::halfAlignment));
+    jit.andPtr(CCallHelpers::TrustedImmPtr(MarkedBlock::blockMask), vm);
+    jit.loadPtr(Address(vm, MarkedBlock::offsetOfHeader + MarkedBlock::Header::offsetOfVM()), vm);
+    Jump haveVM = jit.jump();
+    isPreciseAllocation.link(&jit);
+    jit.loadPtr(Address(vm, PreciseAllocation::offsetOfWeakSet() + WeakSet::offsetOfVM() - PreciseAllocation::headerSize()), vm);
+    haveVM.link(&jit);
+}
+
+// The entry point that a static FunctionExecutable advertises to callers using the standard calling convention. Only caller-saved
+// registers until adapt() has saved the rest.
+static void generateEnterStaticFunction(CCallHelpers& jit, CodeSpecializationKind kind, Entry callLinkInfo)
+{
+    constexpr GPRReg word = A0;
+    constexpr GPRReg instance = A1;
+    constexpr GPRReg index = A2;
+    constexpr GPRReg state = A3;
+    loadCalleeOfFrameBeingEnteredAndItsVM(jit, word, instance);
+    jit.loadPtr(Address(instance, VM::offsetOfAOTInstanceOfProgram()), instance);
+
+    jit.loadPtr(Address(word, JSFunction::offsetOfExecutableOrRareData()), word);
+    Jump hasExecutable = jit.branchTestPtr(CCallHelpers::Zero, word, TrustedImm32(JSFunction::rareDataTag));
+    jit.loadPtr(Address(word, FunctionRareData::offsetOfExecutable() - JSFunction::rareDataTag), word);
+    hasExecutable.link(&jit);
+    jit.load32(Address(word, FunctionExecutable::offsetOfAOTIndexFor(kind)), index);
+    jit.loadPtr(Address(word, FunctionExecutable::offsetOfAOTEntryFor(kind)), word);
+    jit.addPtr(TrustedImm32(Instance::offsetOfStates()), instance, state);
+    jit.load32(CCallHelpers::BaseIndex(state, index, CCallHelpers::TimesFour), state);
+    Jump hasNothingYet = jit.branch32(CCallHelpers::Below, state, TrustedImm32(Instance::isLinkedWithoutData));
+    adapt(jit, word, instance);
+
+    hasNothingYet.link(&jit);
+    jit.loadPtr(Address(instance, Instance::offsetOfRuntimeTable()), word);
+    jit.loadPtr(Address(word, static_cast<unsigned>(callLinkInfo) * sizeof(void*)), BaselineJITRegisters::Call::callLinkInfoGPR);
+    findTargetAndCall(jit);
+}
+static void generateEnterStaticFunctionForCall(CCallHelpers& jit) { generateEnterStaticFunction(jit, CodeSpecializationKind::CodeForCall, Entry::CallLinkInfoForCall); }
+static void generateEnterStaticFunctionForConstruct(CCallHelpers& jit) { generateEnterStaticFunction(jit, CodeSpecializationKind::CodeForConstruct, Entry::CallLinkInfoForConstruct); }
+
+// The construct entry point of a static FunctionExecutable whose function was only compiled for call. To stack walkers the frame
+// looks like a native function's.
+static void generateConstructByCalling(CCallHelpers& jit)
+{
+    constexpr GPRReg table = X86Registers::r10;
+    loadCalleeOfFrameBeingEnteredAndItsVM(jit, A0, A1);
+    jit.loadPtr(Address(A1, VM::offsetOfAOTRuntimeTable()), table);
+    jit.emitFunctionPrologue();
+    jit.storePtr(CCallHelpers::TrustedImmPtr(nullptr), CCallHelpers::addressFor(CallFrameSlot::codeBlock));
+    jit.subPtr(TrustedImm32(16), CCallHelpers::stackPointerRegister);
+    jit.storePtr(table, Address(CCallHelpers::stackPointerRegister));
+    jit.move(GPRInfo::callFrameRegister, A0);
+    jit.loadPtr(Address(table, static_cast<unsigned>(Entry::operationAOTConstructByCalling) * sizeof(void*)), table);
+    jit.call(table, OperationPtrTag);
+    jit.loadPtr(Address(CCallHelpers::stackPointerRegister), table);
+    jit.addPtr(TrustedImm32(16), CCallHelpers::stackPointerRegister);
+    // Returns the constructed object. A null result, returned together with the VM, means an exception was thrown.
+    Jump threw = jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR2);
+    jit.emitFunctionEpilogue();
+    jit.ret();
+
+    threw.link(&jit);
+    jit.move(GPRInfo::returnValueGPR2, X86Registers::ecx);
+    jit.loadPtr(Address(table, static_cast<unsigned>(Entry::LookupExceptionHandler) * sizeof(void*)), table);
+    unwind(jit, X86Registers::ecx, table);
+}
+
+// The call entry point of the NativeExecutable for bound functions whose target is a function, for use without a JIT. Equivalent to
+// boundFunctionCallGenerator() (ThunkGenerators.cpp), but position-independent. To stack walkers the frame looks like a native
+// function's. If there is no stack space for the target's frame, or the target has no code yet, it falls back to the executable's
+// native function. Entered with the standard convention, whose callee preserves rbx and r12 (ARM64's vm and limit registers, T10 and
+// T11, are those here): only caller-saved registers.
+static void generateCallBoundFunction(CCallHelpers& jit)
+{
+    constexpr GPRReg bound = GPRInfo::regT0; // rax
+    constexpr GPRReg total = GPRInfo::regT1; // rsi
+    constexpr GPRReg scratch = GPRInfo::regT2; // rdx
+    constexpr GPRReg passed = GPRInfo::regT3; // rcx
+    constexpr GPRReg value = GPRInfo::regT4; // r8
+    constexpr GPRReg vm = X86Registers::r10;
+    constexpr GPRReg limit = X86Registers::edi;
+    static_assert(noOverlap(bound, total, scratch, passed, value, vm, limit, scratchGPR));
+    CCallHelpers::JumpList slowCase;
+
+    loadCalleeOfFrameBeingEnteredAndItsVM(jit, bound, vm);
+    jit.emitFunctionPrologue();
+    jit.storePtr(CCallHelpers::TrustedImmPtr(nullptr), CCallHelpers::addressFor(CallFrameSlot::codeBlock));
+    jit.store32(TrustedImm32(0), CCallHelpers::highWordFor(CallFrameSlot::argumentCountIncludingThis));
+
+    // The frame pointer is 16-byte aligned (entered with rsp = 8 mod 16, then rbp pushed), and so is the frame below it.
+    static_assert(!(sizeof(CallerFrameAndPC) % stackAlignmentBytes()));
+    jit.load32(Address(bound, JSBoundFunction::offsetOfBoundArgsLength()), scratch);
+    jit.load32(CCallHelpers::lowWordFor(CallFrameSlot::argumentCountIncludingThis), total);
+    jit.move(total, passed);
+    jit.add32(scratch, total);
+    jit.add32(TrustedImm32(CallFrame::headerSizeInRegisters - CallerFrameAndPC::sizeInRegisters), total, scratch);
+    jit.lshift32(TrustedImm32(3), scratch);
+    jit.add32(TrustedImm32(stackAlignmentBytes() - 1), scratch);
+    jit.and32(TrustedImm32(-stackAlignmentBytes()), scratch);
+    jit.negPtr(scratch);
+    jit.addPtr(CCallHelpers::stackPointerRegister, scratch);
+    jit.loadPtr(Address(vm, VM::offsetOfSoftStackLimit()), limit);
+    slowCase.append(jit.branchPtr(CCallHelpers::Above, limit, scratch));
+    jit.move(scratch, CCallHelpers::stackPointerRegister);
+
+    jit.store32(total, CCallHelpers::calleeFrameLowWordSlot(CallFrameSlot::argumentCountIncludingThis));
+    jit.loadValue(Address(bound, JSBoundFunction::offsetOfBoundThis()), value);
+    jit.storeValue(value, CCallHelpers::calleeArgumentSlot(0));
+
+    // The call's own arguments come after the bound ones.
+    jit.sub32(TrustedImm32(1), passed);
+    jit.sub32(TrustedImm32(1), total);
+    Jump nonePassed = jit.branchTest32(CCallHelpers::Zero, passed);
+    CCallHelpers::Label nextPassed = jit.label();
+    jit.sub32(TrustedImm32(1), passed);
+    jit.sub32(TrustedImm32(1), total);
+    jit.loadValue(CCallHelpers::addressFor(virtualRegisterForArgumentIncludingThis(1)).indexedBy(passed, CCallHelpers::TimesEight), value);
+    jit.storeValue(value, CCallHelpers::calleeArgumentSlot(1).indexedBy(total, CCallHelpers::TimesEight));
+    jit.branchTest32(CCallHelpers::NonZero, passed).linkTo(nextPassed, &jit);
+    nonePassed.link(&jit);
+
+    CCallHelpers::JumpList haveArguments;
+    haveArguments.append(jit.branchTest32(CCallHelpers::Zero, total));
+    Jump areInFunction = jit.branch32(CCallHelpers::BelowOrEqual, total, TrustedImm32(JSBoundFunction::maxEmbeddedArgs));
+    {
+        jit.loadPtr(Address(bound, JSBoundFunction::offsetOfBoundArgs()), passed);
+        CCallHelpers::Label next = jit.label();
+        jit.sub32(TrustedImm32(1), total);
+        jit.loadValue(CCallHelpers::BaseIndex(passed, total, CCallHelpers::TimesEight, JSCellButterfly::offsetOfData()), value);
+        jit.storeValue(value, CCallHelpers::calleeArgumentSlot(1).indexedBy(total, CCallHelpers::TimesEight));
+        jit.branchTest32(CCallHelpers::NonZero, total).linkTo(next, &jit);
+        haveArguments.append(jit.jump());
+    }
+    areInFunction.link(&jit);
+    {
+        CCallHelpers::Label next = jit.label();
+        jit.sub32(TrustedImm32(1), total);
+        jit.loadValue(CCallHelpers::BaseIndex(bound, total, CCallHelpers::TimesEight, JSBoundFunction::offsetOfBoundArgs()), value);
+        jit.storeValue(value, CCallHelpers::calleeArgumentSlot(1).indexedBy(total, CCallHelpers::TimesEight));
+        jit.branchTest32(CCallHelpers::NonZero, total).linkTo(next, &jit);
+    }
+    haveArguments.link(&jit);
+
+    jit.loadPtr(Address(bound, JSBoundFunction::offsetOfTargetFunction()), scratch);
+    jit.storeValue(scratch, CCallHelpers::calleeFrameSlot(CallFrameSlot::callee));
+    jit.loadPtr(Address(scratch, JSFunction::offsetOfExecutableOrRareData()), total);
+    Jump hasExecutable = jit.branchTestPtr(CCallHelpers::Zero, total, TrustedImm32(JSFunction::rareDataTag));
+    jit.loadPtr(Address(total, FunctionRareData::offsetOfExecutable() - JSFunction::rareDataTag), total);
+    hasExecutable.link(&jit);
+    // A short-form executable does not store this. See ExecutableBase::wayIntoShortForm().
+    Jump saysHowToGetIn = jit.branchIfNotType(total, ShortFunctionExecutableType);
+    jit.loadPtr(Address(total, FunctionExecutable::offsetOfAOTEntryFor(CodeSpecializationKind::CodeForCall)), scratch);
+    slowCase.append(jit.branchTestPtr(CCallHelpers::Zero, scratch));
+    jit.loadPtr(Address(vm, VM::offsetOfAOTRuntimeTable()), scratch);
+    jit.loadPtr(Address(scratch, static_cast<unsigned>(Entry::EnterStaticFunctionForCall) * sizeof(void*)), scratch);
+    Jump knowsHowToGetIn = jit.jump();
+    saysHowToGetIn.link(&jit);
+    jit.loadPtr(Address(total, ExecutableBase::offsetOfJITCodeWithArityCheckFor(CodeSpecializationKind::CodeForCall)), scratch);
+    slowCase.append(jit.branchTestPtr(CCallHelpers::Zero, scratch));
+    Jump isNative = jit.branchIfNotType(total, FunctionExecutableType);
+    jit.loadPtr(Address(total, FunctionExecutable::offsetOfCodeBlockForCall()), passed);
+    jit.storePtr(passed, CCallHelpers::calleeFrameCodeBlockBeforeCall());
+    isNative.link(&jit);
+    knowsHowToGetIn.link(&jit);
+    // The standard convention: the result comes back in rax, which is where this function's caller looks for it.
+    jit.call(scratch, JSEntryPtrTag);
+    jit.emitFunctionEpilogue();
+    jit.ret();
+
+    // The frame is as it was on entry, nothing but the return address pushed: the native function takes over from here.
+    slowCase.link(&jit);
+    jit.emitFunctionEpilogue();
+    jit.loadPtr(Address(vm, VM::offsetOfAOTRuntimeTable()), vm);
+    jit.loadPtr(Address(vm, static_cast<unsigned>(Entry::NativeCallTrampoline) * sizeof(void*)), vm);
+    jit.farJump(vm, JSEntryPtrTag);
+}
+
+// Called by a function that finds it has not been linked to the realm yet. Preserves every register.
+static void generateLinkFunction(CCallHelpers& jit)
+{
+    callPreservingRegistersAndReturn(jit, Entry::operationAOTLinkFunction, false, [&](int32_t offsetOfReturnAddress) {
+        jit.move(T10, A0);
+        jit.loadPtr(Address(CCallHelpers::stackPointerRegister, offsetOfReturnAddress), A1);
+    });
+}
+
+static void generateVirtualCall(CCallHelpers& jit) { dispatchCall(jit, CodeSpecializationKind::CodeForCall, [] { }); }
+static void generateVirtualConstruct(CCallHelpers& jit) { dispatchCall(jit, CodeSpecializationKind::CodeForConstruct, [] { }); }
+static void generateVirtualTailCall(CCallHelpers& jit) { dispatchCall(jit, CodeSpecializationKind::CodeForCall, [] { }); }
+
+// calleeGPR = the callee. If it is a function with AOT code that has already been linked in this realm, leaves its EntryWord in
+// T12. Clobbers T11 and T13. T12 and T13 are the tag registers: whoever continues restores them.
+static void findCodeOfCallee(CCallHelpers& jit, CodeSpecializationKind kind, CCallHelpers::JumpList& otherwise)
+{
+    otherwise.append(jit.branchIfNotCell(calleeGPR));
+    otherwise.append(jit.branchIfNotType(calleeGPR, JSFunctionType));
+    jit.loadPtr(Address(calleeGPR, JSFunction::offsetOfExecutableOrRareData()), T11);
+    Jump hasExecutable = jit.branchTestPtr(CCallHelpers::Zero, T11, TrustedImm32(JSFunction::rareDataTag));
+    jit.loadPtr(Address(T11, FunctionRareData::offsetOfExecutable() - JSFunction::rareDataTag), T11);
+    hasExecutable.link(&jit);
+    otherwise.append(jit.branchIfNotType(T11, JSTypeRange { FunctionExecutableType, ShortFunctionExecutableType }));
+    jit.load64(Address(T11, FunctionExecutable::offsetOfAOTEntryFor(kind)), T12);
+    Jump isNotStatic = jit.branchTest64(CCallHelpers::Zero, T12);
+    jit.load32(Address(T11, FunctionExecutable::offsetOfAOTIndexFor(kind)), T13);
+    if (kind == CodeSpecializationKind::CodeForConstruct)
+        otherwise.append(jit.branch32(CCallHelpers::Equal, T13, TrustedImm32(static_cast<int32_t>(FunctionExecutable::aotIndexOfWhatConstructsByCalling))));
+    jit.addPtr(TrustedImm32(Instance::offsetOfStates()), instanceGPR, T11);
+    jit.load32(CCallHelpers::BaseIndex(T11, T13, CCallHelpers::TimesFour), T11);
+    otherwise.append(jit.branch32(CCallHelpers::Below, T11, TrustedImm32(Instance::isLinkedWithoutData)));
+    Jump isLinked = jit.jump();
+
+    isNotStatic.link(&jit);
+    otherwise.append(jit.branchIfNotType(T11, FunctionExecutableType));
+    jit.loadPtr(Address(T11, ExecutableBase::offsetOfJITCodeFor(kind)), T11);
+    otherwise.append(jit.branchTestPtr(CCallHelpers::Zero, T11));
+    otherwise.append(jit.branch8(CCallHelpers::NotEqual, Address(T11, JSC::JITCode::offsetOfJITType()), TrustedImm32(static_cast<int32_t>(JITType::AOTJIT))));
+    otherwise.append(jit.branchPtr(CCallHelpers::NotEqual, Address(T11, JITCode::offsetOfInstance()), instanceGPR));
+    jit.load64(Address(T11, JITCode::offsetOfEntry()), T12);
+    isLinked.link(&jit);
+}
+
+// Runs in the stub's own frame, with a standard frame set up below it except for its CodeBlock. Calls calleeGPR using the standard
+// calling convention and returns its result to the stub's caller.
+static void callTheWayTheEngineDoes(CCallHelpers& jit, CodeSpecializationKind kind)
+{
+    jit.move(calleeGPR, BaselineJITRegisters::Call::calleeGPR);
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfRuntimeTable()), T11);
+    jit.loadPtr(Address(T11, static_cast<unsigned>(kind == CodeSpecializationKind::CodeForCall ? Entry::CallLinkInfoForCall : Entry::CallLinkInfoForConstruct) * sizeof(void*)), BaselineJITRegisters::Call::callLinkInfoGPR);
+    callStubFromStub(jit, kind == CodeSpecializationKind::CodeForCall ? Stub::VirtualCall : Stub::VirtualConstruct);
+    jit.emitFunctionEpilogue();
+    jit.ret();
+}
+
+static CCallHelpers::Label s_startOfCallOfAnyCount;
+
+// Function.prototype.call.bind(f): calls f with the first argument as `this` and the rest as arguments. The tags are valid here.
+static void callWhatCallIsBoundTo(CCallHelpers& jit)
+{
+    CCallHelpers::JumpList isNot;
+    isNot.append(jit.branchIfNotCell(calleeGPR));
+    jit.load32(Address(calleeGPR, JSCell::structureIDOffset()), T11);
+    isNot.append(jit.branch32(CCallHelpers::NotEqual, T11, Address(instanceGPR, Instance::offsetOfStructureIDOfBoundFunctions())));
+    jit.loadPtr(Address(calleeGPR, JSBoundFunction::offsetOfTargetFunction()), T11);
+    isNot.append(jit.branchPtr(CCallHelpers::NotEqual, T11, Address(instanceGPR, Instance::offsetOfFunctionPrototypeCall())));
+    isNot.append(jit.branchTest32(CCallHelpers::NonZero, Address(calleeGPR, JSBoundFunction::offsetOfBoundArgsLength())));
+    jit.load64(Address(calleeGPR, JSBoundFunction::offsetOfBoundThis()), T11);
+    isNot.append(jit.branchIfNotCell(T11));
+    isNot.append(jit.branchIfNotType(T11, JSFunctionType));
+    jit.move(T11, calleeGPR);
+    Jump nothingIsPassed = jit.branchTest32(CCallHelpers::Zero, countGPR);
+    jit.move(argumentGPR(0), thisGPR);
+    for (unsigned i = 0; i + 1 < numberOfArgumentGPRs; ++i)
+        jit.move(argumentGPR(i + 1), argumentGPR(i));
+    jit.sub32(TrustedImm32(1), countGPR);
+    jit.jump().linkTo(s_startOfCallOfAnyCount, &jit);
+    nothingIsPassed.link(&jit);
+    jit.move(CCallHelpers::TrustedImm64(JSValue::ValueUndefined), thisGPR);
+    jit.jump().linkTo(s_startOfCallOfAnyCount, &jit);
+    isNot.link(&jit);
+}
+
+// See Stub::Call. count: the value of countGPR, if known statically (thunks, which x86-64 does not have yet).
+static void generateCallTo(CCallHelpers& jit, CodeSpecializationKind kind, std::optional<unsigned> count)
+{
+    if (kind == CodeSpecializationKind::CodeForCall && !count)
+        s_startOfCallOfAnyCount = jit.label();
+    CCallHelpers::JumpList slowCase;
+    findCodeOfCallee(jit, kind, slowCase);
+    Jump takesList = jit.branchTest64(CCallHelpers::NonZero, T12, CCallHelpers::TrustedImm64(1LL << EntryWord::bitOfIsList));
+    jit.urshift64(T12, TrustedImm32(EntryWord::shiftOfNumberOfParameters), T13);
+    jit.and64(CCallHelpers::TrustedImm64(static_cast<int64_t>(EntryWord::addressMask)), T12);
+    Jump enough = count ? jit.branch32(CCallHelpers::BelowOrEqual, T13, TrustedImm32(*count)) : jit.branch32(CCallHelpers::BelowOrEqual, T13, countGPR);
+    // Passing more arguments than the function has parameters is harmless.
+    jit.move(CCallHelpers::TrustedImm64(JSValue::ValueUndefined), T13);
+    for (unsigned i = count.value_or(0); i < numberOfArgumentGPRs; ++i) {
+        if (count)
+            jit.move(T13, argumentGPR(i));
+        else
+            jit.moveConditionally32(CCallHelpers::Above, countGPR, TrustedImm32(i), argumentGPR(i), T13, argumentGPR(i));
+    }
+    enough.link(&jit);
+    jit.move(T12, scratchGPR);
+    restoreTagRegisters(jit);
+    jit.farJump(scratchGPR, JSEntryPtrTag);
+
+    // Store the arguments where the standard calling convention, and a Signature::List function, expect them.
+    auto spill = [&] {
+        unsigned registers = count.value_or(numberOfArgumentGPRs);
+        jit.emitFunctionPrologue();
+        jit.subPtr(TrustedImm32(WTF::roundUpToMultipleOf<stackAlignmentBytes()>((CallFrame::headerSizeInRegisters - CallerFrameAndPC::sizeInRegisters + 1 + registers) * sizeof(Register))), CCallHelpers::stackPointerRegister);
+        jit.store64(calleeGPR, slotOfFrameOfNextCall(CallFrameSlot::callee));
+        jit.add32(TrustedImm32(1), countGPR, T11);
+        jit.store64(T11, slotOfFrameOfNextCall(CallFrameSlot::argumentCountIncludingThis));
+        jit.store64(thisGPR, slotOfFrameOfNextCall(CallFrameSlot::thisArgument));
+        for (unsigned i = 0; i < registers; ++i)
+            jit.store64(argumentGPR(i), slotOfFrameOfNextCall(CallFrameSlot::thisArgument, (i + 1) * sizeof(Register)));
+    };
+    takesList.link(&jit);
+    spill();
+    jit.move(countGPR, argumentGPR(0));
+    jit.addPtr(TrustedImm32(slotOfFrameOfNextCall(CallFrameSlot::thisArgument, sizeof(Register)).offset), CCallHelpers::stackPointerRegister, argumentGPR(1));
+    jit.and64(CCallHelpers::TrustedImm64(static_cast<int64_t>(EntryWord::addressMask)), T12);
+    jit.move(T12, scratchGPR);
+    restoreTagRegisters(jit);
+    jit.call(scratchGPR, JSEntryPtrTag);
+    jit.emitFunctionEpilogue();
+    jit.ret();
+
+    slowCase.link(&jit);
+    restoreTagRegisters(jit);
+    if (kind == CodeSpecializationKind::CodeForCall)
+        callWhatCallIsBoundTo(jit);
+    spill();
+    callTheWayTheEngineDoes(jit, kind);
+}
+static void generateCall(CCallHelpers& jit) { generateCallTo(jit, CodeSpecializationKind::CodeForCall, std::nullopt); }
+static void generateConstruct(CCallHelpers& jit) { generateCallTo(jit, CodeSpecializationKind::CodeForConstruct, std::nullopt); }
+
+// ---- Caches
+
+static Address slotWord(GPRReg slot, unsigned word) { return Address(slot, word * sizeof(void*)); }
+
+// Loads into `index` the index of the image function that contains `pc`. ARM64 uses fixed registers (indexOfFunctionGPR); here
+// they are the caller's choice. Clobbers `offset` and the scratch register.
+static void loadIndexOfFunctionAt(CCallHelpers& jit, GPRReg pc, GPRReg index, GPRReg offset)
+{
+    ASSERT(noOverlap(pc, index, offset, scratchGPR));
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfCode()), offset);
+    jit.negPtr(offset);
+    jit.addPtr(pc, offset);
+    jit.move(offset, index);
+    jit.urshiftPtr(TrustedImm32(shiftOfGranuleOfCode), index);
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfGranulesOfCode()), scratchGPR);
+    jit.load32(CCallHelpers::BaseIndex(scratchGPR, index, CCallHelpers::TimesFour), index);
+    // That is the last function that starts at or before the granule. It may end before `pc`.
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfStartsOfFunctionsAfterFirst()), scratchGPR);
+    jit.getEffectiveAddress(CCallHelpers::BaseIndex(scratchGPR, index, CCallHelpers::TimesFour), scratchGPR);
+    CCallHelpers::Label next = jit.label();
+    Jump found = jit.branch32(CCallHelpers::Above, Address(scratchGPR), offset);
+    jit.add32(TrustedImm32(1), index);
+    jit.addPtr(TrustedImm32(sizeof(uint32_t)), scratchGPR);
+    jit.jump().linkTo(next, &jit);
+    found.link(&jit);
+}
+
+// Loads the FunctionInfo of the function whose index is in `index`, given its Instance.
+static void loadInfo(CCallHelpers& jit, GPRReg instance, GPRReg index, GPRReg result)
+{
+    ASSERT(noOverlap(result, instance, index, scratchGPR));
+    static_assert(sizeof(FunctionInfo) == 32);
+    jit.move(index, result);
+    jit.lshiftPtr(TrustedImm32(5), result);
+    jit.loadPtr(Address(instance, Instance::offsetOfInfos()), scratchGPR);
+    jit.addPtr(scratchGPR, result);
+}
+
+// Loads the Data that contains the slot: the function's own Data or, if it had none when it was called, SharedData. Leaves the
+// Instance in `instance`.
+static void loadInstanceAndDataOfSlot(CCallHelpers& jit, GPRReg slot, GPRReg instance, GPRReg data, GPRReg index)
+{
+    ASSERT(noOverlap(slot, instance, data, index, scratchGPR));
+    loadInstance(jit, instance);
+    jit.loadPtr(Address(instance, Instance::offsetOfSharedData()), data);
+    jit.move(slot, scratchGPR);
+    jit.subPtr(data, scratchGPR);
+    static_assert(SharedData::size < std::numeric_limits<int32_t>::max());
+    Jump isShared = jit.branch64(CCallHelpers::Below, scratchGPR, TrustedImm32(SharedData::size));
+    jit.move(index, data);
+    jit.lshiftPtr(TrustedImm32(2), data);
+    jit.addPtr(instance, data);
+    jit.load32(Address(data, Instance::offsetOfStates()), data);
+    jit.lshiftPtr(TrustedImm32(Instance::shiftOfStateWithData), data);
+    jit.addPtr(instance, data);
+    isShared.link(&jit);
+}
+
+// data: the Data. slot: the address of one of its slots. Leaves the slot's index in `result`.
+static void siteOfSlot(CCallHelpers& jit, GPRReg data, GPRReg slot, GPRReg result)
+{
+    static_assert(sizeof(Slot) == 16);
+    jit.move(slot, result);
+    jit.subPtr(data, result);
+    jit.subPtr(TrustedImm32(Data::offsetOfSlots()), result);
+    jit.urshiftPtr(TrustedImm32(4), result);
+}
+
+// Cache miss. The operands are in A0..., followed by the site. Calls
+//     operation(globalObject, operands..., identifier, Slot*, extra)
+// This part places the arguments and leaves the operation's address in T9. With three operands that is seven arguments, one more
+// than x86-64 passes in registers: the last is left in T10, for the caller to put on the stack. returnAddress: where the stub's
+// return address is, which says which function missed. With one or two operands only caller-saved registers are written: the stubs
+// that miss this way are light (stubPreservesCalleeSaves()). The free argument registers do double duty, in the order things die.
+static void prepareMissAtSite(CCallHelpers& jit, Entry operation, unsigned numberOfOperands, Address returnAddress)
+{
+    RELEASE_ASSERT(numberOfOperands >= 1 && numberOfOperands <= 3);
+    constexpr GPRReg arguments[] = { A0, A1, A2, A3, A4, A5 };
+    constexpr GPRReg index = X86Registers::eax; // thisGPR, which a miss has nothing to do with. Then the site, while the operands shuffle.
+    constexpr GPRReg instance = T9;
+    GPRReg site = arguments[numberOfOperands];
+    // Free until the arguments are shuffled into them.
+    GPRReg free1 = arguments[numberOfOperands + 1];
+    GPRReg free2 = arguments[numberOfOperands + 2];
+    GPRReg data = free2; // Once the return address has been looked up.
+    GPRReg info = free2; // Once the Data has given the site's index.
+
+    jit.loadPtr(returnAddress, free2);
+    loadIndexOfFunctionAt(jit, free2, index, free1);
+    loadInstanceAndDataOfSlot(jit, site, instance, data, index);
+    siteOfSlot(jit, data, site, free1);
+    loadInfo(jit, instance, index, info);
+    jit.loadPtr(Address(info, FunctionInfo::offsetOfSites()), info);
+    static_assert(sizeof(Site) == 4);
+    jit.load32(CCallHelpers::BaseIndex(info, free1, CCallHelpers::TimesFour), free2); // (Into its own base.)
+    jit.move(site, index);
+
+    for (unsigned i = numberOfOperands; i--;)
+        jit.move(arguments[i], arguments[i + 1]);
+    GPRReg identifier = arguments[numberOfOperands + 1]; // free1
+    GPRReg slot = arguments[numberOfOperands + 2]; // free2, which holds the site's word until the end
+    GPRReg extra = numberOfOperands == 3 ? T10 : arguments[numberOfOperands + 3];
+    jit.and32(TrustedImm32((1u << Site::identifierBits) - 1), free2, identifier);
+    jit.urshift32(free2, TrustedImm32(Site::identifierBits), extra);
+    jit.move(index, slot);
+    jit.loadPtr(Address(instance, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(instance, Instance::offsetOfRuntimeTable()), T9);
+    jit.loadPtr(Address(T9, static_cast<unsigned>(operation) * sizeof(void*)), T9);
+}
+
+// As callAndCheckException(), with a seventh argument on the stack.
+static void callWithSeventhArgumentAndCheckException(CCallHelpers& jit, GPRReg function, GPRReg seventh, Returns returns)
+{
+    jit.emitFunctionPrologue();
+    jit.subPtr(TrustedImm32(16), CCallHelpers::stackPointerRegister);
+    jit.storePtr(seventh, Address(CCallHelpers::stackPointerRegister));
+    jit.call(function, OperationPtrTag);
+    jit.emitFunctionEpilogue();
+    Jump exception = returns == Returns::Value ? jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR2) : jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR);
+    RELEASE_ASSERT(returns != Returns::Double);
+    jit.move(GPRInfo::returnValueGPR, stubResultGPR);
+    jit.ret();
+    exception.link(&jit);
+    loadInstance(jit, T9);
+    jumpToEntry(jit, T9, Entry::HandleException);
+}
+
+// For a stub that has pushed nothing: its return address is on top of the stack.
+static void missAtSite(CCallHelpers& jit, Entry operation, unsigned numberOfOperands, Returns returns)
+{
+    prepareMissAtSite(jit, operation, numberOfOperands, Address(CCallHelpers::stackPointerRegister));
+    if (numberOfOperands == 3)
+        callWithSeventhArgumentAndCheckException(jit, T9, T10, returns);
+    else
+        callAndCheckException(jit, T9, returns);
+}
+
+// ---- Scopes
+
+// word = the `offset` word of an op_resolve_scope's slot. A0 = the scope to start from. If the slot caches a depth, leaves the scope
+// at that depth in A0. Otherwise takes the returned jump. Clobbers word.
+static Jump walkOutIfResolvedByDepth(CCallHelpers& jit, GPRReg word)
+{
+    Jump miss = jit.branchTest32(CCallHelpers::Zero, word, TrustedImm32(Slot::resolvesByDepth));
+    jit.and32(TrustedImm32(~Slot::resolvesByDepth), word);
+    Jump there = jit.branchTest32(CCallHelpers::Zero, word);
+    auto loop = jit.label();
+    jit.loadPtr(Address(A0, JSScope::offsetOfNext()), A0);
+    jit.branchSub32(CCallHelpers::NonZero, TrustedImm32(1), word).linkTo(loop, &jit);
+    there.link(&jit);
+    return miss;
+}
+
+// A0 = scope, A1 = site. Result in A0. Light (stubPreservesCalleeSaves()): ARM64's T11 and T12 are A2 and A3 here.
+static void generateResolveScope(CCallHelpers& jit)
+{
+    constexpr GPRReg word = A2;
+    constexpr GPRReg epoch = A3;
+    loadInstance(jit, T9);
+    jit.load32(slotWord(A1, 0).withOffset(sizeof(uint32_t)), word);
+    jit.loadPtr(Address(T9, Instance::offsetOfGlobalObject()), epoch);
+    jit.load32(Address(epoch, JSGlobalObject::offsetOfGlobalLexicalBindingEpoch()), epoch);
+    jit.add32(TrustedImm32(1), epoch);
+    Jump notThatOne = jit.branch32(CCallHelpers::NotEqual, word, epoch);
+    jit.loadPtr(slotWord(A1, 1), A0);
+    jit.ret();
+
+    notThatOne.link(&jit);
+    Jump miss = walkOutIfResolvedByDepth(jit, word);
+    jit.ret();
+
+    miss.link(&jit);
+    missAtSite(jit, Entry::operationAOTResolveScope, 1, Returns::Value);
+}
+
+// See operationAOTGetFromScope(). A0 = the scope. The slot occupies words firstWord and firstWord + 1 at A1. On a hit, returns
+// from the stub with the value. Temporaries: A2-A4 (ARM64: T11-T13).
+static void getFromScopeIfCached(CCallHelpers& jit, unsigned firstWord, CCallHelpers::JumpList& miss)
+{
+    constexpr GPRReg word = A2;
+    constexpr GPRReg t1 = A3;
+    constexpr GPRReg t2 = A4;
+    jit.load64(slotWord(A1, firstWord), word);
+    jit.load32(Address(A0, JSCell::structureIDOffset()), t1);
+    miss.append(jit.branch32(CCallHelpers::NotEqual, word, t1));
+    jit.loadPtr(slotWord(A1, firstWord + 1), t1);
+    Jump noAddress = jit.branchTestPtr(CCallHelpers::Zero, t1);
+    static_assert(Slot::pointerIsCell == 1u << 31);
+    Jump isAddress = jit.branch64(CCallHelpers::GreaterThanOrEqual, word, TrustedImm32(0));
+    jit.loadPtr(Address(A0, JSSymbolTableObject::offsetOfSymbolTable()), t2);
+    miss.append(jit.branchPtr(CCallHelpers::NotEqual, t1, t2));
+    jit.urshift64(TrustedImm32(32), word);
+    jit.and32(TrustedImm32(Slot::offsetMask), word);
+    jit.load64(CCallHelpers::BaseIndex(A0, word, CCallHelpers::TimesEight, JSLexicalEnvironment::offsetOfVariables()), t1);
+    miss.append(jit.branchTest64(CCallHelpers::Zero, t1));
+    jit.move(t1, A0);
+    jit.ret();
+    isAddress.link(&jit);
+    jit.load64(Address(t1), t1);
+    miss.append(jit.branchTest64(CCallHelpers::Zero, t1));
+    jit.move(t1, A0);
+    jit.ret();
+
+    noAddress.link(&jit);
+    jit.urshift64(TrustedImm32(32), word);
+    Jump outOfLine = jit.branch32(CCallHelpers::GreaterThanOrEqual, word, TrustedImm32(firstOutOfLineOffset));
+    jit.load64(CCallHelpers::BaseIndex(A0, word, CCallHelpers::TimesEight, JSObject::offsetOfInlineStorage()), A0);
+    jit.ret();
+    outOfLine.link(&jit);
+    jit.loadPtr(Address(A0, JSObject::butterflyOffset()), t1);
+    jit.neg64(word);
+    jit.load64(CCallHelpers::BaseIndex(t1, word, CCallHelpers::TimesEight, (firstOutOfLineOffset - 2) * static_cast<int>(sizeof(EncodedJSValue))), A0);
+    jit.ret();
+}
+
+static void generateGetFromScope(CCallHelpers& jit)
+{
+    CCallHelpers::JumpList miss;
+    getFromScopeIfCached(jit, 0, miss);
+
+    miss.link(&jit);
+    missAtSite(jit, Entry::operationAOTGetFromScope, 1, Returns::Value);
+}
+
+// A0 = scope, A1 = value, A2 = site.
+static void generatePutToScope(CCallHelpers& jit)
+{
+    constexpr GPRReg word = A4;
+    constexpr GPRReg t1 = A5;
+    constexpr GPRReg t2 = A3;
+    CCallHelpers::JumpList miss;
+    jit.load64(slotWord(A2, 0), word);
+    jit.load32(Address(A0, JSCell::structureIDOffset()), t1);
+    miss.append(jit.branch32(CCallHelpers::NotEqual, word, t1));
+    jit.loadPtr(slotWord(A2, 1), t1);
+    jit.loadPtr(Address(A0, JSSymbolTableObject::offsetOfSymbolTable()), t2);
+    miss.append(jit.branchPtr(CCallHelpers::NotEqual, t1, t2));
+    jit.urshift64(TrustedImm32(32), word);
+    jit.and32(TrustedImm32(Slot::offsetMask), word);
+    jit.store64(A1, CCallHelpers::BaseIndex(A0, word, CCallHelpers::TimesEight, JSLexicalEnvironment::offsetOfVariables()));
+
+    Jump notCell = jit.branchIfNotCell(A1);
+    loadInstance(jit, T9);
+    jit.load8(Address(A0, JSCell::cellStateOffset()), word);
+    jit.loadPtr(Address(T9, Instance::offsetOfVM()), t1);
+    jit.load32(Address(t1, VM::offsetOfHeapBarrierThreshold()), t2);
+    Jump barrier = jit.branch32(CCallHelpers::BelowOrEqual, word, t2);
+    notCell.link(&jit);
+    jit.ret();
+
+    // A jump into C: it returns to the stub's caller, with the stack as it was when the stub was called.
+    barrier.link(&jit);
+    jit.move(A0, A1);
+    jit.move(t1, A0);
+    jit.loadPtr(Address(T9, Instance::offsetOfRuntimeTable()), T9);
+    jit.loadPtr(Address(T9, static_cast<unsigned>(Entry::operationAOTWriteBarrier) * sizeof(void*)), T9);
+    jit.farJump(T9, OperationPtrTag);
+
+    miss.link(&jit);
+    missAtSite(jit, Entry::operationAOTPutToScope, 2, Returns::Void);
+}
+
+// op_resolve_scope fused with the op_get_from_scope that uses it. A0 = scope, A1 = site of the first; the second's follows it.
+static void generateGetGlobal(CCallHelpers& jit)
+{
+    static_assert(sizeof(Slot) == 2 * sizeof(void*));
+    // Light (stubPreservesCalleeSaves()): only caller-saved registers.
+    constexpr GPRReg word = A2;
+    constexpr GPRReg epoch = A3;
+    loadInstance(jit, T9);
+    jit.load32(slotWord(A1, 0).withOffset(sizeof(uint32_t)), word);
+    jit.loadPtr(Address(T9, Instance::offsetOfGlobalObject()), epoch);
+    jit.load32(Address(epoch, JSGlobalObject::offsetOfGlobalLexicalBindingEpoch()), epoch);
+    jit.add32(TrustedImm32(1), epoch);
+    Jump notThatOne = jit.branch32(CCallHelpers::NotEqual, word, epoch);
+    jit.loadPtr(slotWord(A1, 1), A0);
+
+    auto resolved = jit.label();
+    CCallHelpers::JumpList miss;
+    getFromScopeIfCached(jit, 2, miss);
+
+    miss.link(&jit);
+    jit.addPtr(TrustedImm32(sizeof(Slot)), A1);
+    missAtSite(jit, Entry::operationAOTGetFromScope, 1, Returns::Value);
+
+    notThatOne.link(&jit);
+    Jump notResolved = walkOutIfResolvedByDepth(jit, word);
+    jit.jump().linkTo(resolved, &jit);
+
+    notResolved.link(&jit);
+    jit.emitFunctionPrologue();
+    jit.subPtr(TrustedImm32(16), CCallHelpers::stackPointerRegister);
+    jit.storePtr(A1, Address(CCallHelpers::stackPointerRegister));
+    prepareMissAtSite(jit, Entry::operationAOTResolveScope, 1, Address(GPRInfo::callFrameRegister, sizeof(void*)));
+    jit.call(T9, OperationPtrTag);
+    // (The second result, which says whether there was an exception, stays where it is: rdx, which nothing below writes.)
+    static_assert(noOverlap(GPRInfo::returnValueGPR2, A0, A1));
+    jit.move(GPRInfo::returnValueGPR, A0);
+    jit.loadPtr(Address(CCallHelpers::stackPointerRegister), A1);
+    jit.emitFunctionEpilogue();
+    Jump exception = jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR2);
+    jit.jump().linkTo(resolved, &jit);
+
+    exception.link(&jit);
+    loadInstance(jit, T9);
+    jumpToEntry(jit, T9, Entry::HandleException);
+}
+
+// ---- Properties
+//
+// The x86-64 stubs take the monomorphic fast paths of the ARM64 ones. Everything else (other Structures, polymorphic slots, the
+// program's dispatch table, the megamorphic cache, typed fields) goes to the operation, which does what the ARM64 fast paths do
+// and fills in the slot. TODO(x86-aot-port): those fast paths, for speed.
+
+// word: the first word of a slot whose offset is a locationOfProperty(). object: the object that holds the property. Leaves the
+// storage base in `storage` and the index into it in `word`.
+static void locateCachedProperty(CCallHelpers& jit, GPRReg object, GPRReg word, GPRReg storage)
+{
+    jit.lshift64(TrustedImm32(32 - Slot::offsetBits), word);
+    jit.rshift64(TrustedImm32(64 - Slot::offsetBits), word);
+    jit.loadPtr(Address(object, JSObject::butterflyOffset()), storage);
+    jit.moveConditionally64(CCallHelpers::LessThan, word, TrustedImm32(0), storage, object, storage);
+}
+
+// A0 = the base, getterSetter = a GetterSetter. If its getter is a function, calls it (through Stub::Call) and returns its result
+// from the stub. Otherwise preserves A0, A1, A3 and A4. ARM64 tail-calls it, since a function's result and a stub's are both in x0;
+// here they are in rax and A0, so the stub stays to move it. (ARM64: the GetterSetter in T12, temporaries T11 and T13.)
+// The stubs that come here are light (stubPreservesCalleeSaves()), and compiled code, which the getter may be, clobbers rbx and
+// r12: they are saved around the call, in the stub's frame. Only the way back needs them; an exception unwinds past the stub's
+// frame to a handler that does not look at them (a catch is a way into the function of its own, AOTCompiler.cpp).
+static void callGetter(CCallHelpers& jit, GPRReg getterSetter, CCallHelpers::JumpList& cannot)
+{
+    constexpr GPRReg getter = A5;
+    constexpr GPRReg t = A2;
+    static_assert(noOverlap(getter, t, A0, A1, A3, A4, thisGPR, countGPR, calleeGPR));
+    jit.loadPtr(Address(getterSetter, GetterSetter::offsetOfGetter()), getter);
+    {
+        // The length of a typed array, unless it must be computed (resizable buffer) or does not fit in an int32.
+        jit.loadPtr(Address(instanceGPR, Instance::offsetOfGetterOfLengthOfTypedArrays()), t);
+        Jump isSomeOtherGetter = jit.branchPtr(CCallHelpers::NotEqual, getter, t);
+        jit.load8(Address(A0, JSCell::typeInfoTypeOffset()), t);
+        jit.sub32(TrustedImm32(FirstTypedArrayType), t);
+        Jump isNoTypedArray = jit.branch32(CCallHelpers::AboveOrEqual, t, TrustedImm32(NumberOfTypedArrayTypesExcludingDataView));
+        jit.load8(Address(A0, JSArrayBufferView::offsetOfMode()), t);
+        Jump takesWorkingOut = jit.branchTest32(CCallHelpers::NonZero, t, TrustedImm32(resizabilityAndAutoLengthMask));
+        jit.load64(Address(A0, JSArrayBufferView::offsetOfLength()), t);
+        Jump isTooLong = jit.branch64(CCallHelpers::Above, t, TrustedImm32(std::numeric_limits<int32_t>::max()));
+        // (The callers keep the tag registers valid.)
+        jit.or64(GPRInfo::numberTagRegister, t, A0);
+        jit.ret();
+        isSomeOtherGetter.link(&jit);
+        isNoTypedArray.link(&jit);
+        takesWorkingOut.link(&jit);
+        isTooLong.link(&jit);
+    }
+    cannot.append(jit.branchIfNotType(getter, JSFunctionType));
+    // Entered with rsp = 8 mod 16: the frame and the two saves leave it aligned for the call.
+    jit.emitFunctionPrologue();
+    jit.push(X86Registers::ebx);
+    jit.push(X86Registers::r12);
+    jit.move(getter, calleeGPR);
+    jit.move(A0, thisGPR);
+    jit.move(TrustedImm32(0), countGPR);
+    callStubFromStub(jit, Stub::Call);
+    jit.pop(X86Registers::r12);
+    jit.pop(X86Registers::ebx);
+    jit.emitFunctionEpilogue();
+    jit.move(GPRInfo::returnValueGPR, stubResultGPR);
+    jit.ret();
+}
+
+// A0 = the base, an object. uid: the property name (an atom, or a symbol's uid). On a hit in the VM's megamorphic cache, returns the
+// value from the stub, or calls the getter if it is one (see callGetter()). On a miss, preserves A0 and A1. Temporaries: A2-A5, T9,
+// rax (ARM64: x6, x7, T11-T13); the uid may be A2.
+static void getFromMegamorphicCache(CCallHelpers& jit, GPRReg uid, CCallHelpers::JumpList& notFound)
+{
+    constexpr GPRReg cache = A3;
+    constexpr GPRReg result = A4;
+    constexpr GPRReg t = X86Registers::eax; // thisGPR, which a property read has nothing to do with.
+    ASSERT(uid != cache && uid != result && uid != A0 && uid != A1 && uid != A5 && uid != T9 && uid != t);
+    loadInstance(jit, cache);
+    jit.loadPtr(Address(cache, Instance::offsetOfRuntimeTable()), cache);
+    jit.loadPtr(Address(cache, static_cast<unsigned>(Entry::MegamorphicCache) * sizeof(void*)), cache);
+    notFound.append(jit.branchTestPtr(CCallHelpers::Zero, cache));
+    CCallHelpers::JumpList notValue = jit.loadMegamorphicProperty(CCallHelpers::MegamorphicCacheLocation(cache), A0, uid, nullptr, result, A5, T9, t);
+    jit.move(result, A0);
+    jit.ret();
+    notValue.link(&jit);
+    notFound.append(jit.loadMegamorphicGetterSetter(CCallHelpers::MegamorphicCacheLocation(cache), A0, uid, nullptr, result, A5, T9, t));
+    callGetter(jit, result, notFound);
+}
+
+// A0 = base, A1 = site. Result in A0. Light (stubPreservesCalleeSaves()): ARM64's T11 and T12 are T9 and rax here (rax is thisGPR,
+// which a property read has nothing to do with).
+static void generateGetByIdWith(CCallHelpers& jit, Entry operation)
+{
+    constexpr GPRReg word = T9;
+    constexpr GPRReg t1 = X86Registers::eax;
+    constexpr GPRReg t2 = A2;
+    CCallHelpers::JumpList miss;
+    // Callers keep the tag registers valid.
+    miss.append(jit.branchIfNotCell(A0));
+    jit.load64(slotWord(A1, 0), word);
+    jit.load32(Address(A0, JSCell::structureIDOffset()), t1);
+    Jump isOfAnotherStructure = jit.branch32(CCallHelpers::NotEqual, word, t1);
+    // Inline storage, the most common case.
+    Jump isIndirect = jit.branchTest64(CCallHelpers::NonZero, word, CCallHelpers::TrustedImm64(static_cast<int64_t>(Slot::isIndirect) << 32));
+    jit.urshift64(TrustedImm32(32), word);
+    jit.and32(TrustedImm32(Slot::directLocationMask), word);
+    jit.load64(CCallHelpers::BaseIndex(A0, word, CCallHelpers::TimesEight), A0);
+    jit.ret();
+
+    // Out-of-line storage, or a holder on the prototype chain shared by every base with this Structure.
+    isIndirect.link(&jit);
+    jit.loadPtr(slotWord(A1, 1), t1);
+    jit.moveConditionallyTest64(CCallHelpers::NonZero, t1, t1, t1, A0, t1);
+    Jump isGetter = jit.branchTest64(CCallHelpers::NonZero, word, CCallHelpers::TrustedImm64(static_cast<int64_t>(Slot::isGetter) << 32));
+    locateCachedProperty(jit, t1, word, t2);
+    jit.load64(CCallHelpers::BaseIndex(t2, word, CCallHelpers::TimesEight), A0);
+    jit.ret();
+
+    isGetter.link(&jit);
+    locateCachedProperty(jit, t1, word, t2);
+    jit.load64(CCallHelpers::BaseIndex(t2, word, CCallHelpers::TimesEight), t1);
+    callGetter(jit, t1, miss);
+
+    // As ARM64's: another Structure than the slot's. word = the slot's first word, t1 = the base's StructureID.
+    isOfAnotherStructure.link(&jit);
+    CCallHelpers::JumpList missAndUpdateCache;
+    if (operation == Entry::operationAOTGetById) {
+        constexpr GPRReg several = A3;
+        constexpr GPRReg ownSlotOfSite = A4;
+        {
+            // A direct slot with a property name id: the base's Structure may have the same name at the same inline offset (a
+            // base-class field in another subclass, say).
+            constexpr GPRReg nameID = A2;
+            constexpr GPRReg location = A5;
+            Jump isIndirect = jit.branchTest64(CCallHelpers::NonZero, word, CCallHelpers::TrustedImm64(static_cast<int64_t>(Slot::isIndirect) << 32));
+            jit.move(word, nameID);
+            jit.urshift64(TrustedImm32(32 + Slot::nameIDShift), nameID);
+            jit.and32(TrustedImm32(0xffff), nameID);
+            Jump hasNoNameID = jit.branchTest32(CCallHelpers::Zero, nameID);
+            jit.move(word, location);
+            jit.urshift64(TrustedImm32(32), location);
+            jit.and32(TrustedImm32(Slot::directLocationMask), location);
+            jit.or64(CCallHelpers::TrustedImm64(structureIDBaseOfImages), t1);
+            constexpr ptrdiff_t wordsBeforeInlineStorage = JSObject::offsetOfInlineStorage() / sizeof(EncodedJSValue);
+            jit.load16(CCallHelpers::BaseIndex(t1, location, CCallHelpers::TimesTwo, Structure::offsetOfFieldIDInSlot() - wordsBeforeInlineStorage * sizeof(uint16_t)), t1);
+            Jump isAnotherName = jit.branch32(CCallHelpers::NotEqual, t1, nameID);
+            jit.load64(CCallHelpers::BaseIndex(A0, location, CCallHelpers::TimesEight), A0);
+            jit.ret();
+            isIndirect.link(&jit);
+            hasNoNameID.link(&jit);
+            isAnotherName.link(&jit);
+        }
+        // The slot holds a different Structure: this is the second one the site has seen.
+        missAndUpdateCache.append(jit.branchTest32(CCallHelpers::NonZero, word));
+        // The slot has no Structure. It is either empty or polymorphic (Slot::isPolymorphic()).
+        jit.move(word, A2);
+        jit.urshift64(TrustedImm32(32), A2);
+        jit.and32(TrustedImm32(Slot::flagsMask), A2);
+        miss.append(jit.branch32(CCallHelpers::NotEqual, A2, TrustedImm32(Slot::polymorphicFlags)));
+        jit.loadPtr(slotWord(A1, 1), several);
+        jit.load32(Address(A0, JSCell::structureIDOffset()), t1);
+        static_assert(!OBJECT_OFFSETOF(Slot, structureID));
+        Jump isThatOne[PolymorphicSlots::numberOfSlots];
+        for (unsigned i = 0; i < PolymorphicSlots::numberOfSlots; ++i)
+            isThatOne[i] = jit.branch32(CCallHelpers::Equal, t1, Address(several, PolymorphicSlots::offsetOfSlots() + i * sizeof(Slot)));
+
+        // No entry matches.
+        missAndUpdateCache.append(jit.branchTest32(CCallHelpers::NonZero, Address(several, PolymorphicSlots::offsetOfTimesLeftToLearnAtOnce())));
+        jit.load32(Address(several, PolymorphicSlots::offsetOfMisses()), A2);
+        jit.add32(TrustedImm32(1), A2);
+        jit.store32(A2, Address(several, PolymorphicSlots::offsetOfMisses()));
+        missAndUpdateCache.append(jit.branchTest32(CCallHelpers::Zero, A2, TrustedImm32(PolymorphicSlots::missesBetweenLearning - 1)));
+        missAndUpdateCache.append(jit.branchIfNotObject(A0));
+        jit.loadPtr(Address(several, PolymorphicSlots::offsetOfName()), A2);
+        getFromMegamorphicCache(jit, A2, missAndUpdateCache);
+
+        // An entry matches. From here on it is treated as the site's slot.
+        CCallHelpers::JumpList haveSlot;
+        for (unsigned i = 0; i < PolymorphicSlots::numberOfSlots; ++i) {
+            isThatOne[i].link(&jit);
+            jit.move(A1, ownSlotOfSite);
+            jit.addPtr(TrustedImm32(PolymorphicSlots::offsetOfSlots() + i * sizeof(Slot)), several, A1);
+            if (i + 1 < PolymorphicSlots::numberOfSlots)
+                haveSlot.append(jit.jump());
+        }
+        haveSlot.link(&jit);
+        jit.load64(slotWord(A1, 0), word);
+        Jump isIntricateThere = jit.branchTest64(CCallHelpers::NonZero, word, CCallHelpers::TrustedImm64(static_cast<int64_t>(Slot::isIndirect) << 32));
+        jit.urshift64(TrustedImm32(32), word);
+        jit.and32(TrustedImm32(Slot::directLocationMask), word);
+        jit.load64(CCallHelpers::BaseIndex(A0, word, CCallHelpers::TimesEight), A0);
+        jit.ret();
+        isIntricateThere.link(&jit);
+        jit.loadPtr(slotWord(A1, 1), t1);
+        jit.moveConditionallyTest64(CCallHelpers::NonZero, t1, t1, t1, A0, t1);
+        Jump isGetterThere = jit.branchTest64(CCallHelpers::NonZero, word, CCallHelpers::TrustedImm64(static_cast<int64_t>(Slot::isGetter) << 32));
+        locateCachedProperty(jit, t1, word, t2);
+        jit.load64(CCallHelpers::BaseIndex(t2, word, CCallHelpers::TimesEight), A0);
+        jit.ret();
+        isGetterThere.link(&jit);
+        locateCachedProperty(jit, t1, word, t2);
+        jit.load64(CCallHelpers::BaseIndex(t2, word, CCallHelpers::TimesEight), t1);
+        CCallHelpers::JumpList cannotCallGetter;
+        callGetter(jit, t1, cannotCallGetter); // (Which preserves ownSlotOfSite.)
+        cannotCallGetter.link(&jit);
+        jit.move(ownSlotOfSite, A1);
+        missAndUpdateCache.append(jit.jump());
+    } else
+        miss.append(jit.jump());
+
+    miss.link(&jit);
+    missAtSite(jit, operation, 1, Returns::Value);
+    if (!missAndUpdateCache.empty()) {
+        // Bypass the front end that probes the megamorphic cache first: a hit there would keep the site's own cache from ever being
+        // filled (as ARM64's).
+        missAndUpdateCache.link(&jit);
+        missAtSite(jit, Entry::RawGetById, 1, Returns::Value);
+    }
+}
+static void generateGetById(CCallHelpers& jit) { generateGetByIdWith(jit, Entry::operationAOTGetById); }
+static void generateGetByIdWellKnown(CCallHelpers& jit) { generateGetByIdWith(jit, Entry::operationAOTGetByIdWellKnown); }
+
+// A0 = the cell that was stored to, T9 = the Instance. Returns from the stub, through the write barrier if the cell needs it.
+// Temporaries: A3-A5 (ARM64: T11-T13); the stubs that come here are light (stubPreservesCalleeSaves()), but for PutPrivateName.
+static void returnAfterBarrier(CCallHelpers& jit)
+{
+    constexpr GPRReg state = A3;
+    constexpr GPRReg vm = A4;
+    constexpr GPRReg threshold = A5;
+    jit.load8(Address(A0, JSCell::cellStateOffset()), state);
+    jit.loadPtr(Address(T9, Instance::offsetOfVM()), vm);
+    jit.load32(Address(vm, VM::offsetOfHeapBarrierThreshold()), threshold);
+    Jump barrier = jit.branch32(CCallHelpers::BelowOrEqual, state, threshold);
+    jit.ret();
+
+    // A jump into C: it returns to the stub's caller.
+    barrier.link(&jit);
+    jit.move(A0, A1);
+    jit.move(vm, A0);
+    jit.loadPtr(Address(T9, Instance::offsetOfRuntimeTable()), T9);
+    jit.loadPtr(Address(T9, static_cast<unsigned>(Entry::operationAOTWriteBarrier) * sizeof(void*)), T9);
+    jit.farJump(T9, OperationPtrTag);
+}
+
+// A0 = base, A1 = value, A2 = site. Light (stubPreservesCalleeSaves()): only caller-saved registers, rax (thisGPR) among them.
+static void generatePutById(CCallHelpers& jit)
+{
+    constexpr GPRReg word = A5;
+    constexpr GPRReg storage = X86Registers::eax;
+    constexpr GPRReg next = A3; // The second word: a Structure to change to, and a field type above it.
+    CCallHelpers::JumpList miss;
+    miss.append(jit.branchIfNotCell(A0));
+    jit.load64(slotWord(A2, 0), word);
+    jit.load32(Address(A0, JSCell::structureIDOffset()), storage);
+    miss.append(jit.branch32(CCallHelpers::NotEqual, word, storage));
+    jit.load64(slotWord(A2, 1), next);
+    jit.move(next, A4);
+    jit.urshift64(TrustedImm32(32), A4);
+    miss.append(jit.branchTest32(CCallHelpers::NonZero, A4)); // A typed field. TODO(x86-aot-port): the fast path.
+    locateCachedProperty(jit, A0, word, storage);
+    jit.store64(A1, CCallHelpers::BaseIndex(storage, word, CCallHelpers::TimesEight));
+    Jump sameStructure = jit.branchTest32(CCallHelpers::Zero, next);
+    jit.store32(next, Address(A0, JSCell::structureIDOffset()));
+    sameStructure.link(&jit);
+
+    Jump notCell = jit.branchIfNotCell(A1);
+    // (A store through the megamorphic cache may have changed the Structure: the barrier is looked at whatever was stored.)
+    CCallHelpers::Label storedAndMayBeOfAnotherStructure = jit.label();
+    loadInstance(jit, T9);
+    returnAfterBarrier(jit);
+    notCell.link(&jit);
+    jit.ret();
+
+    // As ARM64's: the VM's megamorphic cache, for a site that has seen too many Structures. A typed field is never cached there
+    // (PutPropertySlot::isCacheablePut()). The function that missed is found from the stub's return address.
+    miss.link(&jit);
+    {
+        CCallHelpers::JumpList notFound;
+        constexpr GPRReg index = A4;
+        constexpr GPRReg site = A5;
+        constexpr GPRReg data = X86Registers::eax;
+        constexpr GPRReg info = X86Registers::eax; // Once the Data has given the site's index.
+        constexpr GPRReg uid = A3;
+        constexpr GPRReg cache = A4;
+        notFound.append(jit.branchIfNotCell(A0));
+        notFound.append(jit.branchIfNotObject(A0));
+        jit.loadPtr(Address(CCallHelpers::stackPointerRegister), A3);
+        loadIndexOfFunctionAt(jit, A3, index, site);
+        loadInstanceAndDataOfSlot(jit, A2, T9, data, index);
+        siteOfSlot(jit, data, A2, site);
+        loadInfo(jit, T9, index, info);
+        jit.loadPtr(Address(info, FunctionInfo::offsetOfSites()), uid);
+        jit.load32(CCallHelpers::BaseIndex(uid, site, CCallHelpers::TimesFour), uid);
+        // A store that defines the property regardless of the prototype chain is not what the cache holds.
+        notFound.append(jit.branchTest32(CCallHelpers::NonZero, uid, TrustedImm32(1u << Site::identifierBits)));
+        jit.and32(TrustedImm32((1u << Site::identifierBits) - 1), uid);
+        jit.loadPtr(Address(info, FunctionInfo::offsetOfIdentifiers()), site);
+        jit.loadPtr(CCallHelpers::BaseIndex(site, uid, CCallHelpers::TimesEight), uid);
+        jit.loadPtr(Address(T9, Instance::offsetOfRuntimeTable()), cache);
+        jit.loadPtr(Address(cache, static_cast<unsigned>(Entry::MegamorphicCache) * sizeof(void*)), cache);
+        notFound.append(jit.branchTestPtr(CCallHelpers::Zero, cache));
+        // (info and the Instance are done with: the way on loads the Instance again.)
+        auto [slow, reallocating] = jit.storeMegamorphicProperty(CCallHelpers::MegamorphicCacheLocation(cache), A0, uid, nullptr, A1, site, info, T9);
+        jit.jump().linkTo(storedAndMayBeOfAnotherStructure, &jit);
+        slow.link(&jit);
+        reallocating.link(&jit);
+        notFound.link(&jit);
+    }
+    missAtSite(jit, Entry::operationAOTPutById, 2, Returns::Void);
+}
+
+// Private name caches are keyed by Structure and name. The name is a cell that the slot points to. Leaves the slot's first word in
+// privateNameWord. Temporaries: A4, A5 (ARM64: T10, T11), which none of the private name stubs takes an operand in.
+static constexpr GPRReg privateNameWord = A4;
+static constexpr GPRReg privateNameStorage = A5;
+static void checkPrivateNameCache(CCallHelpers& jit, GPRReg slot, CCallHelpers::JumpList& miss)
+{
+    miss.append(jit.branchIfNotCell(A0));
+    jit.load64(slotWord(slot, 0), privateNameWord);
+    jit.load32(Address(A0, JSCell::structureIDOffset()), privateNameStorage);
+    miss.append(jit.branch32(CCallHelpers::NotEqual, privateNameWord, privateNameStorage));
+    jit.loadPtr(slotWord(slot, 1), privateNameStorage);
+    miss.append(jit.branchPtr(CCallHelpers::NotEqual, privateNameStorage, A1));
+}
+
+// A0 = base, A1 = private name or brand, A2 = site. GetPrivateName returns the result in A0.
+static void generateGetPrivateName(CCallHelpers& jit)
+{
+    CCallHelpers::JumpList miss;
+    checkPrivateNameCache(jit, A2, miss);
+    locateCachedProperty(jit, A0, privateNameWord, privateNameStorage);
+    jit.load64(CCallHelpers::BaseIndex(privateNameStorage, privateNameWord, CCallHelpers::TimesEight), A0);
+    jit.ret();
+
+    miss.link(&jit);
+    missAtSite(jit, Entry::operationAOTGetPrivateName, 2, Returns::Value);
+}
+
+static void generateCheckPrivateBrand(CCallHelpers& jit)
+{
+    CCallHelpers::JumpList miss;
+    checkPrivateNameCache(jit, A2, miss);
+    jit.ret();
+
+    miss.link(&jit);
+    missAtSite(jit, Entry::operationAOTCheckPrivateBrand, 2, Returns::Void);
+}
+
+// A0 = base, A1 = private name, A2 = value, A3 = site. Only for an existing field.
+static void generatePutPrivateName(CCallHelpers& jit)
+{
+    CCallHelpers::JumpList miss;
+    checkPrivateNameCache(jit, A3, miss);
+    locateCachedProperty(jit, A0, privateNameWord, privateNameStorage);
+    jit.store64(A2, CCallHelpers::BaseIndex(privateNameStorage, privateNameWord, CCallHelpers::TimesEight));
+    Jump notCell = jit.branchIfNotCell(A2);
+    loadInstance(jit, T9);
+    returnAfterBarrier(jit);
+    notCell.link(&jit);
+    jit.ret();
+
+    miss.link(&jit);
+    missAtSite(jit, Entry::operationAOTPutPrivateName, 3, Returns::Void);
+}
+
+// ---- Arithmetic and comparisons
+
+static void generateEqual(CCallHelpers& jit, Entry operation)
+{
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NumberTag), T9);
+    Jump notBothInt32 = jit.branch64(CCallHelpers::Below, A0, T9);
+    Jump notBothInt32Either = jit.branch64(CCallHelpers::Below, A1, T9);
+    jit.compare32(CCallHelpers::Equal, A0, A1, A0);
+    jit.ret();
+
+    notBothInt32.link(&jit);
+    notBothInt32Either.link(&jit);
+    // Identical bits and not a number: equal, whatever the value is.
+    Jump differ = jit.branch64(CCallHelpers::NotEqual, A0, A1);
+    Jump isNumber = jit.branchTest64(CCallHelpers::NonZero, A0, T9);
+    jit.move(TrustedImm32(1), A0);
+    jit.ret();
+
+    differ.link(&jit);
+    isNumber.link(&jit);
+    // (Light, stubPreservesCalleeSaves(): A3 where ARM64 has T11. The front ends in front of the operations give rbx back too.)
+    loadInstance(jit, A3);
+    jit.move(A1, A2);
+    jit.move(A0, A1);
+    jit.loadPtr(Address(A3, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(A3, Instance::offsetOfRuntimeTable()), A3);
+    jit.loadPtr(Address(A3, static_cast<unsigned>(operation) * sizeof(void*)), A3);
+    callAndCheckException(jit, A3, Returns::Value);
+}
+static void generateStrictEqual(CCallHelpers& jit) { generateEqual(jit, Entry::operationAOTCompareStrictEq); }
+static void generateLooseEqual(CCallHelpers& jit) { generateEqual(jit, Entry::operationAOTCompareEq); }
+
+// The prototype walk of AccessCase::InstanceOfMegamorphic. A0 = an object, A1 = a value. Light (stubPreservesCalleeSaves()).
+static void generateInstanceOf(CCallHelpers& jit)
+{
+    constexpr GPRReg object = A2;
+    constexpr GPRReg prototype = A3;
+    CCallHelpers::JumpList slowPath;
+    slowPath.append(jit.branchIfNotCell(A1));
+    slowPath.append(jit.branchIfNotObject(A1));
+    jit.move(A0, object);
+
+    CCallHelpers::Label loop = jit.label();
+    slowPath.append(jit.branchTest8(CCallHelpers::NonZero, Address(object, JSObject::typeInfoFlagsOffset()), TrustedImm32(OverridesGetPrototype)));
+    jit.load32(Address(object, JSCell::structureIDOffset()), prototype);
+    jit.or64(CCallHelpers::TrustedImm64(structureIDBaseOfImages), prototype);
+    jit.load64(Address(prototype, Structure::prototypeOffset()), prototype);
+    Jump hasMonoProto = jit.branchTest64(CCallHelpers::NonZero, prototype);
+    jit.load64(Address(object, offsetRelativeToBase(knownPolyProtoOffset)), prototype);
+    hasMonoProto.link(&jit);
+    Jump isInstance = jit.branch64(CCallHelpers::Equal, prototype, A1);
+    jit.move(prototype, object);
+    jit.branchIfCell(object).linkTo(loop, &jit);
+    jit.move(TrustedImm32(0), A0);
+    jit.ret();
+
+    isInstance.link(&jit);
+    jit.move(TrustedImm32(1), A0);
+    jit.ret();
+
+    slowPath.link(&jit);
+    loadInstance(jit, A3);
+    jit.move(A1, A2);
+    jit.move(A0, A1);
+    jit.loadPtr(Address(A3, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(A3, Instance::offsetOfRuntimeTable()), A3);
+    jit.loadPtr(Address(A3, static_cast<unsigned>(Entry::operationAOTDefaultHasInstance) * sizeof(void*)), A3);
+    callAndCheckException(jit, A3, Returns::Value);
+}
+
+// For the string in A0: the address of its characters in the low 48 bits and its length (saturated at 0xffff) above them. A null
+// address for a rope or a 16-bit string. A substring of an 8-bit string is read in place. Clobbers only T9 (and the scratch register,
+// stubTemporaryRegisters()): ARM64's T10 and T11 are A1 and A2 here, which it saves on the stack, since rbx and r12 are callee-saved.
+static void generateNarrowCharacters(CCallHelpers& jit)
+{
+    constexpr GPRReg length = A1;
+    constexpr GPRReg t = A2;
+    jit.push(length);
+    jit.push(t);
+    CCallHelpers::JumpList isNotForTheLooking;
+    jit.loadPtr(Address(A0, JSString::offsetOfValue()), T9);
+    Jump isRope = jit.branchIfRopeStringImpl(T9);
+    jit.load32(Address(T9, StringImpl::lengthMemoryOffset()), length);
+    jit.load32(Address(T9, StringImpl::flagsOffset()), t);
+    isNotForTheLooking.append(jit.branchTest32(CCallHelpers::Zero, t, TrustedImm32(StringImpl::flagIs8Bit())));
+    jit.loadPtr(Address(T9, StringImpl::dataOffset()), A0);
+
+    // (The only way out.)
+    CCallHelpers::Label pack = jit.label();
+    Jump fits = jit.branch32(CCallHelpers::BelowOrEqual, length, TrustedImm32(0xffff));
+    jit.move(TrustedImm32(0xffff), length);
+    fits.link(&jit);
+    jit.lshift64(TrustedImm32(48), length);
+    jit.or64(length, A0);
+    jit.pop(t);
+    jit.pop(length);
+    jit.ret();
+
+    isRope.link(&jit);
+    jit.load32(Address(A0, JSRopeString::offsetOfLength()), length);
+    constexpr uintptr_t narrowSlice = JSRopeString::isSubstringInPointer | JSRopeString::is8BitInPointer;
+    jit.and64(TrustedImm32(narrowSlice), T9, t);
+    isNotForTheLooking.append(jit.branch64(CCallHelpers::NotEqual, t, TrustedImm32(narrowSlice)));
+    jit.load64(Address(A0, JSRopeString::offsetOfFiber1()), T9);
+    jit.load64(Address(A0, JSRopeString::offsetOfFiber2()), t);
+    jit.urshift64(TrustedImm32(32), T9);
+    jit.and64(TrustedImm32(0xffff), t, A0);
+    jit.lshift64(TrustedImm32(32), A0);
+    jit.or64(T9, A0);
+    jit.urshift64(TrustedImm32(16), t);
+    jit.loadPtr(Address(A0, JSString::offsetOfValue()), A0);
+    jit.loadPtr(Address(A0, StringImpl::dataOffset()), A0);
+    jit.add64(t, A0);
+    jit.jump().linkTo(pack, &jit);
+
+    isNotForTheLooking.link(&jit);
+    jit.move(TrustedImm32(0), A0);
+    jit.jump().linkTo(pack, &jit);
+}
+
+// A0 === A1, where A1 is a string literal: resolved, 8-bit and an atom. Light (stubPreservesCalleeSaves()): A5 where ARM64 has T11.
+static void generateIsStringEqualTo(CCallHelpers& jit)
+{
+    CCallHelpers::JumpList isTrue;
+    CCallHelpers::JumpList isFalse;
+    CCallHelpers::JumpList slow;
+    isTrue.append(jit.branch64(CCallHelpers::Equal, A0, A1));
+    isFalse.append(jit.branchIfNotCell(A0));
+    jit.load8(Address(A0, JSCell::typeInfoTypeOffset()), T9);
+    isFalse.append(jit.branch32(CCallHelpers::NotEqual, T9, TrustedImm32(StringType)));
+    jit.loadPtr(Address(A0, JSString::offsetOfValue()), A2);
+    jit.loadPtr(Address(A1, JSString::offsetOfValue()), A3);
+    jit.load32(Address(A3, StringImpl::lengthMemoryOffset()), A4);
+    Jump isRope = jit.branchIfRopeStringImpl(A2);
+    isTrue.append(jit.branchPtr(CCallHelpers::Equal, A2, A3));
+    jit.load32(Address(A2, StringImpl::lengthMemoryOffset()), T9);
+    isFalse.append(jit.branch32(CCallHelpers::NotEqual, T9, A4));
+    jit.load32(Address(A2, StringImpl::flagsOffset()), T9);
+    isFalse.append(jit.branchTest32(CCallHelpers::NonZero, T9, TrustedImm32(StringImpl::flagIsAtom())));
+    slow.append(jit.branchTest32(CCallHelpers::Zero, T9, TrustedImm32(StringImpl::flagIs8Bit())));
+    jit.loadPtr(Address(A2, StringImpl::dataOffset()), A2);
+
+    CCallHelpers::Label compare = jit.label();
+    jit.loadPtr(Address(A3, StringImpl::dataOffset()), A3);
+    CCallHelpers::Label eightAtATime = jit.label();
+    Jump fewerThanEight = jit.branch32(CCallHelpers::Below, A4, TrustedImm32(8));
+    jit.load64(Address(A2), T9);
+    jit.load64(Address(A3), A5);
+    isFalse.append(jit.branch64(CCallHelpers::NotEqual, T9, A5));
+    jit.add64(TrustedImm32(8), A2);
+    jit.add64(TrustedImm32(8), A3);
+    jit.sub32(TrustedImm32(8), A4);
+    jit.jump().linkTo(eightAtATime, &jit);
+    fewerThanEight.link(&jit);
+    CCallHelpers::Label oneAtATime = jit.label();
+    isTrue.append(jit.branchTest32(CCallHelpers::Zero, A4));
+    jit.load8(Address(A2), T9);
+    jit.load8(Address(A3), A5);
+    isFalse.append(jit.branch32(CCallHelpers::NotEqual, T9, A5));
+    jit.add64(TrustedImm32(1), A2);
+    jit.add64(TrustedImm32(1), A3);
+    jit.sub32(TrustedImm32(1), A4);
+    jit.jump().linkTo(oneAtATime, &jit);
+
+    isRope.link(&jit);
+    jit.load32(Address(A0, JSRopeString::offsetOfLength()), T9);
+    isFalse.append(jit.branch32(CCallHelpers::NotEqual, T9, A4));
+    constexpr uintptr_t narrowSlice = JSRopeString::isSubstringInPointer | JSRopeString::is8BitInPointer;
+    jit.and64(TrustedImm32(narrowSlice), A2, T9);
+    slow.append(jit.branch64(CCallHelpers::NotEqual, T9, TrustedImm32(narrowSlice)));
+    jit.load64(Address(A0, JSRopeString::offsetOfFiber1()), T9);
+    jit.load64(Address(A0, JSRopeString::offsetOfFiber2()), A5);
+    jit.urshift64(TrustedImm32(32), T9);
+    jit.and64(TrustedImm32(0xffff), A5, A2);
+    jit.lshift64(TrustedImm32(32), A2);
+    jit.or64(T9, A2);
+    jit.urshift64(TrustedImm32(16), A5);
+    jit.loadPtr(Address(A2, JSString::offsetOfValue()), A2);
+    jit.loadPtr(Address(A2, StringImpl::dataOffset()), A2);
+    jit.add64(A5, A2);
+    jit.jump().linkTo(compare, &jit);
+
+    isTrue.link(&jit);
+    jit.move(TrustedImm32(1), A0);
+    jit.ret();
+    isFalse.link(&jit);
+    jit.move(TrustedImm32(0), A0);
+    jit.ret();
+
+    slow.link(&jit);
+    generateEqual(jit, Entry::operationAOTCompareStrictEq);
+}
+
+// Calls operation(globalObject, A0, A1). Only caller-saved registers: the stubs that come here are light (stubPreservesCalleeSaves()).
+static void callBinaryOperation(CCallHelpers& jit, Entry operation)
+{
+    loadInstance(jit, A3);
+    jit.move(A1, A2);
+    jit.move(A0, A1);
+    jit.loadPtr(Address(A3, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(A3, Instance::offsetOfRuntimeTable()), A3);
+    jit.loadPtr(Address(A3, static_cast<unsigned>(operation) * sizeof(void*)), A3);
+    callAndCheckException(jit, A3, Returns::Value);
+}
+
+enum class Binary : uint8_t { Add, Sub, Mul, BitAnd, BitOr, BitXor, LShift, RShift, URShift, Mod, Less, LessEq, Greater, GreaterEq };
+
+// A function with no loops may still be called from one, so the stub handles numbers itself. Everything else goes to the runtime.
+static void generateBinary(CCallHelpers& jit, Binary kind, Entry operation)
+{
+    bool isComparison = kind >= Binary::Less;
+    bool hasDoubleCase = isComparison || kind <= Binary::Mul;
+    constexpr FPRReg left = FPRInfo::fpRegT0;
+    constexpr FPRReg right = FPRInfo::fpRegT1;
+    // The integer result: A2 where ARM64 has T11 (rbx is callee-saved here). Free, since A0 and A1 are kept for the slow path.
+    constexpr GPRReg integer = A2;
+    CCallHelpers::JumpList notBothInt32;
+    CCallHelpers::JumpList slow;
+
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NumberTag), T9);
+    notBothInt32.append(jit.branch64(CCallHelpers::Below, A0, T9));
+    notBothInt32.append(jit.branch64(CCallHelpers::Below, A1, T9));
+    auto boxInt32AndReturn = [&] {
+        jit.zeroExtend32ToWord(integer, integer);
+        jit.or64(T9, integer, A0);
+        jit.ret();
+    };
+    auto compareAndReturn = [&](CCallHelpers::RelationalCondition condition) {
+        jit.compare32(condition, A0, A1, A0);
+        jit.ret();
+    };
+    switch (kind) {
+    case Binary::Add:
+        slow.append(jit.branchAdd32(CCallHelpers::Overflow, A0, A1, integer));
+        boxInt32AndReturn();
+        break;
+    case Binary::Sub:
+        slow.append(jit.branchSub32(CCallHelpers::Overflow, A0, A1, integer));
+        boxInt32AndReturn();
+        break;
+    case Binary::Mul:
+        slow.append(jit.branchMul32(CCallHelpers::Overflow, A0, A1, integer));
+        slow.append(jit.branchTest32(CCallHelpers::Zero, integer)); // The result may be -0.
+        boxInt32AndReturn();
+        break;
+    case Binary::BitAnd:
+        jit.and32(A0, A1, integer);
+        boxInt32AndReturn();
+        break;
+    case Binary::BitOr:
+        jit.or32(A0, A1, integer);
+        boxInt32AndReturn();
+        break;
+    case Binary::BitXor:
+        jit.xor32(A0, A1, integer);
+        boxInt32AndReturn();
+        break;
+    case Binary::LShift:
+        jit.lshift32(A0, A1, integer);
+        boxInt32AndReturn();
+        break;
+    case Binary::RShift:
+        jit.rshift32(A0, A1, integer);
+        boxInt32AndReturn();
+        break;
+    case Binary::URShift:
+        jit.urshift32(A0, A1, integer);
+        slow.append(jit.branch32(CCallHelpers::LessThan, integer, TrustedImm32(0))); // Nonnegative, but too large for an int32.
+        boxInt32AndReturn();
+        break;
+    case Binary::Mod:
+        // Only a nonnegative dividend and a positive divisor. The other cases involve signed zeros and division by zero.
+        slow.append(jit.branch32(CCallHelpers::LessThan, A0, TrustedImm32(0)));
+        slow.append(jit.branch32(CCallHelpers::LessThanOrEqual, A1, TrustedImm32(0)));
+        // idiv: the dividend in edx:eax, the remainder in edx, which is where the integer result goes anyway. rax is free here.
+        static_assert(integer == X86Registers::edx);
+        jit.move(A0, X86Registers::eax);
+        jit.x86ConvertToDoubleWord32();
+        jit.x86Div32(A1);
+        jit.move(X86Registers::edx, integer);
+        boxInt32AndReturn();
+        break;
+    case Binary::Less:
+        compareAndReturn(CCallHelpers::LessThan);
+        break;
+    case Binary::LessEq:
+        compareAndReturn(CCallHelpers::LessThanOrEqual);
+        break;
+    case Binary::Greater:
+        compareAndReturn(CCallHelpers::GreaterThan);
+        break;
+    case Binary::GreaterEq:
+        compareAndReturn(CCallHelpers::GreaterThanOrEqual);
+        break;
+    }
+
+    notBothInt32.link(&jit);
+    bool isBitOperation = kind >= Binary::BitAnd && kind <= Binary::URShift;
+    if (isBitOperation) {
+        // Numbers, one of them a double: ToInt32 of each, then as above. Truncated to 64 bits, the low 32 are ToInt32 of a double
+        // whose magnitude is below 2^63; cvttsd2si gives INT64_MIN for the rest and NaN, which go to the runtime.
+        slow.append(jit.branchTest64(CCallHelpers::Zero, A0, T9));
+        slow.append(jit.branchTest64(CCallHelpers::Zero, A1, T9));
+        auto toInt32 = [&](GPRReg value, GPRReg result) {
+            Jump isInt32 = jit.branch64(CCallHelpers::AboveOrEqual, value, T9);
+            jit.add64(T9, value, result);
+            jit.move64ToDouble(result, left);
+            jit.truncateDoubleToInt64(left, result);
+            slow.append(jit.branch64(CCallHelpers::Equal, result, CCallHelpers::TrustedImm64(std::numeric_limits<int64_t>::min())));
+            Jump done = jit.jump();
+            isInt32.link(&jit);
+            jit.move(value, result);
+            done.link(&jit);
+        };
+        constexpr GPRReg first = A4;
+        constexpr GPRReg second = A5;
+        static_assert(noOverlap(first, second, integer, T9));
+        toInt32(A0, first);
+        toInt32(A1, second);
+        switch (kind) {
+        case Binary::BitAnd:
+            jit.and32(first, second, integer);
+            break;
+        case Binary::BitOr:
+            jit.or32(first, second, integer);
+            break;
+        case Binary::BitXor:
+            jit.xor32(first, second, integer);
+            break;
+        case Binary::LShift:
+            jit.lshift32(first, second, integer);
+            break;
+        case Binary::RShift:
+            jit.rshift32(first, second, integer);
+            break;
+        case Binary::URShift:
+            jit.urshift32(first, second, integer);
+            slow.append(jit.branch32(CCallHelpers::LessThan, integer, TrustedImm32(0)));
+            break;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+        boxInt32AndReturn();
+    }
+    if (hasDoubleCase) {
+        slow.append(jit.branchTest64(CCallHelpers::Zero, A0, T9));
+        slow.append(jit.branchTest64(CCallHelpers::Zero, A1, T9));
+        auto toDouble = [&](GPRReg value, FPRReg result) {
+            Jump isInt32 = jit.branch64(CCallHelpers::AboveOrEqual, value, T9);
+            jit.add64(T9, value, integer);
+            jit.move64ToDouble(integer, result);
+            Jump done = jit.jump();
+            isInt32.link(&jit);
+            jit.convertInt32ToDouble(value, result);
+            done.link(&jit);
+        };
+        toDouble(A0, left);
+        toDouble(A1, right);
+        auto compareDoublesAndReturn = [&](CCallHelpers::DoubleCondition condition) {
+            jit.compareDouble(condition, left, right, A0);
+            jit.ret();
+        };
+        switch (kind) {
+        case Binary::Add:
+            jit.addDouble(left, right, left);
+            break;
+        case Binary::Sub:
+            jit.subDouble(left, right, left);
+            break;
+        case Binary::Mul:
+            jit.mulDouble(left, right, left);
+            break;
+        case Binary::Less:
+            compareDoublesAndReturn(CCallHelpers::DoubleLessThanAndOrdered);
+            break;
+        case Binary::LessEq:
+            compareDoublesAndReturn(CCallHelpers::DoubleLessThanOrEqualAndOrdered);
+            break;
+        case Binary::Greater:
+            compareDoublesAndReturn(CCallHelpers::DoubleGreaterThanAndOrdered);
+            break;
+        case Binary::GreaterEq:
+            compareDoublesAndReturn(CCallHelpers::DoubleGreaterThanOrEqualAndOrdered);
+            break;
+        default:
+            RELEASE_ASSERT_NOT_REACHED();
+        }
+        if (!isComparison) {
+            CCallHelpers::JumpList notInt32;
+            jit.branchConvertDoubleToInt32(left, integer, notInt32, right);
+            boxInt32AndReturn();
+            notInt32.link(&jit);
+            jit.moveDoubleTo64(left, A0);
+            jit.sub64(T9, A0);
+            jit.ret();
+        }
+    }
+
+    slow.link(&jit);
+    callBinaryOperation(jit, operation);
+}
+
+static void generateAdd(CCallHelpers& jit) { generateBinary(jit, Binary::Add, Entry::operationAOTValueAdd); }
+static void generateMod(CCallHelpers& jit) { generateBinary(jit, Binary::Mod, Entry::operationAOTValueMod); }
+static void generateSub(CCallHelpers& jit) { generateBinary(jit, Binary::Sub, Entry::operationAOTValueSub); }
+static void generateMul(CCallHelpers& jit) { generateBinary(jit, Binary::Mul, Entry::operationAOTValueMul); }
+static void generateBitAnd(CCallHelpers& jit) { generateBinary(jit, Binary::BitAnd, Entry::operationAOTValueBitAnd); }
+static void generateBitOr(CCallHelpers& jit) { generateBinary(jit, Binary::BitOr, Entry::operationAOTValueBitOr); }
+static void generateBitXor(CCallHelpers& jit) { generateBinary(jit, Binary::BitXor, Entry::operationAOTValueBitXor); }
+static void generateLShift(CCallHelpers& jit) { generateBinary(jit, Binary::LShift, Entry::operationAOTValueLShift); }
+static void generateRShift(CCallHelpers& jit) { generateBinary(jit, Binary::RShift, Entry::operationAOTValueRShift); }
+static void generateURShift(CCallHelpers& jit) { generateBinary(jit, Binary::URShift, Entry::operationAOTValueURShift); }
+static void generateLess(CCallHelpers& jit) { generateBinary(jit, Binary::Less, Entry::operationAOTCompareLess); }
+static void generateLessEq(CCallHelpers& jit) { generateBinary(jit, Binary::LessEq, Entry::operationAOTCompareLessEq); }
+static void generateGreater(CCallHelpers& jit) { generateBinary(jit, Binary::Greater, Entry::operationAOTCompareGreater); }
+static void generateGreaterEq(CCallHelpers& jit) { generateBinary(jit, Binary::GreaterEq, Entry::operationAOTCompareGreaterEq); }
+
+// ---- Elements
+
+// A0 is a cell, and the int32 in A1 did not index into a butterfly. If A0 is a fixed-length typed array and the index is in bounds,
+// leaves the array's JSType in `type`, its storage pointer in `storage` and the zero-extended index in `index`. (ARM64: T13, storage,
+// T12; here the caller's choice, all caller-saved.)
+static void checkTypedArrayAccess(CCallHelpers& jit, GPRReg type, GPRReg storage, GPRReg index, CCallHelpers::JumpList& slow)
+{
+    ASSERT(noOverlap(type, storage, index, A0, A1));
+    jit.load8(Address(A0, JSCell::typeInfoTypeOffset()), type);
+    jit.sub32(type, TrustedImm32(FirstTypedArrayType), storage);
+    slow.append(jit.branch32(CCallHelpers::AboveOrEqual, storage, TrustedImm32(NumberOfTypedArrayTypesExcludingDataView)));
+    slow.append(jit.branchTest8(CCallHelpers::NonZero, Address(A0, JSArrayBufferView::offsetOfMode()), TrustedImm32(isResizableOrGrowableSharedMode)));
+    jit.zeroExtend32ToWord(A1, index);
+    // A detached array has length zero.
+    jit.loadPtr(Address(A0, JSArrayBufferView::offsetOfLength()), storage);
+    slow.append(jit.branchPtr(CCallHelpers::AboveOrEqual, index, storage));
+    jit.loadPtr(Address(A0, JSArrayBufferView::offsetOfVector()), storage);
+}
+
+// Execution falls through into the next stub. (The padding that the assembler inserts to align a stub is not executable: it traps.)
+static void goOnIntoNextStub(CCallHelpers& jit)
+{
+    while (jit.m_assembler.codeSize() % 16)
+        jit.nop();
+}
+
+// Boxes the integer in A1. Temporaries: T9, A5 (ARM64: T11), which neither stub that comes here takes an operand in.
+static void boxIntegerInA1(CCallHelpers& jit)
+{
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NumberTag), T9);
+    jit.signExtend32ToPtr(A1, A5);
+    Jump isInt32 = jit.branch64(CCallHelpers::Equal, A1, A5);
+    jit.convertInt64ToDouble(A1, FPRInfo::fpRegT0);
+    jit.moveDoubleTo64(FPRInfo::fpRegT0, A1);
+    jit.sub64(T9, A1);
+    Jump done = jit.jump();
+    isInt32.link(&jit);
+    jit.zeroExtend32ToWord(A1, A1);
+    jit.or64(T9, A1);
+    done.link(&jit);
+}
+
+// A0 = base, A1 = an unboxed integer index. Falls through to GetByVal for what it does not handle.
+static void generateGetByValAtIndex(CCallHelpers& jit)
+{
+    static_assert(static_cast<unsigned>(Stub::GetByValAtIndex) + 1 == static_cast<unsigned>(Stub::GetByVal));
+    constexpr GPRReg shape = A3;
+    // Light (stubPreservesCalleeSaves()): A2 and A4 where ARM64 has T11 and T10.
+    constexpr GPRReg butterfly = A2;
+    constexpr GPRReg length = A4;
+    CCallHelpers::JumpList otherwise;
+    otherwise.append(jit.branchIfNotCell(A0));
+    jit.load8(Address(A0, JSCell::indexingTypeAndMiscOffset()), shape);
+    jit.and32(TrustedImm32(IndexingShapeMask), shape);
+    Jump contiguousCase = jit.branch32(CCallHelpers::Equal, shape, TrustedImm32(ContiguousShape));
+    otherwise.append(jit.branch32(CCallHelpers::NotEqual, shape, TrustedImm32(Int32Shape)));
+    contiguousCase.link(&jit);
+    jit.loadPtr(Address(A0, JSObject::butterflyOffset()), butterfly);
+    jit.load32(Address(butterfly, Butterfly::offsetOfPublicLength()), length);
+    // A negative index compares as larger than any length.
+    otherwise.append(jit.branch64(CCallHelpers::AboveOrEqual, A1, length));
+    jit.load64(CCallHelpers::BaseIndex(butterfly, A1, CCallHelpers::TimesEight), butterfly);
+    otherwise.append(jit.branchTest64(CCallHelpers::Zero, butterfly));
+    jit.move(butterfly, A0);
+    jit.ret();
+
+    otherwise.link(&jit);
+    boxIntegerInA1(jit);
+    goOnIntoNextStub(jit);
+}
+
+// A0 = base, A1 = property. Result in A0. TODO(x86-aot-port): a property name in the megamorphic cache, as on ARM64.
+static void generateGetByVal(CCallHelpers& jit)
+{
+    constexpr FPRReg number = FPRInfo::fpRegT0;
+    // Light (stubPreservesCalleeSaves()): A4 and A2 where ARM64 has T12 and T11.
+    constexpr GPRReg index = A4;
+    constexpr GPRReg storage = A2;
+    constexpr GPRReg type = A3;
+    CCallHelpers::JumpList slow;
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NumberTag), T9);
+    Jump notInt32 = jit.branch64(CCallHelpers::Below, A1, T9);
+    CCallHelpers::Label haveIndex = jit.label();
+    slow.append(jit.branchIfNotCell(A0));
+    jit.load8(Address(A0, JSCell::indexingTypeAndMiscOffset()), type);
+    jit.and32(TrustedImm32(IndexingShapeMask), type);
+    Jump noButterfly = jit.branchTest32(CCallHelpers::Zero, type);
+    jit.loadPtr(Address(A0, JSObject::butterflyOffset()), storage);
+    jit.zeroExtend32ToWord(A1, index);
+    Jump doubleCase = jit.branch32(CCallHelpers::Equal, type, TrustedImm32(DoubleShape));
+    slow.append(jit.branch32(CCallHelpers::Above, type, TrustedImm32(ContiguousShape)));
+    static_assert(Int32Shape < DoubleShape && DoubleShape < ContiguousShape);
+    slow.append(jit.branch32(CCallHelpers::Below, type, TrustedImm32(Int32Shape)));
+
+    // An in-bounds, non-hole element in storage that holds JSValues.
+    slow.append(jit.branch32(CCallHelpers::AboveOrEqual, index, Address(storage, Butterfly::offsetOfPublicLength())));
+    jit.load64(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesEight), storage);
+    slow.append(jit.branchTest64(CCallHelpers::Zero, storage));
+    jit.move(storage, A0);
+    jit.ret();
+
+    auto boxInt32AndReturn = [&] {
+        jit.or64(T9, storage, A0);
+        jit.ret();
+    };
+    auto boxDoubleAndReturn = [&] {
+        jit.moveDoubleTo64(number, A0);
+        jit.sub64(T9, A0);
+        jit.ret();
+    };
+
+    // A hole is represented as NaN.
+    doubleCase.link(&jit);
+    slow.append(jit.branch32(CCallHelpers::AboveOrEqual, index, Address(storage, Butterfly::offsetOfPublicLength())));
+    jit.loadDouble(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesEight), number);
+    slow.append(jit.branchIfNaN(number));
+    boxDoubleAndReturn();
+
+    noButterfly.link(&jit);
+    // A character of a string, if it has a VM-wide single-character string.
+    Jump notString = jit.branchIfNotString(A0);
+    jit.loadPtr(Address(A0, JSString::offsetOfValue()), storage);
+    slow.append(jit.branchIfRopeStringImpl(storage));
+    jit.zeroExtend32ToWord(A1, index);
+    slow.append(jit.branch32(CCallHelpers::AboveOrEqual, index, Address(storage, StringImpl::lengthMemoryOffset())));
+    jit.load32(Address(storage, StringImpl::flagsOffset()), type);
+    jit.loadPtr(Address(storage, StringImpl::dataOffset()), storage);
+    Jump is16Bit = jit.branchTest32(CCallHelpers::Zero, type, TrustedImm32(StringImpl::flagIs8Bit()));
+    jit.load8(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesOne), storage);
+    Jump haveCharacter = jit.jump();
+    is16Bit.link(&jit);
+    jit.load16(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesTwo), storage);
+    slow.append(jit.branch32(CCallHelpers::Above, storage, TrustedImm32(maxSingleCharacterString)));
+    haveCharacter.link(&jit);
+    loadInstance(jit, index);
+    jit.loadPtr(Address(index, Instance::offsetOfVM()), index);
+    jit.addPtr(TrustedImm32(OBJECT_OFFSETOF(VM, smallStrings) + SmallStrings::offsetOfSingleCharacterStrings()), index);
+    jit.loadPtr(CCallHelpers::BaseIndex(index, storage, CCallHelpers::TimesEight), A0);
+    jit.ret();
+
+    notString.link(&jit);
+    checkTypedArrayAccess(jit, type, storage, index, slow);
+    auto ofType = [&](JSType jsType, const auto& load) {
+        Jump other = jit.branch32(CCallHelpers::NotEqual, type, TrustedImm32(jsType));
+        load();
+        other.link(&jit);
+    };
+    ofType(Int32ArrayType, [&] {
+        jit.load32(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesFour), storage);
+        boxInt32AndReturn();
+    });
+    ofType(Uint8ArrayType, [&] {
+        jit.load8(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesOne), storage);
+        boxInt32AndReturn();
+    });
+    ofType(Float64ArrayType, [&] {
+        jit.loadDouble(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesEight), number);
+        jit.purifyNaN(number, number);
+        boxDoubleAndReturn();
+    });
+    ofType(Uint8ClampedArrayType, [&] {
+        jit.load8(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesOne), storage);
+        boxInt32AndReturn();
+    });
+    ofType(Uint16ArrayType, [&] {
+        jit.load16(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesTwo), storage);
+        boxInt32AndReturn();
+    });
+    ofType(Int16ArrayType, [&] {
+        jit.load16SignedExtendTo32(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesTwo), storage);
+        jit.zeroExtend32ToWord(storage, storage);
+        boxInt32AndReturn();
+    });
+    ofType(Int8ArrayType, [&] {
+        jit.load8SignedExtendTo32(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesOne), storage);
+        jit.zeroExtend32ToWord(storage, storage);
+        boxInt32AndReturn();
+    });
+    ofType(Uint32ArrayType, [&] {
+        jit.load32(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesFour), storage);
+        Jump isInt32 = jit.branch32(CCallHelpers::GreaterThanOrEqual, storage, TrustedImm32(0));
+        jit.convertInt64ToDouble(storage, number);
+        boxDoubleAndReturn();
+        isInt32.link(&jit);
+        boxInt32AndReturn();
+    });
+    ofType(Float32ArrayType, [&] {
+        jit.loadFloat(CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesFour), number);
+        jit.convertFloatToDouble(number, number);
+        jit.purifyNaN(number, number);
+        boxDoubleAndReturn();
+    });
+    slow.append(jit.jump());
+
+    // A double with an integral value names the same property as the integer. So does -0.
+    notInt32.link(&jit);
+    slow.append(jit.branchTest64(CCallHelpers::Zero, A1, T9));
+    jit.add64(T9, A1, storage);
+    jit.move64ToDouble(storage, number);
+    jit.branchConvertDoubleToInt32(number, storage, slow, FPRInfo::fpRegT1, false);
+    jit.or64(T9, storage, A1);
+    jit.jump().linkTo(haveIndex, &jit);
+
+    slow.link(&jit);
+    callBinaryOperation(jit, Entry::operationAOTGetByVal);
+}
+
+// A0 = base, A1 = an unboxed integer index, A2 = value, A3 = whether the code is strict. Falls through to PutByVal.
+static void generatePutByValAtIndex(CCallHelpers& jit)
+{
+    static_assert(static_cast<unsigned>(Stub::PutByValAtIndex) + 1 == static_cast<unsigned>(Stub::PutByVal));
+    boxIntegerInA1(jit);
+    goOnIntoNextStub(jit);
+}
+
+// Calls operation(globalObject, A0, A1, A2, A3). Only caller-saved registers (A5 where ARM64 has T11).
+static void callElementOperation(CCallHelpers& jit, Entry operation)
+{
+    loadInstance(jit, A5);
+    jit.move(A3, A4);
+    jit.move(A2, A3);
+    jit.move(A1, A2);
+    jit.move(A0, A1);
+    jit.loadPtr(Address(A5, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(A5, Instance::offsetOfRuntimeTable()), A5);
+    jit.loadPtr(Address(A5, static_cast<unsigned>(operation) * sizeof(void*)), A5);
+    callAndCheckException(jit, A5, Returns::Void);
+}
+
+// A0 = base, A1 = property, A2 = value, A3 = whether the code is strict.
+static void generatePutByVal(CCallHelpers& jit)
+{
+    // Light (stubPreservesCalleeSaves()): the storage in rax (thisGPR, which an element store has nothing to do with) where ARM64
+    // has T11, the index in A5.
+    constexpr GPRReg index = A5;
+    constexpr GPRReg type = A4;
+    constexpr GPRReg storage = X86Registers::eax;
+    // An element within the capacity of contiguous storage that is not copy-on-write.
+    CCallHelpers::JumpList slow;
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NumberTag), T9);
+    slow.append(jit.branch64(CCallHelpers::Below, A1, T9));
+    slow.append(jit.branchIfNotCell(A0));
+    jit.load8(Address(A0, JSCell::indexingTypeAndMiscOffset()), storage);
+    jit.and32(TrustedImm32(IndexingShapeMask | CopyOnWrite), storage);
+    Jump isContiguous = jit.branch32(CCallHelpers::Equal, storage, TrustedImm32(ContiguousShape));
+    slow.append(jit.branchTest32(CCallHelpers::NonZero, storage));
+
+    // A typed array, and a number that only needs truncation.
+    {
+        constexpr FPRReg number = FPRInfo::fpRegT0;
+        checkTypedArrayAccess(jit, type, storage, index, slow);
+        Jump valueIsNotInt32 = jit.branch64(CCallHelpers::Below, A2, T9);
+        auto ofType = [&](JSType jsType, const auto& store) {
+            Jump other = jit.branch32(CCallHelpers::NotEqual, type, TrustedImm32(jsType));
+            store();
+            jit.ret();
+            other.link(&jit);
+        };
+        auto store32 = [&] { jit.store32(A2, CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesFour)); };
+        auto store16 = [&] { jit.store16(A2, CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesTwo)); };
+        auto store8 = [&] { jit.store8(A2, CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesOne)); };
+        auto storeDouble = [&] { jit.storeDouble(number, CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesEight)); };
+        auto storeFloat = [&] {
+            jit.convertDoubleToFloat(number, number);
+            jit.storeFloat(number, CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesFour));
+        };
+        ofType(Int32ArrayType, store32);
+        ofType(Uint8ArrayType, store8);
+        ofType(Uint32ArrayType, store32);
+        ofType(Uint16ArrayType, store16);
+        ofType(Int16ArrayType, store16);
+        ofType(Int8ArrayType, store8);
+        jit.convertInt32ToDouble(A2, number);
+        ofType(Float64ArrayType, storeDouble);
+        ofType(Float32ArrayType, storeFloat);
+        slow.append(jit.jump());
+
+        valueIsNotInt32.link(&jit);
+        slow.append(jit.branchTest64(CCallHelpers::Zero, A2, T9));
+        // (A5 holds the index: the double's bits go through the scratch register, which neither instruction uses.)
+        jit.add64(T9, A2, scratchGPR);
+        jit.move64ToDouble(scratchGPR, number);
+        ofType(Float64ArrayType, storeDouble);
+        ofType(Float32ArrayType, storeFloat);
+        slow.append(jit.jump());
+    }
+
+    isContiguous.link(&jit);
+    jit.loadPtr(Address(A0, JSObject::butterflyOffset()), storage);
+    jit.zeroExtend32ToWord(A1, index);
+    Jump inBounds = jit.branch32(CCallHelpers::Below, index, Address(storage, Butterfly::offsetOfPublicLength()));
+    slow.append(jit.branch32(CCallHelpers::AboveOrEqual, index, Address(storage, Butterfly::offsetOfVectorLength())));
+    // The slots between the old length and this index are already holes.
+    jit.add32(TrustedImm32(1), index, type);
+    jit.store32(type, Address(storage, Butterfly::offsetOfPublicLength()));
+    inBounds.link(&jit);
+    jit.store64(A2, CCallHelpers::BaseIndex(storage, index, CCallHelpers::TimesEight));
+
+    Jump notCell = jit.branchIfNotCell(A2);
+    loadInstance(jit, T9);
+    returnAfterBarrier(jit);
+    notCell.link(&jit);
+    jit.ret();
+
+    slow.link(&jit);
+    callElementOperation(jit, Entry::operationAOTPutByVal);
+}
+
+// The same, for op_put_by_val_direct. The base is an object.
+static void generatePutByValDirect(CCallHelpers& jit)
+{
+    // Light (stubPreservesCalleeSaves()): A5 and rax where ARM64 has T10 and T11.
+    constexpr GPRReg index = A5;
+    constexpr GPRReg butterfly = X86Registers::eax;
+    // An element of an array with JSValue storage that is not copy-on-write, within its capacity. Usually an append.
+    CCallHelpers::JumpList slow;
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NumberTag), T9);
+    slow.append(jit.branch64(CCallHelpers::Below, A1, T9));
+    jit.load8(Address(A0, JSCell::indexingTypeAndMiscOffset()), butterfly);
+    jit.and32(TrustedImm32(IsArray | IndexingShapeMask | CopyOnWrite), butterfly);
+    slow.append(jit.branch32(CCallHelpers::NotEqual, butterfly, TrustedImm32(ArrayWithContiguous)));
+    jit.loadPtr(Address(A0, JSObject::butterflyOffset()), butterfly);
+    jit.zeroExtend32ToWord(A1, index);
+    slow.append(jit.branch32(CCallHelpers::AboveOrEqual, index, Address(butterfly, Butterfly::offsetOfVectorLength())));
+    jit.store64(A2, CCallHelpers::BaseIndex(butterfly, index, CCallHelpers::TimesEight));
+    Jump isWithinLength = jit.branch32(CCallHelpers::Below, index, Address(butterfly, Butterfly::offsetOfPublicLength()));
+    jit.add32(TrustedImm32(1), index, A4);
+    jit.store32(A4, Address(butterfly, Butterfly::offsetOfPublicLength()));
+    isWithinLength.link(&jit);
+
+    Jump notCell = jit.branchIfNotCell(A2);
+    loadInstance(jit, T9);
+    returnAfterBarrier(jit);
+    notCell.link(&jit);
+    jit.ret();
+
+    slow.link(&jit);
+    callElementOperation(jit, Entry::operationAOTPutByValDirect);
+}
+
+// A0 = base, A1 = site, whose identifier is WellKnownIdentifier::Length. Result in A0.
+static void generateGetLength(CCallHelpers& jit)
+{
+    constexpr GPRReg t = A2; // Light (stubPreservesCalleeSaves()): A2 where ARM64 has T11.
+    CCallHelpers::JumpList generic;
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NumberTag), T9);
+    generic.append(jit.branchIfNotCell(A0));
+
+    // An array with a butterfly stores its length there. A length that does not fit in an int32 goes to the runtime.
+    jit.load8(Address(A0, JSCell::indexingTypeAndMiscOffset()), t);
+    Jump notArray = jit.branchTest32(CCallHelpers::Zero, t, TrustedImm32(IsArray));
+    Jump noStorage = jit.branchTest32(CCallHelpers::Zero, t, TrustedImm32(IndexingShapeMask));
+    jit.loadPtr(Address(A0, JSObject::butterflyOffset()), t);
+    jit.load32(Address(t, Butterfly::offsetOfPublicLength()), t);
+    generic.append(jit.branch32(CCallHelpers::LessThan, t, TrustedImm32(0)));
+    jit.or64(T9, t, A0);
+    jit.ret();
+
+    notArray.link(&jit);
+    noStorage.link(&jit);
+    generic.append(jit.branchIfNotType(A0, StringType));
+    jit.loadPtr(Address(A0, JSString::offsetOfValue()), t);
+    Jump isRope = jit.branchIfRopeStringImpl(t);
+    jit.load32(Address(t, StringImpl::lengthMemoryOffset()), t);
+    jit.or64(T9, t, A0);
+    jit.ret();
+    isRope.link(&jit);
+    jit.load32(Address(A0, JSRopeString::offsetOfLength()), t);
+    jit.or64(T9, t, A0);
+    jit.ret();
+
+    generic.link(&jit);
+    generateGetByIdWith(jit, Entry::operationAOTGetByIdWellKnown);
+}
+
+// ---- Calls with arguments in memory
+
+// See Stub::CallList: argumentGPR(0) = count, argumentGPR(1) = the address of the arguments.
+static void generateCallListTo(CCallHelpers& jit, CodeSpecializationKind kind)
+{
+    CCallHelpers::JumpList slowCase;
+    findCodeOfCallee(jit, kind, slowCase);
+    Jump takesRegisters = jit.branchTest64(CCallHelpers::Zero, T12, CCallHelpers::TrustedImm64(1LL << EntryWord::bitOfIsList));
+    jit.and64(CCallHelpers::TrustedImm64(static_cast<int64_t>(EntryWord::addressMask)), T12);
+    jit.move(T12, scratchGPR);
+    restoreTagRegisters(jit);
+    jit.farJump(scratchGPR, JSEntryPtrTag);
+
+    takesRegisters.link(&jit);
+    jit.and64(CCallHelpers::TrustedImm64(static_cast<int64_t>(EntryWord::addressMask)), T12);
+    jit.move(argumentGPR(0), countGPR);
+    jit.move(argumentGPR(1), T13);
+    Jump noMore[numberOfArgumentGPRs];
+    for (unsigned i = 0; i < numberOfArgumentGPRs; ++i) {
+        noMore[i] = jit.branch32(CCallHelpers::BelowOrEqual, countGPR, TrustedImm32(i));
+        jit.load64(Address(T13, i * sizeof(Register)), argumentGPR(i));
+    }
+    CCallHelpers::Label enter = jit.label();
+    jit.move(T12, scratchGPR);
+    restoreTagRegisters(jit);
+    jit.farJump(scratchGPR, JSEntryPtrTag);
+    for (unsigned i = 0; i < numberOfArgumentGPRs; ++i) {
+        noMore[i].link(&jit);
+        jit.move(CCallHelpers::TrustedImm64(JSValue::ValueUndefined), argumentGPR(i));
+    }
+    jit.jump().linkTo(enter, &jit);
+
+    slowCase.link(&jit);
+    restoreTagRegisters(jit);
+    constexpr GPRReg list = A2;
+    constexpr GPRReg frame = T11;
+    constexpr GPRReg t = A3;
+    jit.emitFunctionPrologue();
+    jit.move(argumentGPR(1), list);
+    jit.move(argumentGPR(0), countGPR);
+    static_assert(stackAlignmentRegisters() == 2);
+    jit.add32(TrustedImm32(CallFrame::headerSizeInRegisters - CallerFrameAndPC::sizeInRegisters + 1 + 1), countGPR, frame);
+    jit.and32(TrustedImm32(~1), frame);
+    jit.lshiftPtr(TrustedImm32(3), frame);
+    jit.negPtr(frame);
+    jit.addPtr(CCallHelpers::stackPointerRegister, frame);
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfVM()), t);
+    Jump overflow = jit.branchPtr(CCallHelpers::Above, Address(t, VM::offsetOfSoftStackLimit()), frame);
+    Jump wrapped = jit.branchPtr(CCallHelpers::Above, frame, GPRInfo::callFrameRegister);
+    jit.move(frame, CCallHelpers::stackPointerRegister);
+    jit.store64(calleeGPR, slotOfFrameOfNextCall(CallFrameSlot::callee));
+    jit.add32(TrustedImm32(1), countGPR, frame);
+    jit.store64(frame, slotOfFrameOfNextCall(CallFrameSlot::argumentCountIncludingThis));
+    jit.store64(thisGPR, slotOfFrameOfNextCall(CallFrameSlot::thisArgument));
+    jit.addPtr(TrustedImm32(slotOfFrameOfNextCall(CallFrameSlot::thisArgument, sizeof(Register)).offset), CCallHelpers::stackPointerRegister, frame);
+    Jump none = jit.branchTest32(CCallHelpers::Zero, countGPR);
+    CCallHelpers::Label next = jit.label();
+    jit.sub32(TrustedImm32(1), countGPR);
+    jit.load64(CCallHelpers::BaseIndex(list, countGPR, CCallHelpers::TimesEight), t);
+    jit.store64(t, CCallHelpers::BaseIndex(frame, countGPR, CCallHelpers::TimesEight));
+    jit.branchTest32(CCallHelpers::NonZero, countGPR).linkTo(next, &jit);
+    none.link(&jit);
+    callTheWayTheEngineDoes(jit, kind);
+
+    overflow.link(&jit);
+    wrapped.link(&jit);
+    jit.emitFunctionEpilogue();
+    throwStackOverflow(jit);
+}
+static void generateCallList(CCallHelpers& jit) { generateCallListTo(jit, CodeSpecializationKind::CodeForCall); }
+static void generateConstructList(CCallHelpers& jit) { generateCallListTo(jit, CodeSpecializationKind::CodeForConstruct); }
+
+static CCallHelpers::Label s_callVarargsReturnAddress;
+static CCallHelpers::Label s_whereCallVarargsIsReturnedTo;
+
+// See Stub::CallVarargs.
+static void generateCallVarargsTo(CCallHelpers& jit, CodeSpecializationKind kind, bool inTailPosition = false)
+{
+    constexpr ptrdiff_t offsetOfCallee = -8;
+    constexpr ptrdiff_t offsetOfThis = -16;
+    constexpr ptrdiff_t offsetOfList = -24;
+    constexpr ptrdiff_t offsetOfFirst = -32;
+    constexpr ptrdiff_t offsetOfLength = -40;
+    auto local = [](ptrdiff_t offset) { return Address(GPRInfo::callFrameRegister, offset); };
+    auto callOperation = [&](Entry operation) {
+        jit.loadPtr(Address(instanceGPR, Instance::offsetOfGlobalObject()), A0);
+        jit.loadPtr(Address(instanceGPR, Instance::offsetOfRuntimeTable()), T11);
+        jit.loadPtr(Address(T11, static_cast<unsigned>(operation) * sizeof(void*)), T11);
+        jit.call(T11, OperationPtrTag);
+    };
+    CCallHelpers::JumpList exception;
+
+    jit.emitFunctionPrologue();
+    jit.subPtr(TrustedImm32(48), CCallHelpers::stackPointerRegister);
+    jit.store64(calleeGPR, local(offsetOfCallee));
+    jit.store64(thisGPR, local(offsetOfThis));
+    jit.store64(argumentGPR(0), local(offsetOfList));
+    jit.store64(argumentGPR(1), local(offsetOfFirst));
+
+    // operation(globalObject, list, first) returns the number of arguments.
+    jit.move(argumentGPR(1), A2);
+    jit.move(argumentGPR(0), A1);
+    callOperation(Entry::operationAOTSizeOfVarargs);
+    exception.append(jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR2));
+    jit.store64(GPRInfo::returnValueGPR, local(offsetOfLength));
+
+    static_assert(stackAlignmentRegisters() == 2);
+    jit.add32(TrustedImm32(1), GPRInfo::returnValueGPR, T11);
+    jit.and32(TrustedImm32(~1), T11);
+    jit.lshiftPtr(TrustedImm32(3), T11);
+    jit.negPtr(T11);
+    jit.addPtr(CCallHelpers::stackPointerRegister, T11);
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfVM()), T10);
+    Jump overflow = jit.branchPtr(CCallHelpers::Above, Address(T10, VM::offsetOfSoftStackLimit()), T11);
+    Jump wrapped = jit.branchPtr(CCallHelpers::Above, T11, GPRInfo::callFrameRegister);
+    jit.move(T11, CCallHelpers::stackPointerRegister);
+
+    // operation(globalObject, destination, list, first, count)
+    jit.move(CCallHelpers::stackPointerRegister, A1);
+    jit.load64(local(offsetOfList), A2);
+    jit.load64(local(offsetOfFirst), A3);
+    jit.load64(local(offsetOfLength), A4);
+    callOperation(Entry::operationAOTLoadVarargs);
+    exception.append(jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR));
+
+    jit.load64(local(offsetOfCallee), calleeGPR);
+    jit.load64(local(offsetOfThis), thisGPR);
+    jit.load64(local(offsetOfLength), argumentGPR(0));
+    jit.move(CCallHelpers::stackPointerRegister, argumentGPR(1));
+    if (inTailPosition) {
+        // The arguments are moved over the frame of the function that called this stub, directly below that frame's header, which
+        // doubles as the header of this stub's frame. If that function was itself called from such a stub frame, that frame is
+        // overwritten too.
+        constexpr GPRReg length = A0;
+        constexpr GPRReg to = A1;
+        constexpr GPRReg from = A2;
+        constexpr GPRReg frame = A3;
+        constexpr GPRReg t1 = A4;
+        constexpr GPRReg t2 = A5;
+        constexpr GPRReg returnsTo = T11;
+        static_assert(length == argumentGPR(0) && to == argumentGPR(1));
+        jit.move(argumentGPR(1), from);
+        jit.loadPtr(Address(GPRInfo::callFrameRegister), frame);
+        loadAddressOfLabel(jit, s_whereCallVarargsIsReturnedTo, returnsTo);
+        CCallHelpers::Label again = jit.label();
+        jit.loadPtr(Address(frame, sizeof(void*)), t1);
+        Jump isNotOfThisStub = jit.branchPtr(CCallHelpers::NotEqual, t1, returnsTo);
+        jit.loadPtr(Address(frame), frame);
+        jit.jump().linkTo(again, &jit);
+        isNotOfThisStub.link(&jit);
+        jit.move(length, t1);
+        jit.add64(TrustedImm32(1), t1);
+        jit.and64(TrustedImm32(~1), t1);
+        jit.lshift64(TrustedImm32(3), t1);
+        jit.move(frame, to);
+        jit.sub64(t1, to);
+        // The destination is higher, so copy the last word first.
+        jit.move(length, t1);
+        Jump none = jit.branchTest64(CCallHelpers::Zero, t1);
+        CCallHelpers::Label next = jit.label();
+        jit.sub64(TrustedImm32(1), t1);
+        jit.load64(CCallHelpers::BaseIndex(from, t1, CCallHelpers::TimesEight), t2);
+        jit.store64(t2, CCallHelpers::BaseIndex(to, t1, CCallHelpers::TimesEight));
+        jit.branchTest64(CCallHelpers::NonZero, t1).linkTo(next, &jit);
+        none.link(&jit);
+        jit.move(frame, GPRInfo::callFrameRegister);
+        jit.move(to, CCallHelpers::stackPointerRegister);
+        jit.jump().linkTo(s_callVarargsReturnAddress, &jit);
+    } else {
+        if (kind == CodeSpecializationKind::CodeForCall)
+            s_callVarargsReturnAddress = jit.label();
+        callStubFromStub(jit, kind == CodeSpecializationKind::CodeForCall ? Stub::CallList : Stub::ConstructList);
+        if (kind == CodeSpecializationKind::CodeForCall)
+            s_whereCallVarargsIsReturnedTo = jit.label();
+        jit.emitFunctionEpilogue();
+        jit.ret();
+    }
+
+    exception.link(&jit);
+    jit.emitFunctionEpilogue();
+    generateHandleException(jit);
+
+    overflow.link(&jit);
+    wrapped.link(&jit);
+    jit.emitFunctionEpilogue();
+    throwStackOverflow(jit);
+}
+static void generateCallVarargs(CCallHelpers& jit) { generateCallVarargsTo(jit, CodeSpecializationKind::CodeForCall); }
+static void generateConstructVarargs(CCallHelpers& jit) { generateCallVarargsTo(jit, CodeSpecializationKind::CodeForConstruct); }
+static void generateTailCallVarargs(CCallHelpers& jit) { generateCallVarargsTo(jit, CodeSpecializationKind::CodeForCall, true); }
+
+// ---- Iteration
+
+// Runs in the stub's own frame. A0 = an object, A1 = a slot for the named property. Leaves the property's value in A0.
+static void getWellKnownInFrameOfStub(CCallHelpers& jit, WellKnownIdentifier identifier, CCallHelpers::JumpList& exception)
+{
+    jit.load64(slotWord(A1, 0), T11);
+    jit.load32(Address(A0, JSCell::structureIDOffset()), T10);
+    Jump isOfAnotherStructure = jit.branch32(CCallHelpers::NotEqual, T11, T10);
+    Jump isIndirect = jit.branchTest64(CCallHelpers::NonZero, T11, CCallHelpers::TrustedImm64(static_cast<int64_t>(Slot::isIndirect) << 32));
+    jit.urshift64(TrustedImm32(32), T11);
+    jit.and32(TrustedImm32(Slot::directLocationMask), T11);
+    jit.load64(CCallHelpers::BaseIndex(A0, T11, CCallHelpers::TimesEight), A0);
+    Jump found = jit.jump();
+
+    isOfAnotherStructure.link(&jit);
+    isIndirect.link(&jit);
+    jit.move(A1, A3);
+    jit.move(A0, A1);
+    jit.move(TrustedImm32(static_cast<uint32_t>(identifier)), A2);
+    loadInstance(jit, T11);
+    jit.loadPtr(Address(T11, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(T11, Instance::offsetOfRuntimeTable()), T11);
+    jit.loadPtr(Address(T11, static_cast<unsigned>(Entry::operationAOTGetByIdWellKnown) * sizeof(void*)), T11);
+    jit.call(T11, OperationPtrTag);
+    exception.append(jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR2));
+    jit.move(GPRInfo::returnValueGPR, A0);
+    found.link(&jit);
+}
+
+// Also runs in the stub's own frame. Calls calleeGPR with thisGPR as `this` and no arguments, checks that the result is an object,
+// and leaves it in A0.
+static void callForObjectInFrameOfStub(CCallHelpers& jit, CCallHelpers::JumpList& notObject)
+{
+    jit.move(TrustedImm32(0), countGPR);
+    callStubFromStub(jit, Stub::Call);
+    jit.move(GPRInfo::returnValueGPR, A0);
+    notObject.append(jit.branchIfNotCell(A0));
+    notObject.append(jit.branchIfNotObject(A0));
+}
+
+// The failure paths of the two helpers above. Still in the stub's frame.
+static void throwFromFrameOfStub(CCallHelpers& jit, CCallHelpers::JumpList& notObject, CCallHelpers::JumpList& exception)
+{
+    notObject.link(&jit);
+    loadInstance(jit, T11);
+    jit.loadPtr(Address(T11, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(T11, Instance::offsetOfRuntimeTable()), T11);
+    jit.loadPtr(Address(T11, static_cast<unsigned>(Entry::operationAOTThrowIteratorResultIsNotObject) * sizeof(void*)), T11);
+    jit.call(T11, OperationPtrTag);
+    exception.link(&jit);
+    jit.emitFunctionEpilogue();
+    loadInstance(jit, T9);
+    jumpToEntry(jit, T9, Entry::HandleException);
+}
+
+// A0 = next, A1 = iterator, A2 = iterable, as in op_iterator_next. A3 = two consecutive slots, for `done` and `value`. Returns
+// A0 = done, A1 = value, A2 = next.
+static void generateIteratorNext(CCallHelpers& jit)
+{
+    CCallHelpers::JumpList generic;
+    CCallHelpers::JumpList indexSlow;
+    // value: the result of a fast-path operation, which is empty at the end of the iteration. Leaves `done` in A0.
+    auto doneIfEmpty = [&](GPRReg value) {
+        static_assert(JSValue::ValueTrue == JSValue::ValueFalse + 1);
+        jit.compare64(CCallHelpers::Equal, value, TrustedImm32(0), A0);
+        jit.add64(TrustedImm32(JSValue::ValueFalse), A0);
+    };
+    // Calls the operation with a stack word that survives the call, initialized to `kept`.
+    auto callKeeping = [&](Entry operation, GPRReg kept, const auto& setUp) {
+        jit.emitFunctionPrologue();
+        jit.subPtr(TrustedImm32(16), CCallHelpers::stackPointerRegister);
+        jit.store64(kept, Address(CCallHelpers::stackPointerRegister));
+        loadInstance(jit, T11);
+        setUp();
+        jit.loadPtr(Address(T11, Instance::offsetOfGlobalObject()), A0);
+        jit.loadPtr(Address(T11, Instance::offsetOfRuntimeTable()), T11);
+        jit.loadPtr(Address(T11, static_cast<unsigned>(operation) * sizeof(void*)), T11);
+        jit.call(T11, OperationPtrTag);
+        // (rdx is both the second result, which says whether there was an exception, and A2: it is looked at first.)
+        static_assert(GPRInfo::returnValueGPR2 == A2);
+        jit.move(GPRInfo::returnValueGPR2, T9);
+        jit.load64(Address(CCallHelpers::stackPointerRegister), A2);
+        jit.emitFunctionEpilogue();
+        Jump exception = jit.branchTestPtr(CCallHelpers::NonZero, T9);
+        jit.move(GPRInfo::returnValueGPR, A1);
+        doneIfEmpty(A1);
+        jit.ret();
+        exception.link(&jit);
+        loadInstance(jit, T9);
+        jumpToEntry(jit, T9, Entry::HandleException);
+    };
+
+    Jump nextIsCell = jit.branchIfCell(A0);
+
+    // Only in this case may `iterator` be a sentinel rather than an object: `iterable` is then an array and `next` the index to
+    // visit.
+    generic.append(jit.branchIfNotCell(A1));
+    generic.append(jit.branchIfNotType(A1, SentinelType));
+
+    jit.move(CCallHelpers::TrustedImm64(JSValue::NumberTag), T9);
+    indexSlow.append(jit.branch64(CCallHelpers::Below, A0, T9));
+    indexSlow.append(jit.branchIfNotCell(A2));
+    indexSlow.append(jit.branchIfNotType(A2, ArrayType));
+    jit.load8(Address(A2, JSCell::indexingTypeAndMiscOffset()), T11);
+    jit.and32(TrustedImm32(IndexingShapeMask), T11);
+    Jump isInt32Shape = jit.branch32(CCallHelpers::Equal, T11, TrustedImm32(Int32Shape));
+    indexSlow.append(jit.branch32(CCallHelpers::NotEqual, T11, TrustedImm32(ContiguousShape)));
+    isInt32Shape.link(&jit);
+    jit.loadPtr(Address(A2, JSObject::butterflyOffset()), T11);
+    jit.load32(Address(T11, Butterfly::offsetOfPublicLength()), T10);
+    // Unsigned comparison: the index of a finished iteration, -1, exceeds any length.
+    indexSlow.append(jit.branch32(CCallHelpers::AboveOrEqual, A0, T10));
+    indexSlow.append(jit.branch32(CCallHelpers::Equal, A0, TrustedImm32(std::numeric_limits<int32_t>::max())));
+    jit.zeroExtend32ToWord(A0, T10);
+    jit.load64(CCallHelpers::BaseIndex(T11, T10, CCallHelpers::TimesEight), T11);
+    indexSlow.append(jit.branchTest64(CCallHelpers::Zero, T11));
+    jit.move(T11, A1);
+    jit.add32(TrustedImm32(1), T10);
+    jit.or64(T9, T10, A2);
+    jit.move(TrustedImm32(JSValue::ValueFalse), A0);
+    jit.ret();
+
+    indexSlow.link(&jit);
+    callKeeping(Entry::operationAOTIteratorNextWithIndex, A0, [&] {
+        jit.move(A2, A1);
+        jit.move(CCallHelpers::stackPointerRegister, A2);
+    });
+
+    nextIsCell.link(&jit);
+    generic.append(jit.branchIfNotType(A0, SentinelType));
+    callKeeping(Entry::operationAOTIteratorNextTryFast, A0, [&] { });
+
+    // Generic case. result = next.call(iterator); done = result.done; value = done ? (unused) : result.value.
+    generic.link(&jit);
+    constexpr GPRReg sp = CCallHelpers::stackPointerRegister;
+    constexpr int32_t keptNext = 0;
+    constexpr int32_t keptSlots = 8;
+    constexpr int32_t keptResult = 16;
+    constexpr int32_t keptDone = 24;
+    CCallHelpers::JumpList notObject;
+    CCallHelpers::JumpList exception;
+    jit.emitFunctionPrologue();
+    jit.subPtr(TrustedImm32(32), sp);
+    jit.store64(A0, Address(sp, keptNext));
+    jit.storePtr(A3, Address(sp, keptSlots));
+    jit.move(A1, thisGPR);
+    jit.move(A0, calleeGPR);
+    callForObjectInFrameOfStub(jit, notObject);
+    jit.store64(A0, Address(sp, keptResult));
+    jit.loadPtr(Address(sp, keptSlots), A1);
+    getWellKnownInFrameOfStub(jit, WellKnownIdentifier::Done, exception);
+    jit.store64(A0, Address(sp, keptDone));
+    callStubFromStub(jit, Stub::ToBoolean);
+    Jump isDone = jit.branchTest32(CCallHelpers::NonZero, A0);
+    jit.load64(Address(sp, keptResult), A0);
+    jit.loadPtr(Address(sp, keptSlots), A1);
+    jit.addPtr(TrustedImm32(sizeof(Slot)), A1);
+    getWellKnownInFrameOfStub(jit, WellKnownIdentifier::Value, exception);
+    jit.move(A0, A1);
+    Jump hasValue = jit.jump();
+    isDone.link(&jit);
+    jit.move(CCallHelpers::TrustedImm64(JSValue::ValueUndefined), A1);
+    hasValue.link(&jit);
+    jit.load64(Address(sp, keptDone), A0);
+    jit.load64(Address(sp, keptNext), A2);
+    jit.emitFunctionEpilogue();
+    jit.ret();
+
+    throwFromFrameOfStub(jit, notObject, exception);
+}
+
+// A0 = iterable, A1 = its @@iterator, A2 = a slot, for `next`. Returns A0 = iterator, A1 = next. iterator =
+// symbolIterator.call(iterable); next = iterator.next. If the runtime has a fast path for the iterable, `next` is a marker instead.
+static void generateIteratorOpen(CCallHelpers& jit)
+{
+    constexpr GPRReg sp = CCallHelpers::stackPointerRegister;
+    // An array with the realm's original Structure is iterated by index, with no iterator object (IterationMode::FastArray).
+    if (Options::useImmutableIntrinsics() && Options::useUnboxedFastArrayIteration()) {
+        constexpr GPRReg instance = A3;
+        constexpr GPRReg t = A4;
+        Jump isNotCell = jit.branchIfNotCell(A0);
+        jit.load8(Address(A0, JSCell::indexingTypeAndMiscOffset()), T11);
+        jit.urshift32(TrustedImm32(Instance::shiftOfKindOfArray), T11);
+        jit.and32(TrustedImm32(Instance::numberOfKindsOfArray - 1), T11);
+        loadInstance(jit, instance);
+        jit.addPtr(TrustedImm32(Instance::offsetOfStructureIDsOfOriginalArrays()), instance, t);
+        jit.load32(CCallHelpers::BaseIndex(t, T11, CCallHelpers::TimesFour), T11);
+        jit.load32(Address(A0, JSCell::structureIDOffset()), t);
+        Jump isSomethingElse = jit.branch32(CCallHelpers::NotEqual, T11, t);
+        jit.loadPtr(Address(instance, Instance::offsetOfSentinelOfArrayIteration()), A0);
+        jit.move(CCallHelpers::TrustedImm64(JSValue::encode(jsNumber(0))), A1);
+        jit.ret();
+        isNotCell.link(&jit);
+        isSomethingElse.link(&jit);
+    }
+
+    constexpr int32_t keptNext = 0; // `next`, as returned by the operation.
+    constexpr int32_t keptSlot = 8;
+    constexpr int32_t keptIterable = 16; // Later reused for the iterator.
+    constexpr int32_t keptSymbolIterator = 24;
+    CCallHelpers::JumpList notObject;
+    CCallHelpers::JumpList exception;
+    jit.emitFunctionPrologue();
+    jit.subPtr(TrustedImm32(32), sp);
+    jit.storePtr(A2, Address(sp, keptSlot));
+    jit.store64(A0, Address(sp, keptIterable));
+    jit.store64(A1, Address(sp, keptSymbolIterator));
+    jit.move(A1, A2);
+    jit.move(A0, A1);
+    jit.addPtr(TrustedImm32(keptNext), sp, A3);
+    loadInstance(jit, T11);
+    jit.loadPtr(Address(T11, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(T11, Instance::offsetOfRuntimeTable()), T11);
+    jit.loadPtr(Address(T11, static_cast<unsigned>(Entry::operationAOTIteratorOpenTryFast) * sizeof(void*)), T11);
+    jit.call(T11, OperationPtrTag);
+    exception.append(jit.branchTestPtr(CCallHelpers::NonZero, GPRInfo::returnValueGPR2));
+    jit.move(GPRInfo::returnValueGPR, A0);
+    Jump isGeneric = jit.branchTest64(CCallHelpers::Zero, A0);
+    jit.load64(Address(sp, keptNext), A1);
+    jit.emitFunctionEpilogue();
+    jit.ret();
+
+    isGeneric.link(&jit);
+    jit.load64(Address(sp, keptIterable), thisGPR);
+    jit.load64(Address(sp, keptSymbolIterator), calleeGPR);
+    callForObjectInFrameOfStub(jit, notObject);
+    jit.store64(A0, Address(sp, keptIterable));
+    jit.loadPtr(Address(sp, keptSlot), A1);
+    getWellKnownInFrameOfStub(jit, WellKnownIdentifier::Next, exception);
+    jit.move(A0, A1);
+    jit.load64(Address(sp, keptIterable), A0);
+    jit.emitFunctionEpilogue();
+    jit.ret();
+
+    throwFromFrameOfStub(jit, notObject, exception);
+}
+
+// A0 = iterator, A1 = iterable, A2 = next, as in op_iterator_close_check. Returns A0 = the iterator to close.
+static void generateIteratorCloseCheck(CCallHelpers& jit)
+{
+    Jump isNotCell = jit.branchIfNotCell(A0);
+    Jump isNotMarked = jit.branchIfNotType(A0, SentinelType);
+    loadInstance(jit, T11);
+    jit.loadPtr(Address(T11, Instance::offsetOfGlobalObject()), T10);
+    jit.loadPtr(Address(T10, JSGlobalObject::offsetOfArrayIteratorProtocolWatchpointSet() + InlineWatchpointSet::offsetOfData()), T10);
+    Jump isInvalidated = jit.branchPtr(CCallHelpers::Equal, T10, CCallHelpers::TrustedImmPtr(InlineWatchpointSet::encodeState(IsInvalidated)));
+    Jump isThin = jit.branchTestPtr(CCallHelpers::NonZero, T10, TrustedImm32(InlineWatchpointSet::IsThinFlag));
+    jit.load8(Address(T10, WatchpointSet::offsetOfState()), T10);
+    Jump isInvalidatedToo = jit.branch32(CCallHelpers::Equal, T10, TrustedImm32(IsInvalidated));
+    isThin.link(&jit);
+    isNotCell.link(&jit);
+    isNotMarked.link(&jit);
+    jit.ret();
+
+    // Array iterators have been given a `return` method, so closing one is observable and a real iterator is required.
+    isInvalidated.link(&jit);
+    isInvalidatedToo.link(&jit);
+    jit.loadPtr(Address(T11, Instance::offsetOfGlobalObject()), A0);
+    jit.loadPtr(Address(T11, Instance::offsetOfRuntimeTable()), T11);
+    jit.loadPtr(Address(T11, static_cast<unsigned>(Entry::operationAOTMaterializeArrayIterator) * sizeof(void*)), T11);
+    callAndCheckException(jit, T11, Returns::Value);
+}
+
+// ---- Helpers
+//
+// A helper does the common case of an operation, or gives up by returning null, after which whoever called it calls the
+// operation (Lowering::callHelper()'s callers, generateAheadOf()). It is a B3 procedure (generateHelper()), which returns in rax
+// as C does; a stub's result is in A0. So the stub calls the procedure, which follows it, and moves the result. (The extra word
+// keeps the stack where the C convention has it at a call.)
+static void generateHelperOfX86(CCallHelpers& jit, Stub stub)
+{
+    jit.subPtr(TrustedImm32(sizeof(void*)), CCallHelpers::stackPointerRegister);
+    CCallHelpers::Call call = jit.nearCall();
+    jit.addPtr(TrustedImm32(sizeof(void*)), CCallHelpers::stackPointerRegister);
+    jit.move(GPRInfo::returnValueGPR, stubResultGPR);
+    jit.ret();
+    jit.m_assembler.linkJump(call.m_label, jit.m_assembler.label());
+    generateHelper(jit, stub);
+}
+
+#define AOT_GENERATE_HELPER(name) static void generate##name(CCallHelpers& jit) { generateHelperOfX86(jit, Stub::name); }
+FOR_EACH_AOT_HELPER(AOT_GENERATE_HELPER)
+#undef AOT_GENERATE_HELPER
+
+// In the runtime table where the operation would be (installOperationFrontEnds()): called as the operation is, with the C convention,
+// by a stub that calls C++. Tries the helper first, with the arguments rearranged by setUpAndCall(). If the helper gives up, calls
+// the operation with its original arguments: the stack is then as it was on entry, so a seventh and eighth argument are still above
+// the return address, where the operation looks for them. Success returns as the operation does, rax = the result, rdx = 0 (no
+// exception). rbx and r12 are saved here too: the caller expects what C preserves, but AOT code (the helper included) may clobber
+// them (stubClobberedRegisters()).
+template<typename SetUp>
+static void generateAheadOf(CCallHelpers& jit, Entry operation, const SetUp& setUpAndCall)
+{
+    constexpr GPRReg sp = CCallHelpers::stackPointerRegister;
+    constexpr unsigned room = 8 * sizeof(void*); // The six argument registers, rbx and r12.
+    // Entered with rsp = 8 mod 16: after the prologue it is aligned, and stays so for the call to the helper's stub.
+    static_assert(!(room % stackAlignmentBytes()));
+    jit.emitFunctionPrologue();
+    jit.subPtr(TrustedImm32(room), sp);
+    for (unsigned i = 0; i < 6; ++i)
+        jit.store64(GPRInfo::toArgumentRegister(i), Address(sp, i * sizeof(void*)));
+    jit.store64(X86Registers::ebx, Address(sp, 6 * sizeof(void*)));
+    jit.store64(X86Registers::r12, Address(sp, 7 * sizeof(void*)));
+    setUpAndCall();
+    jit.load64(Address(sp, 6 * sizeof(void*)), X86Registers::ebx);
+    jit.load64(Address(sp, 7 * sizeof(void*)), X86Registers::r12);
+    // A helper's stub hands its result back in A0, as stubs do.
+    jit.move(stubResultGPR, GPRInfo::returnValueGPR);
+    Jump gaveUp = jit.branchTestPtr(CCallHelpers::Zero, GPRInfo::returnValueGPR);
+    jit.move(TrustedImm32(0), GPRInfo::returnValueGPR2); // No exception.
+    jit.emitFunctionEpilogue();
+    jit.ret();
+    gaveUp.link(&jit);
+    for (unsigned i = 0; i < 6; ++i)
+        jit.load64(Address(sp, i * sizeof(void*)), GPRInfo::toArgumentRegister(i));
+    jit.emitFunctionEpilogue();
+    jit.move(instanceGPR, T9);
+    jumpToEntry(jit, T9, operation);
+}
+
+// The helper takes the operation's arguments without the leading global object.
+static void generateAheadOf(CCallHelpers& jit, Entry operation, Stub helper, unsigned argumentsOfHelper)
+{
+    generateAheadOf(jit, operation, [&] {
+        for (unsigned i = 0; i < argumentsOfHelper; ++i)
+            jit.move(GPRInfo::toArgumentRegister(i + 1), GPRInfo::toArgumentRegister(i));
+        callStubFromStub(jit, helper);
+    });
+}
+
+// (globalObject, values, count, indexingType)
+static void generateAheadOfNewArray(CCallHelpers& jit)
+{
+    generateAheadOf(jit, Entry::BehindNewArray, [&] {
+        jit.move(A1, A0);
+        jit.move(A2, A1);
+        Jump areInt32 = jit.branch32(CCallHelpers::Equal, A3, TrustedImm32(ArrayWithInt32));
+        callStubFromStub(jit, Stub::HelperNewArray);
+        Jump done = jit.jump();
+        areInt32.link(&jit);
+        callStubFromStub(jit, Stub::HelperNewArrayOfInt32);
+        done.link(&jit);
+    });
+}
+
+// (globalObject, count, arguments, skipped)
+static void generateAheadOfCreateRest(CCallHelpers& jit)
+{
+    generateAheadOf(jit, Entry::BehindCreateRest, [&] {
+        jit.zeroExtend32ToWord(A3, A3);
+        jit.getEffectiveAddress(CCallHelpers::BaseIndex(A2, A3, CCallHelpers::TimesEight), A0);
+        Jump some = jit.branch32(CCallHelpers::Above, A1, A3);
+        jit.move(A3, A1);
+        some.link(&jit);
+        jit.sub32(A3, A1);
+        callStubFromStub(jit, Stub::HelperNewArray);
+    });
+}
+
+static void generateAheadOfNewArrayBuffer(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindNewArrayBuffer, Stub::HelperNewArrayBuffer, 1); }
+static void generateAheadOfNewArrayWithSpread(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindNewArrayWithSpread, Stub::HelperNewArrayWithSpread, 3); }
+static void generateAheadOfNewArrayWithSpecies(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindNewArrayWithSpecies, Stub::HelperNewArrayWithSpecies, 2); }
+static void generateAheadOfCreateLexicalEnvironment(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindCreateLexicalEnvironment, Stub::HelperNewActivation, 4); }
+static void generateAheadOfMakeRope2(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindMakeRope2, Stub::HelperMakeRope2, 2); }
+static void generateAheadOfMakeRope3(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindMakeRope3, Stub::HelperMakeRope3, 3); }
+static void generateAheadOfStringSliceWithEnd(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindStringSliceWithEnd, Stub::HelperStringSlice, 3); }
+static void generateAheadOfStringSubstringWithEnd(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindStringSubstringWithEnd, Stub::HelperStringSubstring, 3); }
+static void generateAheadOfToLowerCase(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindToLowerCase, Stub::HelperToLowerCase, 1); }
+static void generateAheadOfValueAdd(CCallHelpers& jit) { generateAheadOf(jit, Entry::BehindValueAdd, Stub::HelperAddStrings, 2); }
