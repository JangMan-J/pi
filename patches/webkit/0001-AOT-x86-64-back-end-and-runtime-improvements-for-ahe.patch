+void RegExp::updateFirstCodeUnits(Yarr::YarrPattern& pattern)
+{
+    m_numberOfFirstCodeUnitRanges = 0;
+    // A sticky match starts at lastIndex or nowhere.
+    if (sticky())
+        return;
+    auto ranges = Yarr::computeFirstCodeUnitRanges(pattern);
+    if (!ranges || ranges->isEmpty() || ranges->size() > m_firstCodeUnitsBegin.size())
+        return;
+    for (auto& range : *ranges) {
+        // Text is mostly ASCII: a filter that lets it through would only cost time.
+        if (range.begin < 0x80 || range.end > 0xffff)
+            return;
+    }
+    for (unsigned i = 0; i < ranges->size(); ++i) {
+        m_firstCodeUnitsBegin[i] = static_cast<char16_t>(ranges->at(i).begin);
+        m_firstCodeUnitsEnd[i] = static_cast<char16_t>(ranges->at(i).end);
+    }
+    m_numberOfFirstCodeUnitRanges = ranges->size();
+}
