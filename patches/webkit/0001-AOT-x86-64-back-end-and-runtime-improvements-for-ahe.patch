+
+// ---- Equality, of two values that are not both int32s, and that do not have the same bits unless they are numbers. As on ARM64.
+
+// (globalObject, left, right). Free: rax, rcx, r8, r9 (r10 is tailCall()'s), xmm0, xmm1. rdx is both `right` and where "no
+// exception" goes, so it is only written on the way out.
+static void generateCompareEq(CCallHelpers& jit, bool strict)
+{
+    constexpr GPRReg left = argument1;
+    constexpr GPRReg right = argument2;
+    constexpr GPRReg scratch0 = result;
+    constexpr GPRReg scratch1 = argument3;
+    constexpr GPRReg scratch2 = argument4;
+    constexpr GPRReg scratch3 = argument5;
