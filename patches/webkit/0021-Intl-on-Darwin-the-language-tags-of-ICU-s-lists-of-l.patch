From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 15:16:33 +0530
Subject: [PATCH] Intl on Darwin: the language tags of ICU's lists of locales
 are made without ICU when they are plain

---
 Source/JavaScriptCore/runtime/IntlObject.cpp | 58 +++++++++++++++++++-
 1 file changed, 55 insertions(+), 3 deletions(-)

diff --git a/Source/JavaScriptCore/runtime/IntlObject.cpp b/Source/JavaScriptCore/runtime/IntlObject.cpp
index 40a58704e5..07c71d9963 100644
--- a/Source/JavaScriptCore/runtime/IntlObject.cpp
+++ b/Source/JavaScriptCore/runtime/IntlObject.cpp
@@ -63,6 +63,9 @@
 #include "IntlSegmenterPrototype.h"
 #include "JSCInlines.h"
 #include "Options.h"
+#include <algorithm>
+#include <array>
+#include <string_view>
 #include <unicode/ubrk.h>
 #include <unicode/ucal.h>
 #include <unicode/ucol.h>
@@ -413,6 +416,55 @@ String languageTagForLocaleID(const char* localeID, bool isImmortal)
     return createResult(canonicalizeUnicodeExtensionsAfterICULocaleCanonicalization(WTF::move(buffer)));
 }
 
+#if OS(DARWIN)
+// A locale ID of ICU's own lists of what it has (uloc_getAvailable() and the like) that is no more than a language, a script and a
+// region, each as ICU writes it (`en`, `zh_Hant_TW`, `es_419`): its language tag is the ID with '-' for '_'. Making each with
+// uloc_toLanguageTag() is most of what the first Intl object of a process costs (a thousand IDs, about a millisecond).
+// Anything else, and the few languages ICU writes another way in a tag, is left to ICU.
+static String languageTagForAvailableLocaleID(const char* localeID, bool isImmortal)
+{
+    auto isLower = [](char c) { return c >= 'a' && c <= 'z'; };
+    auto isUpper = [](char c) { return c >= 'A' && c <= 'Z'; };
+    auto isDigit = [](char c) { return c >= '0' && c <= '9'; };
+    std::span<const char> id { localeID, strlen(localeID) };
+    size_t start = 0;
+    unsigned part = 0; // 0: language, 1: script, 2: region
+    bool simple = !id.empty();
+    for (size_t i = 0; simple && i <= id.size(); ++i) {
+        if (i < id.size() && id[i] != '_')
+            continue;
+        auto subtag = id.subspan(start, i - start);
+        if (!part) {
+            simple = (subtag.size() == 2 || subtag.size() == 3) && std::ranges::all_of(subtag, isLower);
+            static constexpr std::array<std::string_view, 8> legacy { "iw", "in", "ji", "jw", "mo", "tl", "sh", "no" };
+            simple = simple && std::ranges::find(legacy, std::string_view(subtag.data(), subtag.size())) == legacy.end();
+            part = 1;
+        } else if (part == 1 && subtag.size() == 4 && isUpper(subtag[0]) && std::ranges::all_of(subtag.subspan(1), isLower))
+            part = 2;
+        else if (part <= 2 && ((subtag.size() == 2 && std::ranges::all_of(subtag, isUpper)) || (subtag.size() == 3 && std::ranges::all_of(subtag, isDigit))))
+            part = 3;
+        else
+            simple = false;
+        start = i + 1;
+    }
+    if (!simple)
+        return languageTagForLocaleID(localeID, isImmortal);
+    Vector<char, 32> buffer(id);
+    for (auto& c : buffer) {
+        if (c == '_')
+            c = '-';
+    }
+    if (isImmortal)
+        return StringImpl::createStaticStringImpl(buffer.span());
+    return buffer.span();
+}
+#else
+static String languageTagForAvailableLocaleID(const char* localeID, bool isImmortal)
+{
+    return languageTagForLocaleID(localeID, isImmortal);
+}
+#endif
+
 // Ensure we have xx-ZZ whenever we have xx-Yyyy-ZZ.
 static void addScriptlessLocaleIfNeeded(LocaleSet& availableLocales, StringView locale)
 {
@@ -449,7 +501,7 @@ const LocaleSet& intlAvailableLocales()
         constexpr bool isImmortal = true;
         int32_t count = uloc_countAvailable();
         for (int32_t i = 0; i < count; ++i) {
-            String locale = languageTagForLocaleID(uloc_getAvailable(i), isImmortal);
+            String locale = languageTagForAvailableLocaleID(uloc_getAvailable(i), isImmortal);
             if (locale.isEmpty())
                 continue;
             availableLocales->add(locale);
@@ -587,7 +639,7 @@ const LocaleSet& intlCollatorAvailableLocales()
         constexpr bool isImmortal = true;
         int32_t count = ucol_countAvailable();
         for (int32_t i = 0; i < count; ++i) {
-            String locale = languageTagForLocaleID(ucol_getAvailable(i), isImmortal);
+            String locale = languageTagForAvailableLocaleID(ucol_getAvailable(i), isImmortal);
             if (locale.isEmpty())
                 continue;
             availableLocales->add(locale);
@@ -608,7 +660,7 @@ const LocaleSet& intlSegmenterAvailableLocales()
         constexpr bool isImmortal = true;
         int32_t count = ubrk_countAvailable();
         for (int32_t i = 0; i < count; ++i) {
-            String locale = languageTagForLocaleID(ubrk_getAvailable(i), isImmortal);
+            String locale = languageTagForAvailableLocaleID(ubrk_getAvailable(i), isImmortal);
             if (locale.isEmpty())
                 continue;
             availableLocales->add(locale);
