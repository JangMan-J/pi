From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 00:49:21 +0530
Subject: [PATCH] AOT: ARM64: the known callee number loaded with 32-bit movz
 and movk

KnownCalleeNumberReferences::load() (inlining of methods by name) called
ARM64Assembler::movz() and movk() without their data size, which they take as a
template argument: ARM64 did not compile. The number is an int32, and fill()
patches the 16-bit immediates of the two instructions, which are where they are
whatever the size: 32-bit forms.
---
 Source/JavaScriptCore/aot/AOTStubs.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Source/JavaScriptCore/aot/AOTStubs.cpp b/Source/JavaScriptCore/aot/AOTStubs.cpp
index 0655d509cf..8614e49d88 100644
--- a/Source/JavaScriptCore/aot/AOTStubs.cpp
+++ b/Source/JavaScriptCore/aot/AOTStubs.cpp
@@ -4190,8 +4190,8 @@ void KnownCalleeNumberReferences::load(CCallHelpers& jit, GPRReg dest, uint32_t
 {
 #if CPU(ARM64)
     // movz dest, #low; movk dest, #high, lsl #16: both 16-bit immediates are patched.
-    jit.m_assembler.movz(dest, 0, 0);
-    jit.m_assembler.movk(dest, 0, 16);
+    jit.m_assembler.movz<32>(dest, 0, 0);
+    jit.m_assembler.movk<32>(dest, 0, 16);
     m_references.append({ jit.label(), knownCallee });
 #elif CPU(X86_64)
     // mov dest, imm32, the immediate being the instruction's last four bytes. The label is after it.
