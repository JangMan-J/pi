+            guard->bytecodeIndex = call->bytecodeIndex;
+            guard->block = block;
+            // (Under the call's own register for the callee: Graph::knownCallee() finds it there, as it does for the call.)
+            guard->uses.append({ calleeRegister, calleeNode });
+            block->nodes.append(guard);
+        }
