From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 01:19:28 +0530
Subject: [PATCH] AOT: on Darwin, a 64-bit number in the code is an address
 only if something is mapped there

isMappedInThisProcess() read /proc/self/maps on Linux and said yes everywhere
else, so on macOS every 64-bit constant between 4 GB and 2^47 that B3 folds
from numbers (3000000000 + 2147483648) was taken for an address put in the code
by mistake, and the function declined. It now asks mach_vm_region() for the
region at the address.
---
 Source/JavaScriptCore/aot/AOTCompiler.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/Source/JavaScriptCore/aot/AOTCompiler.cpp b/Source/JavaScriptCore/aot/AOTCompiler.cpp
index f62eb5f42c..2c9b4ffe6d 100644
--- a/Source/JavaScriptCore/aot/AOTCompiler.cpp
+++ b/Source/JavaScriptCore/aot/AOTCompiler.cpp
@@ -32,6 +32,11 @@
 #include <wtf/StringPrintStream.h>
 #include <wtf/text/StringHash.h>
 
+#if OS(DARWIN)
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#endif
+
 namespace JSC { namespace AOT {
 
 // Whether `address` is in memory this process has mapped. An address that a lowering put in the code by mistake is of something that
@@ -52,6 +57,18 @@ static bool isMappedInThisProcess(uint64_t address)
     }
     fclose(maps);
     return found;
+#elif OS(DARWIN)
+    // The region at `address` or the first one after it.
+    mach_vm_address_t start = address;
+    mach_vm_size_t size = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object = MACH_PORT_NULL;
+    if (mach_vm_region(mach_task_self(), &start, &size, VM_REGION_BASIC_INFO_64, reinterpret_cast<vm_region_info_t>(&info), &count, &object) != KERN_SUCCESS)
+        return false; // Nothing there or after it.
+    if (object != MACH_PORT_NULL)
+        mach_port_deallocate(mach_task_self(), object);
+    return address >= start && address - start < size;
 #else
     UNUSED_PARAM(address);
     return true;
