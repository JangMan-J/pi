From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenSec <contactus@opensec.in>
Date: Sun, 4 Oct 2026 04:03:20 +0530
Subject: [PATCH] AOT: the map of an image names its stubs and regular
 expressions too

BUN_AOT_MAP_OUT also writes "S offset size name" for each copy of each stub and thunk, and for the 8-bit and 16-bit code of each regular expression, which a profile otherwise shows as code of no function.
---
 Source/JavaScriptCore/aot/AOTImage.cpp | 34 ++++++++++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/Source/JavaScriptCore/aot/AOTImage.cpp b/Source/JavaScriptCore/aot/AOTImage.cpp
index 9420473960..09758eef35 100644
--- a/Source/JavaScriptCore/aot/AOTImage.cpp
+++ b/Source/JavaScriptCore/aot/AOTImage.cpp
@@ -1320,11 +1320,41 @@ Vector<uint8_t> ImageBuilder::finish()
     Vector<uint32_t> functionInBucket;
     functionInBucket.fill(0, capacity);
     size_t recordAt = 0;
-    // BUN_AOT_MAP_OUT=path: where each function's code is, for profilers: "offset size module start kind" per line, the offset
-    // from the start of the image (which is mapped at StaticRegion::startOf(Arena::Image)), the function by its key.
+    // BUN_AOT_MAP_OUT=path: where the code is, for profilers, as offsets from the start of the image (which is mapped at
+    // StaticRegion::startOf(Arena::Image)). A function: "offset size module start kind", by its key. A stub or a regular
+    // expression: "S offset size name".
     FILE* map = nullptr;
     if (const char* mapPath = getenv("BUN_AOT_MAP_OUT"))
         map = fopen(mapPath, "w");
+    if (map) {
+        static constexpr const char* namesOfStubs[] = {
+#define AOT_NAME_OF_STUB(name) #name,
+            FOR_EACH_AOT_STUB(AOT_NAME_OF_STUB)
+#undef AOT_NAME_OF_STUB
+        };
+        Vector<std::pair<unsigned, String>> starts;
+        for (unsigned i = 0; i < numberOfStubs; ++i)
+            starts.append({ stubs.offsets[i], String::fromLatin1(namesOfStubs[i]) });
+        for (unsigned i = 0; i < stubs.thunkOffsets.size(); ++i)
+            starts.append({ stubs.thunkOffsets[i], makeString("thunk"_s, i) });
+        std::ranges::sort(starts, { }, &std::pair<unsigned, String>::first);
+        for (size_t at : stubsAt) {
+            for (size_t i = 0; i < starts.size(); ++i) {
+                size_t end = i + 1 < starts.size() ? starts[i + 1].first : stubs.bytes.size();
+                fprintf(map, "S %zx %zx stub:%s\n", static_cast<size_t>(header.codeOffset) + at + starts[i].first, end - starts[i].first, starts[i].second.utf8().data());
+            }
+        }
+        for (size_t index = 0; index < m_regExps.size(); ++index) {
+            for (unsigned i = 0; i < 2; ++i) {
+                auto pattern = m_regExps[index].pattern.left(60).utf8();
+                for (char& c : pattern.mutableSpan()) {
+                    if (c == '\n' || c == '\r' || c == '\t')
+                        c = ' ';
+                }
+                fprintf(map, "S %zx %zx regexp%s:/%s/\n", static_cast<size_t>(header.codeOffset) + placementOfRegExps[index][i], m_regExps[index].code[i].bytes.size(), i ? "16" : "8", pattern.data());
+            }
+        }
+    }
     for (size_t index = 0; index < m_functions.size(); ++index) {
         auto& function = m_functions[index];
         auto& info = function.code.info;
