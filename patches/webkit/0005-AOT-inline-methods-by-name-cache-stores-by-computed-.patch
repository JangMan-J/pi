+    static constexpr uint32_t ambiguous = std::numeric_limits<uint32_t>::max();
+    struct Entry {
+        uint32_t function { 0 };
+        bool others { false };
+    };
+    Lock m_lock;
+    UncheckedKeyHashMap<UniquedStringImpl*, Entry> m_byName;
+    mutable Lock m_standardLock;
