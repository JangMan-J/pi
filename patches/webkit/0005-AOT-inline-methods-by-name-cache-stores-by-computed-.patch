+void KnownCalleeNumberReferences::load(CCallHelpers& jit, GPRReg dest, uint32_t knownCallee)
+{
+#if CPU(ARM64)
+    // movz dest, #low; movk dest, #high, lsl #16: both 16-bit immediates are patched.
+    jit.m_assembler.movz(dest, 0, 0);
+    jit.m_assembler.movk(dest, 0, 16);
+    m_references.append({ jit.label(), knownCallee });
+#elif CPU(X86_64)
+    // mov dest, imm32, the immediate being the instruction's last four bytes. The label is after it.
+    jit.padBeforePatch();
+    jit.m_assembler.movl_i32r(0, dest);
+    m_references.append({ jit.label(), knownCallee });
+#else
+    UNUSED_PARAM(dest);
+    UNUSED_PARAM(knownCallee);
+    RELEASE_ASSERT_NOT_REACHED();
+#endif
+}
+
+Vector<KnownCalleeNumberReference> KnownCalleeNumberReferences::link(LinkBuffer& linkBuffer)
+{
+    auto* start = static_cast<uint8_t*>(linkBuffer.entrypoint<JSEntryPtrTag>().untaggedPtr());
+    Vector<KnownCalleeNumberReference> result;
+    for (auto& reference : m_references)
+        result.append({ static_cast<uint32_t>(static_cast<uint8_t*>(linkBuffer.locationOf<JSEntryPtrTag>(reference.after).untaggedPtr()) - start), reference.knownCallee });
+    return result;
+}
+
+void KnownCalleeNumberReferences::fill(uint8_t* code, const KnownCalleeNumberReference& reference, uint32_t index)
+{
+#if CPU(ARM64)
+    auto* instructions = reinterpret_cast<uint32_t*>(code + reference.offset) - 2;
+    constexpr uint32_t immediate = 0xffffu << 5;
+    RELEASE_ASSERT(!(instructions[0] & immediate) && !(instructions[1] & immediate));
+    instructions[0] |= (index & 0xffff) << 5;
+    instructions[1] |= (index >> 16) << 5;
+#elif CPU(X86_64)
+    memcpy(code + reference.offset - sizeof(uint32_t), &index, sizeof(index));
+#else
+    UNUSED_PARAM(code);
+    UNUSED_PARAM(reference);
+    UNUSED_PARAM(index);
+    RELEASE_ASSERT_NOT_REACHED();
+#endif
+}
