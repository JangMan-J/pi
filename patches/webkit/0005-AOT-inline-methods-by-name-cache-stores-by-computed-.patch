+void MethodsOfProgram::recordMethod(UniquedStringImpl* name, uint32_t function)
+{
+    Locker locker { m_lock };
+    Entry& entry = m_byName.add(name, Entry { }).iterator->value;
+    if (!entry.function)
+        entry.function = function;
+    else if (entry.function != function) {
+        if (Options::verboseAOTCompilation() && entry.function != ambiguous) [[unlikely]] {
+            auto describe = [](uint32_t number) {
+                const KnownFunction* known = functionsOfProgram() ? functionsOfProgram()->function(number) : nullptr;
+                return known ? makeString("#"_s, number, " @"_s, known->key.module, ":"_s, known->key.start) : makeString("#"_s, number);
+            };
+            dataLogLn("AOT: `", String(name), "` is stored as a method by more than one function (", describe(entry.function), " and ", describe(function), ")");
+        }
+        entry.function = ambiguous;
+    }
+}
+
+// The names of the properties of the standard objects and their prototypes (ImmutableIntrinsics), and of the iterator and
+// promise protocols, which the intrinsics do not all reach.
+bool MethodsOfProgram::isNameOfStandardMethod(UniquedStringImpl* name) const
+{
+    Locker locker { m_standardLock };
+    if (!m_standardNames) {
+        m_standardNames.emplace();
+        if (const ImmutableIntrinsics* intrinsics = ImmutableIntrinsics::shared()) {
+            for (unsigned i = 1; i < intrinsics->count(); ++i)
+                m_standardNames->add(intrinsics->at(i).name);
+        }
+        for (ASCIILiteral extra : { "next"_s, "return"_s, "throw"_s, "then"_s, "catch"_s, "finally"_s, "toString"_s, "valueOf"_s, "toJSON"_s, "constructor"_s, "call"_s, "apply"_s, "bind"_s, "hasOwnProperty"_s, "toLocaleString"_s })
+            m_standardNames->add(String(extra));
+    }
+    return m_standardNames->contains(String(name));
+}
+
+void MethodsOfProgram::recordOtherStore(UniquedStringImpl* name)
+{
+    Locker locker { m_lock };
+    m_byName.add(name, Entry { }).iterator->value.others = true;
+}
