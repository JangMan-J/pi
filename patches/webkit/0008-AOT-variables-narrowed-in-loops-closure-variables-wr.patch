+// What a read of a closure or module variable is taken for in the fast copy of a loop (Node::typeOfVariableRead): what code writes to
+// the variable, when that has fast paths (numbers, strings, booleans, arrays, typed arrays) and the read may otherwise also see the
+// undefined or the hole the variable starts as. TNone if the read is better taken as it is.
+inline Type typeOfVariableReadInFastCopy(Type read, Type written)
+{
+    constexpr Type initial = TUndefined | TEmpty;
+    if (!Options::useAOTVariableNarrowing() || !written || (written & initial) || !(read & initial) || !isSubtype(written, read))
+        return TNone;
+    return isSubtype(written, TNumber | TString | TBoolean | TArray | TTypedArray) ? written : TNone;
+}
