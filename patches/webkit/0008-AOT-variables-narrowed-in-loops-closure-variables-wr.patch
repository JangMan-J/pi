+    bool readsNarrowably = false;
+    // (A call made part of the loop was a call when the guards were chosen, which leaves the loop whole anyway: no fast copy to
+    // narrow anything in.)
+    bool hasInlinedCode = false;
     for (BasicBlock* block : graph.m_rpo) {
         if (!block->isInLoop)
             continue;
@@ -204,6 +223,7 @@ static bool loopsWillDoWhole(Graph& graph)
         for (Node* node : block->nodes) {
             if (node->kind != NodeKind::Bytecode || !node->instruction)
                 continue;
+            hasInlinedCode |= node->graph != &graph;
             switch (node->opcode) {
             case op_get_by_val:
                 if (!node->use(node->as<OpGetByVal>().m_base)->type || !isSubtype(node->use(node->as<OpGetByVal>().m_base)->type, TArray) || !isSubtype(node->use(node->as<OpGetByVal>().m_property)->type, TNumber))
@@ -231,12 +251,17 @@ static bool loopsWillDoWhole(Graph& graph)
             case op_get_from_scope:
                 if (node->as<OpGetFromScope>().m_getPutInfo.resolveType() != ResolvedClosureVar)
                     return false;
+                // In the fast copy it is taken for what is written to it (Node::typeOfVariableRead): worth a copy where that has
+                // fast paths, as `i < N` with a module constant N has.
+                readsNarrowably |= variableReadNarrowsUsefully(graph, node);
                 break;
             default:
                 break;
             }
         }
     }
+    if (readsNarrowably && !hasInlinedCode)
+        return false;
     return hasLoop;
 }
 
