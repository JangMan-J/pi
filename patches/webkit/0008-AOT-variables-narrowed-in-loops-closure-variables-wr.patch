+    // In the fast copy of a loop: `base.name(...)`, where the program gives the name to a few functions (methodCandidatesInLoop()).
+    // The guard before the call, which would leave for the generic copy, becomes a check for each function in turn, each leading to
+    // a call of its own that is known to be to that function, and so is made part of the loop like any (tryInline()); the last check
+    // leaves for the generic copy. What the calls return meets after them.
+    //     P: guard            P: is it f1? -> B1: call (f1) -> C: result = phi(...); the rest
+    //     B: call; the rest      else P2: is it f2? -> B2: call (f2) -> C
+    //                               ...  else Pk: is it fk? -> Bk -> C, else the generic copy
+    void splitMethodCalls()
+    {
+        if (m_graph.loopsAreNotSplit)
+            return;
+        unsigned count = m_graph.blocks.size();
+        for (unsigned i = 0; i < count; ++i) {
+            BasicBlock* guarding = m_graph.blocks[i].get();
+            Node* wayOut = guarding->endsWithGuard ? guarding->terminal() : nullptr;
+            if (!wayOut || wayOut->kind != NodeKind::Guard || wayOut->guardKind != GuardKind::Whole || wayOut->opcode != op_call || guarding->successors.size() != 2)
+                continue;
+            BasicBlock* block = guarding->successors[0];
+            Node* call = block->nodes.isEmpty() ? nullptr : block->nodes[0];
+            if (!call || call->guard != wayOut || call->opcode != op_call || block->isGeneric || m_graph.intrinsicOfCall(call) != CallIntrinsic::None)
+                continue;
+            auto bytecode = call->as<OpCall>();
+            Node* calleeNode = resolve(call->use(bytecode.m_callee));
+            if (!calleeNode->isBytecode(op_get_by_id))
+                continue;
+            int firstArgument = -static_cast<int>(bytecode.m_argv) + CallFrame::thisArgumentOffset();
+            if (resolve(call->use(VirtualRegister(firstArgument))) != resolve(calleeNode->use(calleeNode->as<OpGetById>().m_base)))
+                continue;
+            UniquedStringImpl* name = calleeNode->graph->codeBlock()->identifier(calleeNode->as<OpGetById>().m_property).impl();
+            auto candidates = methodCandidatesInLoop(name);
+            if (candidates.size() < 2)
+                continue;
+            dataLogLnIf(Options::verboseAOTCompilation(), "AOT-INLINE: method `", String(name), "` is checked for ", candidates.size(), " functions");
+            m_didInline = true;
+            // The read of the method sees objects of as many kinds as there are functions: in the fast copy it would leave for the
+            // generic copy whenever the kind is not the one its inline cache holds. Done the long way (whose cache holds several), it
+            // stays.
+            if (Node* readsMethod = calleeNode->guard; readsMethod && readsMethod->guardKind == GuardKind::Whole) {
+                readsMethod->guardKind = GuardKind::Nothing;
+                readsMethod->uses.clear();
+                readsMethod->guarded = nullptr;
+                calleeNode->guard = nullptr;
+            }
+            BasicBlock* generic = guarding->successors[1];
+            unsigned end = call->bytecodeIndex.offset() + call->instruction->size();
+
+            // What comes after the call.
+            BasicBlock* continuation = m_graph.addBlock();
+            continuation->graph = block->graph;
+            continuation->bytecodeBegin = end;
+            continuation->bytecodeEnd = block->bytecodeEnd;
+            continuation->isReachable = true;
+            continuation->isInLoop = block->isInLoop;
+            continuation->isOnlyInLoopOfBuiltin = block->isOnlyInLoopOfBuiltin;
+            continuation->endsWithGuard = std::exchange(block->endsWithGuard, false);
+            continuation->valuesAtTail = block->valuesAtTail;
+            for (unsigned j = 1; j < block->nodes.size(); ++j) {
+                block->nodes[j]->block = continuation;
+                continuation->nodes.append(block->nodes[j]);
+            }
+            continuation->successors = std::exchange(block->successors, { });
+            for (BasicBlock* successor : continuation->successors) {
+                for (auto& predecessor : successor->predecessors) {
+                    if (predecessor == block)
+                        predecessor = continuation;
+                }
+            }
+            block->nodes.shrink(0);
+            block->bytecodeEnd = end;
+
+            Node* result = nullptr;
+            if (call->opcode == op_call) {
+                result = m_graph.addNode(NodeKind::Phi);
+                result->graph = continuation->graph;
+                result->block = continuation;
+                result->range = IntegerRange::unknown();
+                continuation->phis.append(result);
+            }
+            BasicBlock* check = guarding;
+            for (unsigned k = 0; k < candidates.size(); ++k) {
+                BasicBlock* calling = block;
+                if (k) {
+                    calling = m_graph.addBlock();
+                    calling->graph = block->graph;
+                    calling->bytecodeBegin = block->bytecodeBegin;
+                    calling->bytecodeEnd = end;
+                    calling->isReachable = true;
+                    calling->isInLoop = block->isInLoop;
+                    calling->isOnlyInLoopOfBuiltin = block->isOnlyInLoopOfBuiltin;
+                    calling->valuesAtTail = block->valuesAtTail;
+                }
+                unsigned index = m_graph.addNode(NodeKind::Bytecode)->index;
+                Node* copy = m_graph.lastNode();
+                *copy = *call;
+                copy->index = index;
+                copy->block = calling;
+                copy->guard = nullptr;
+                copy->guarded = nullptr;
+                copy->provenCallee = candidates[k];
+                calling->nodes.append(copy);
+                calling->successors.append(continuation);
+                continuation->predecessors.append(calling);
+                if (result)
+                    result->uses.append({ VirtualRegister(), copy });
+
+                // Each check's successors are [its call, what comes if it fails]; the second is filled in by the next check, or below.
+                Node* guard = wayOut;
+                if (k) {
+                    BasicBlock* next = m_graph.addBlock();
+                    next->graph = guarding->graph;
+                    next->bytecodeBegin = block->bytecodeBegin;
+                    next->bytecodeEnd = block->bytecodeBegin;
+                    next->isReachable = true;
+                    next->isInLoop = guarding->isInLoop;
+                    next->isOnlyInLoopOfBuiltin = guarding->isOnlyInLoopOfBuiltin;
+                    next->endsWithGuard = true;
+                    next->valuesAtTail = guarding->valuesAtTail;
+                    guard = m_graph.addNode(NodeKind::Guard);
+                    guard->graph = wayOut->graph;
+                    guard->opcode = wayOut->opcode;
+                    guard->instruction = wayOut->instruction;
+                    guard->bytecodeIndex = wayOut->bytecodeIndex;
+                    guard->block = next;
+                    next->nodes.append(guard);
+                    next->successors.append(calling);
+                    calling->predecessors.append(next);
+                    if (check == guarding)
+                        guarding->successors[1] = next;
+                    else
+                        check->successors.append(next);
+                    next->predecessors.append(check);
+                    check = next;
+                }
+                guard->guardKind = GuardKind::IsKnownFunction;
+                guard->knownCallee = m_graph.indexOfKnownCallee(m_program.about(candidates[k]->forCall)->key);
+                guard->uses.clear();
+                guard->uses.append({ bytecode.m_callee, calleeNode });
+                guard->guarded = nullptr;
+            }
+            // The last check leaves for the generic copy, from where the guard did (the same phi inputs: nothing is defined in between).
+            RELEASE_ASSERT(check != guarding && check->successors.size() == 1);
+            check->successors.append(generic);
+            for (auto& predecessor : generic->predecessors) {
+                if (predecessor == guarding)
+                    predecessor = check;
+            }
+            RELEASE_ASSERT(guarding->successors.size() == 2 && guarding->successors[0] == block);
+            call->replacement = result;
+        }
+    }
+
     // For `base.name(...)`: the one function the program stores under `name`, if there is exactly one (MethodsOfProgram).
     const KnownFunction* methodNamedAt(Node* call, Node* calleeNode, unsigned argv)
     {
@@ -659,6 +816,30 @@ bool mayBecomePartOfCallerInLoop(const KnownFunction& known)
     return known.forCall && Inliner::canBePartOfAnother(known.forCall) && Inliner::isProfitable(known.forCall, known.summary, true);
 }
 
+Vector<const KnownFunction*, 4> methodCandidatesInLoop(UniquedStringImpl* name)
+{
+    const MethodsOfProgram* methods = methodsOfProgram();
+    const FunctionsOfProgram* functions = functionsOfProgram();
+    unsigned most = Options::maximumAOTMethodCandidates();
+    if (!Options::useAOTMethodInliningByName() || !methods || !functions || most < 2)
+        return { };
+    auto numbers = methods->methodsNamed(name, most);
+    if (numbers.size() < 2)
+        return { };
+    Vector<const KnownFunction*, 4> result;
+    unsigned cost = 0;
+    for (uint32_t number : numbers) {
+        const KnownFunction* known = functions->function(number);
+        if (!known || !mayBecomePartOfCallerInLoop(*known))
+            return { };
+        cost += known->forCall->instructionsSize();
+        result.append(known);
+    }
+    if (cost > Options::maximumAOTMethodCandidatesBytecodeCost())
+        return { };
+    return result;
+}
