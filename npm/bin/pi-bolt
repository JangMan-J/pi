#!/bin/sh
# pi-bolt launcher (npm and bun packages). The first run installs the Pi-Bolt release that matches this package's version
# into ~/.pi-bolt/npm with the bundled installer (the same as install.sh: progress, checksum, checks). Every run then
# replaces this script with the native executable (exec), so the launcher costs no startup time.
set -eu

VERSION=0.3.0
HOME_DIR="${PIBOLT_HOME:-$HOME/.pi-bolt}"

VARIANT="${PIBOLT_VARIANT:-}"
if [ -z "$VARIANT" ]; then
	if grep -qw avx2 /proc/cpuinfo 2>/dev/null; then VARIANT=x64; else VARIANT=x64-baseline; fi
fi
DIR="$HOME_DIR/npm/$VERSION/pi-bolt-linux-$VARIANT"

if [ ! -x "$DIR/pi" ]; then
	here=$(dirname "$(readlink -f "$0")")
	# On stderr, so that what Pi-Bolt prints on stdout (pi-bolt -p ... > file) is all that is there.
	PIBOLT_LAUNCHER=1 PIBOLT_VERSION="bolt-v$VERSION" PIBOLT_VARIANT="$VARIANT" PIBOLT_INSTALL="$HOME_DIR/npm/$VERSION" \
		sh "$here/../install.sh" 1>&2
	printf '\n' >&2
fi
exec "$DIR/pi" "$@"
